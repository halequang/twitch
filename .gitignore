# Plaintext Steam credentials for the rental pool — never commit these.
# Unanchored on purpose: a copy saved to the repo root slipped past the old
# scripts/-prefixed patterns, one `git add -A` away from Steam passwords in the
# history, which is not something you can take back.
*accounts*.txt
*.credentials.txt

# Local credential stores — never commit.
.credentials

# Password-rotation logs: these contain plaintext OLD and NEW Steam passwords.
scripts/rental_rotate_results.txt
*.newpass.txt

