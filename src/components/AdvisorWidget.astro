---
/**
 * AdvisorWidget — floating AI shopping assistant.
 *
 * A bronze chat bubble that opens a panel where customers can ask which product
 * to buy. Posts the conversation to POST /api/advisor (Gemini, in the Worker)
 * and renders the Vietnamese reply. All client logic is inline + self-contained.
 */
---

<div id="advisor" class="advisor" data-open="false">
  <button id="advisor-toggle" class="advisor-toggle" type="button" aria-label="Tư vấn mua hàng">
    <span class="advisor-toggle-icon" aria-hidden="true">💬</span>
    <span class="advisor-toggle-text">Tư vấn</span>
  </button>

  <div id="advisor-panel" class="advisor-panel" role="dialog" aria-label="Trợ lý tư vấn FunGaming" hidden>
    <div class="advisor-header">
      <div class="advisor-header-titles">
        <div class="advisor-header-title">⚜ Trợ Lý Tư Vấn</div>
        <div class="advisor-header-sub">Hỏi mình nên mua gì nhé!</div>
      </div>
      <button id="advisor-close" class="advisor-close" type="button" aria-label="Đóng">✕</button>
    </div>

    <div id="advisor-log" class="advisor-log" aria-live="polite"></div>

    <div id="advisor-chips" class="advisor-chips">
      <button type="button" class="advisor-chip" data-msg="Mình muốn nạp Point cho POE">💎 Nạp Point</button>
      <button type="button" class="advisor-chip" data-msg="Mình muốn mua account POE tạo sẵn">🎮 Mua acc POE</button>
      <button type="button" class="advisor-chip" data-msg="Mình muốn xem bộ skin Twitch Drops cho POE2">✦ Skin POE2</button>
      <button type="button" class="advisor-chip" data-msg="Mình muốn bộ skin Twitch Drops đầy đủ">⚔ Skin đầy đủ</button>
      <button type="button" class="advisor-chip" data-msg="Mình muốn mua CapCut Pro">🎬 CapCut Pro</button>
    </div>

    <form id="advisor-form" class="advisor-form" autocomplete="off">
      <input
        id="advisor-input"
        class="advisor-input"
        type="text"
        name="message"
        placeholder="VD: Mình mới chơi POE2, nên mua gì?"
        maxlength="2000"
        required
      />
      <button id="advisor-send" class="advisor-send" type="submit" aria-label="Gửi">↑</button>
    </form>
  </div>
</div>

<script is:inline>
  (function () {
    const root = document.getElementById('advisor');
    if (!root) return;

    const toggle = document.getElementById('advisor-toggle');
    const panel = document.getElementById('advisor-panel');
    const closeBtn = document.getElementById('advisor-close');
    const log = document.getElementById('advisor-log');
    const chips = document.getElementById('advisor-chips');
    const form = document.getElementById('advisor-form');
    const input = document.getElementById('advisor-input');
    const sendBtn = document.getElementById('advisor-send');

    // Conversation history sent to the API: [{ role: 'user'|'model', text }]
    const history = [];
    let busy = false;
    let greeted = false;

    const GREETING =
      'Chào bạn 👋 Mình là trợ lý của FunGaming VN. Bạn đang tìm nạp Point, ' +
      'mua account, hay bộ skin Twitch Drops? Cho mình biết nhu cầu nhé!';

    // ── Notification chime (synthesized, no audio file needed) ──────────────
    let audioCtx = null;
    function ensureAudio() {
      if (audioCtx) return audioCtx;
      try {
        const AC = window.AudioContext || window.webkitAudioContext;
        if (AC) audioCtx = new AC();
      } catch (_) {}
      return audioCtx;
    }
    function playChime() {
      const ctx = ensureAudio();
      if (!ctx) return;
      if (ctx.state === 'suspended') ctx.resume().catch(() => {});
      try {
        const t0 = ctx.currentTime;
        // Two soft sine notes — a gentle "ding-ding".
        [[880, 0], [1318.5, 0.12]].forEach(([freq, dt]) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.value = freq;
          gain.gain.setValueAtTime(0.0001, t0 + dt);
          gain.gain.exponentialRampToValueAtTime(0.15, t0 + dt + 0.02);
          gain.gain.exponentialRampToValueAtTime(0.0001, t0 + dt + 0.28);
          osc.connect(gain).connect(ctx.destination);
          osc.start(t0 + dt);
          osc.stop(t0 + dt + 0.3);
        });
      } catch (_) {}
    }
    // Browsers block audio until a user gesture — unlock on the first one so
    // later bot replies can chime.
    ['pointerdown', 'keydown', 'touchstart'].forEach((ev) =>
      window.addEventListener(
        ev,
        () => {
          const ctx = ensureAudio();
          if (ctx && ctx.state === 'suspended') ctx.resume().catch(() => {});
        },
        { once: true, passive: true }
      )
    );

    function setOpen(open) {
      root.dataset.open = String(open);
      panel.hidden = !open;
      if (open) {
        if (!greeted) {
          greeted = true;
          addBubble('model', GREETING);
        }
        setTimeout(() => input.focus(), 50);
      }
    }

    function escapeHtml(s) {
      return s.replace(/[&<>"]/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c])
      );
    }

    // Light Markdown for bot replies (**bold** + bullet lists) so they render
    // clean instead of showing raw asterisks. Input is escaped first.
    function formatBot(text) {
      return escapeHtml(text)
        .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
        .replace(/^[ \t]*[*\-]\s+/gm, '• ');
    }

    // Build a chat row. Bot rows get an avatar + agent name on the left (live-
    // chat style); user rows are a plain bubble pushed to the right.
    function makeRow(isUser) {
      const row = document.createElement('div');
      row.className = 'advisor-row advisor-row-' + (isUser ? 'user' : 'bot');
      if (!isUser) {
        const av = document.createElement('img');
        av.className = 'advisor-avatar';
        av.src = '/FuNGAMING%20logo.png';
        av.alt = '';
        av.setAttribute('aria-hidden', 'true');
        row.appendChild(av);
      }
      const stack = document.createElement('div');
      stack.className = 'advisor-stack';
      if (!isUser) {
        const name = document.createElement('div');
        name.className = 'advisor-name';
        name.textContent = 'Trợ Lý FunGaming';
        stack.appendChild(name);
      }
      row.appendChild(stack);
      log.appendChild(row);
      log.scrollTop = log.scrollHeight;
      return { row, stack };
    }

    function addBubble(role, text) {
      const isUser = role === 'user';
      const { row, stack } = makeRow(isUser);
      const el = document.createElement('div');
      el.className = 'advisor-msg advisor-msg-' + (isUser ? 'user' : 'bot');
      if (isUser) {
        el.textContent = text;
      } else {
        el.innerHTML = formatBot(text);
      }
      stack.appendChild(el);
      log.scrollTop = log.scrollHeight;
      if (!isUser) playChime();
      return row;
    }

    function showTyping() {
      const { row, stack } = makeRow(false);
      const el = document.createElement('div');
      el.className = 'advisor-msg advisor-msg-bot advisor-typing';
      el.innerHTML = '<span></span><span></span><span></span>';
      stack.appendChild(el);
      log.scrollTop = log.scrollHeight;
      return row;
    }

    async function send(text) {
      if (busy) return;
      busy = true;
      sendBtn.disabled = true;
      input.disabled = true;
      // Starter suggestions are only useful before the conversation begins.
      if (chips) chips.style.display = 'none';

      addBubble('user', text);
      history.push({ role: 'user', text });
      const typing = showTyping();

      try {
        const res = await fetch('/api/advisor', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ messages: history }),
        });
        const data = await res.json().catch(() => ({}));
        typing.remove();

        if (res.ok && data.reply) {
          addBubble('model', data.reply);
          history.push({ role: 'model', text: data.reply });
        } else {
          const msg =
            res.status === 503
              ? 'Trợ lý đang tạm bảo trì. Bạn nhắn trực tiếp @fungamingvnbot trên Telegram giúp mình nhé!'
              : 'Xin lỗi, mình gặp trục trặc kỹ thuật. Bạn thử lại hoặc nhắn @fungamingvnbot nhé!';
          addBubble('model', msg);
        }
      } catch {
        typing.remove();
        addBubble('model', 'Không kết nối được tới máy chủ. Bạn kiểm tra mạng rồi thử lại nhé!');
      } finally {
        busy = false;
        sendBtn.disabled = false;
        input.disabled = false;
        input.focus();
      }
    }

    toggle.addEventListener('click', () => setOpen(root.dataset.open !== 'true'));
    closeBtn.addEventListener('click', () => setOpen(false));

    if (chips) {
      chips.querySelectorAll('.advisor-chip').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (busy) return;
          send(btn.getAttribute('data-msg'));
        });
      });
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text || busy) return;
      input.value = '';
      send(text);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.dataset.open === 'true') setOpen(false);
    });

    // Auto-open shortly after load — once per browser session so we don't nag
    // on every refresh/navigation.
    let openedThisSession = false;
    try {
      openedThisSession = sessionStorage.getItem('advisorAutoOpened') === '1';
    } catch (_) {}
    if (!openedThisSession) {
      try {
        sessionStorage.setItem('advisorAutoOpened', '1');
      } catch (_) {}
      setTimeout(() => {
        if (root.dataset.open !== 'true') setOpen(true);
      }, 1200);
    }
  })();
</script>

<!-- is:global because message rows/avatars/bubbles are created at runtime via JS
     and therefore never receive Astro's scoped data-astro-cid attribute; scoped
     styles would not match them. Every selector here is .advisor-namespaced. -->
<style is:global>
  .advisor {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 1000;
    font-family: 'Inter', system-ui, sans-serif;
  }

  /* Floating button */
  .advisor-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border: 1px solid #6b3e15;
    border-radius: 999px;
    cursor: pointer;
    color: #1a0a05;
    background: linear-gradient(135deg, #f5d488 0%, #d4a04a 50%, #b3812e 100%);
    box-shadow: 0 6px 20px rgba(212, 160, 74, 0.35), inset 0 1px 0 rgba(255, 224, 159, 0.6);
    font-family: Georgia, serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 1px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .advisor-toggle:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(212, 160, 74, 0.5), inset 0 1px 0 rgba(255, 224, 159, 0.8);
  }
  .advisor-toggle-icon { font-size: 18px; }
  .advisor[data-open='true'] .advisor-toggle { display: none; }

  /* Panel */
  /* Visibility is driven by data-open, NOT the [hidden] attribute: an author
     `display` rule overrides UA [hidden]{display:none}, so relying on hidden
     here would leave the panel stuck open. */
  .advisor-panel { display: none; }
  .advisor[data-open='true'] .advisor-panel {
    position: absolute;
    right: 0;
    bottom: 0;
    width: min(380px, calc(100vw - 32px));
    height: min(560px, calc(100vh - 100px));
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, #0a0503 0%, #15090a 100%);
    border: 1px solid #6b4520;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
  }

  .advisor-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 16px;
    background: radial-gradient(ellipse at top left, #4a2810 0%, #1a0a05 70%);
    border-bottom: 1px solid #6b4520;
  }
  .advisor-header-title {
    font-family: Georgia, serif;
    font-size: 16px;
    color: #e8b659;
    letter-spacing: 1px;
    text-shadow: 0 0 10px rgba(232, 182, 89, 0.3);
  }
  .advisor-header-sub {
    margin-top: 2px;
    font-size: 11px;
    color: #a8763a;
    font-style: italic;
  }
  .advisor-close {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border: 1px solid #6b4520;
    border-radius: 6px;
    background: transparent;
    color: #a8763a;
    cursor: pointer;
    font-size: 13px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .advisor-close:hover { color: #f5d488; border-color: #d4a04a; }

  /* Message log */
  .advisor-log {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  /* Chat rows — live-chat layout: bot hugs the left, user hugs the right.
     align-self puts each row on its own side regardless of width. */
  .advisor-row {
    display: flex;
    gap: 8px;
    max-width: 85%;
  }
  .advisor-row-bot { align-self: flex-start; align-items: flex-end; }
  .advisor-row-user { align-self: flex-end; }

  .advisor-avatar {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: contain;
    padding: 3px;
    box-sizing: border-box;
    background: #1a0a05;
    border: 1px solid #6b4520;
  }

  .advisor-stack {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .advisor-name {
    margin: 0 0 3px 4px;
    font-size: 11px;
    color: #a8763a;
    letter-spacing: 0.5px;
  }
  .advisor-row-user .advisor-stack { align-items: flex-end; }

  .advisor-msg {
    padding: 10px 13px;
    border-radius: 14px;
    line-height: 1.45;
    white-space: pre-wrap;
    word-wrap: break-word;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 14px;
  }

  /* Bot: light "agent" bubble on the left, like a live-chat reply. */
  .advisor-msg-bot {
    color: #2a1810;
    background: #f1e8d8;
    border-top-left-radius: 4px;
  }
  .advisor-msg-bot strong { color: #8a5212; font-weight: 700; }

  /* User: gold bubble on the right. */
  .advisor-msg-user {
    color: #1a0a05;
    background: linear-gradient(135deg, #f5d488 0%, #d4a04a 100%);
    border-top-right-radius: 4px;
    font-weight: 500;
  }

  /* Quick-reply chips — starter suggestions above the input. */
  .advisor-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0 12px 10px;
  }
  .advisor-chip {
    border: 1px solid #6b4520;
    background: #1f1109;
    color: #e8b659;
    border-radius: 999px;
    padding: 7px 12px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 12.5px;
    cursor: pointer;
    white-space: nowrap;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .advisor-chip:hover {
    background: #2a1810;
    border-color: #d4a04a;
    color: #f5d488;
  }

  /* Typing indicator */
  .advisor-typing { display: flex; gap: 4px; align-items: center; min-height: 20px; }
  .advisor-typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #8a5212;
    animation: advisor-blink 1.2s infinite ease-in-out both;
  }
  .advisor-typing span:nth-child(2) { animation-delay: 0.2s; }
  .advisor-typing span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes advisor-blink {
    0%, 80%, 100% { opacity: 0.3; }
    40% { opacity: 1; }
  }

  /* Input */
  .advisor-form {
    display: flex;
    gap: 8px;
    padding: 12px;
    border-top: 1px solid #3a2810;
    background: #0a0503;
  }
  .advisor-input {
    flex: 1;
    padding: 10px 12px;
    border: 1px solid #3a2810;
    border-radius: 999px;
    background: #15090a;
    color: #e8d8c0;
    font-size: 14px;
    outline: none;
    transition: border-color 0.2s ease;
  }
  .advisor-input:focus { border-color: #d4a04a; }
  .advisor-input::placeholder { color: #6b4520; }
  .advisor-send {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    border: 1px solid #6b3e15;
    border-radius: 50%;
    cursor: pointer;
    color: #1a0a05;
    background: linear-gradient(135deg, #f5d488 0%, #d4a04a 100%);
    font-size: 18px;
    font-weight: 700;
    transition: transform 0.15s ease, opacity 0.2s ease;
  }
  .advisor-send:hover { transform: scale(1.05); }
  .advisor-send:disabled { opacity: 0.5; cursor: default; transform: none; }

  @media (max-width: 480px) {
    .advisor { right: 14px; bottom: 14px; }
    .advisor-panel { height: min(70vh, calc(100vh - 90px)); }
  }
</style>
