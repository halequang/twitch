---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { GAMES, DEFAULT_GAME } from '../data/rental-plans.js';

const games = Object.entries(GAMES).map(([id, g]) => ({ id, name: g.name }));
---

<Layout
  advisor={false} title="Admin · FunGaming VN" description="Quản trị tài khoản cho thuê và đơn hàng.">
  <Header compact brand="Admin" tagline="Account pool · Orders" taglineVi="Quản trị kho tài khoản và đơn thuê" />

  <section id="adminLoading" class="state">⟡ Đang kiểm tra quyền truy cập…</section>

  <section id="adminDenied" class="state" hidden>
    <p class="denied-title">Không có quyền truy cập</p>
    <p class="denied-body" id="deniedBody"></p>
    <a class="btn" href="/thuegame/theisle">Về trang thành viên</a>
  </section>

  <section id="adminPanel" hidden>
    <div class="admin-bar">
      <span class="admin-who" id="adminWho"></span>
      <button type="button" class="btn ghost" id="refreshBtn">Tải lại</button>
    </div>

    <p id="adminNotice" class="notice" hidden></p>

    <div class="stats" id="stats"></div>

    <section id="expiringWrap" class="card soon" hidden>
      <div class="soon-head">
        <h2 class="head" style="margin:0">⏳ Sắp hết hạn</h2>
        <label class="soon-window">Trong
          <select id="expiringHours">
            <option value="6" selected>6 giờ</option>
            <option value="24">24 giờ</option>
            <option value="72">3 ngày</option>
            <option value="168">7 ngày</option>
          </select>
        </label>
      </div>
      <div class="table-wrap">
        <table class="tbl">
          <thead>
            <tr>
              <th>Còn lại</th><th>Tài khoản</th><th>Nhóm</th><th>Khách</th>
              <th>Gói</th><th>Hết hạn lúc</th><th>Mã đơn</th>
            </tr>
          </thead>
          <tbody id="expiringBody"></tbody>
        </table>
      </div>
      <p class="soon-note">
        Sau khi hết hạn, tài khoản tự trả về kho — nhớ đổi mật khẩu Steam trước khi
        cho thuê lại, vì khách cũ vẫn biết mật khẩu hiện tại.
      </p>
    </section>


    <h2 class="head spaced">Kho tài khoản</h2>

    <form id="addForm" class="card form">
      <p class="form-title">Thêm tài khoản</p>
      <div class="grid">
        <label>Game
          <select name="game">
            {games.map((g) => <option value={g.id} selected={g.id === DEFAULT_GAME}>{g.name}</option>)}
          </select>
        </label>
        <label>Nhóm
          <select name="groupId" id="addGroup"><option value="">— chưa phân nhóm —</option></select>
        </label>
        <label>Login <input name="login" required autocomplete="off" /></label>
        <label>Mật khẩu Steam <input name="password" required autocomplete="new-password" /></label>
        <label>Email <input name="email" autocomplete="off" /></label>
        <label>Mật khẩu email <input name="emailPassword" autocomplete="new-password" /></label>
        <label>Ghi chú cho khách <input name="note" placeholder="Hiện cùng thông tin đăng nhập" /></label>
        <label>Ghi chú nội bộ <input name="internalNote" placeholder="Chỉ admin thấy" /></label>
      </div>
      <button type="submit" class="btn">Thêm vào kho</button>
    </form>

    <div class="table-wrap">
      <table class="tbl" id="accountsTable">
        <thead>
          <tr>
            <th>#</th><th>Login</th><th>Nhóm</th><th>Email</th><th>Trạng thái</th>
            <th>Đang thuê</th><th>Ghi chú</th><th class="right">Thao tác</th>
          </tr>
        </thead>
        <tbody id="accountsBody"></tbody>
      </table>
    </div>

    <h2 class="head spaced">Đơn hàng</h2>
    <div class="table-wrap">
      <table class="tbl" id="ordersTable">
        <thead>
          <tr>
            <th>Mã đơn</th><th>Khách</th><th>Gói</th><th>Số tiền</th>
            <th>Trạng thái</th><th>Tài khoản</th><th>Tạo lúc</th><th>Hết hạn</th>
          </tr>
        </thead>
        <tbody id="ordersBody"></tbody>
      </table>
    </div>

    <section id="ownerOnly" hidden>
      <h2 class="head">Nhóm tài khoản</h2>
      <form id="groupForm" class="card form">
        <p class="form-title">Thêm nhóm</p>
        <div class="grid">
          <label>Tên nhóm <input name="name" required autocomplete="off" placeholder="Kho A" /></label>
          <label>Ghi chú <input name="note" autocomplete="off" placeholder="Nhà cung cấp, lô hàng…" /></label>
        </div>
        <button type="submit" class="btn">Thêm nhóm</button>
      </form>
      <div class="table-wrap">
        <table class="tbl">
          <thead><tr><th>#</th><th>Tên</th><th>Ghi chú</th><th>Số tài khoản</th><th class="right">Thao tác</th></tr></thead>
          <tbody id="groupsBody"></tbody>
        </table>
      </div>

      <h2 class="head spaced">Quản trị viên</h2>
      <form id="managerForm" class="card form">
        <p class="form-title">Thêm / cập nhật quản trị viên</p>
        <div class="grid">
          <label>Email hoặc provider:sub
            <input name="identity" required autocomplete="off" placeholder="an@shop.vn" />
          </label>
          <label>Tên gợi nhớ <input name="label" autocomplete="off" placeholder="An — kho A" /></label>
        </div>
        <p class="form-title">Nhóm được quản lý</p>
        <div id="managerGroupPicks" class="picks"></div>
        <button type="submit" class="btn">Lưu quản trị viên</button>
      </form>
      <div class="table-wrap">
        <table class="tbl">
          <thead><tr><th>#</th><th>Danh tính</th><th>Tên</th><th>Nhóm</th><th class="right">Thao tác</th></tr></thead>
          <tbody id="managersBody"></tbody>
        </table>
      </div>
    </section>

  </section>
</Layout>

<!-- Admin runs on a light dashboard theme: dense tabular data is far easier to
     scan on light-on-dark's opposite. These overrides are global because the
     shell (body, header) comes from global.css — but this <style> only ships in
     admin.html, so the shop's dark theme is untouched. -->
<style is:global>
  :root {
    --ad-bg: #eef1f6;
    --ad-surface: #ffffff;
    --ad-line: #d9dfe8;
    --ad-line-soft: #eaeef4;
    --ad-text: #1f2733;
    --ad-text-dim: #5b6676;
    --ad-text-mute: #8b96a5;
    --ad-accent: #2563c9;
    --ad-accent-soft: #e8f0fd;
    --ad-green: #1f7a45;
    --ad-green-soft: #e4f4ea;
    --ad-amber: #9a6206;
    --ad-amber-soft: #fdf0d9;
    --ad-red: #b3261e;
    --ad-red-soft: #fbe6e5;
  }

  html, body {
    background: var(--ad-bg);
    color: var(--ad-text);
  }

  /* The shop's vignette + scanline overlay would only muddy a data view. */
  body { background-image: none; }
  body::before { display: none; }

  .wrap { max-width: 1240px; padding: 28px 20px 80px; }

  /* Header: keep the logo, drop the gold-on-black treatment. */
  header { padding: 8px 0 22px; }
  header h1 { color: var(--ad-text); text-shadow: none; }
  header .brand-fun { color: var(--ad-text); }
  header .brand-gaming { color: var(--ad-text-mute); }
  header .tagline { color: var(--ad-text-dim); }
  header .tagline-vi { color: var(--ad-text-mute); }
  header .brand-logo { filter: none; }

  #toTop { background: var(--ad-surface); color: var(--ad-text); border-color: var(--ad-line); }
</style>

<style>
  .state {
    text-align: center;
    padding: 60px 20px;
    color: var(--ad-text-dim);
    font-size: 14px;
  }

  .denied-title {
    font-size: 20px;
    font-weight: 600;
    color: var(--ad-text);
    margin-bottom: 10px;
  }

  .denied-body { font-size: 13px; color: var(--ad-text-mute); margin-bottom: 22px; line-height: 1.7; }

  .admin-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    margin-bottom: 18px;
    background: var(--ad-surface);
    border: 1px solid var(--ad-line);
    border-radius: 8px;
    box-shadow: 0 1px 2px rgba(23, 34, 51, 0.05);
  }

  .admin-who { flex: 1; font-size: 13px; color: var(--ad-text-dim); }

  .notice {
    padding: 12px 16px;
    margin-bottom: 18px;
    font-size: 13px;
    line-height: 1.6;
    border: 1px solid #bfd4f5;
    border-radius: 8px;
    background: var(--ad-accent-soft);
    color: #16407f;
  }

  .notice.error { border-color: #f0c2bf; background: var(--ad-red-soft); color: var(--ad-red); }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 12px;
    margin-bottom: 32px;
  }

  .stats :global(.stat-box) {
    padding: 16px 12px;
    text-align: center;
    background: var(--ad-surface);
    border: 1px solid var(--ad-line);
    border-radius: 8px;
    box-shadow: 0 1px 2px rgba(23, 34, 51, 0.05);
  }

  .stats :global(.stat-box b) {
    display: block;
    font-size: 24px;
    font-weight: 700;
    color: var(--ad-text);
    margin-bottom: 4px;
  }

  .stats :global(.stat-box span) {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ad-text-mute);
  }

  .head {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--ad-text);
    margin-bottom: 14px;
  }

  .head.spaced { margin-top: 44px; }

  .card {
    padding: 20px;
    margin-bottom: 22px;
    background: var(--ad-surface);
    border: 1px solid var(--ad-line);
    border-radius: 8px;
    box-shadow: 0 1px 2px rgba(23, 34, 51, 0.05);
  }

  .form-title {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ad-accent);
    margin-bottom: 16px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 14px;
    margin-bottom: 18px;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ad-text-mute);
  }

  input, select {
    padding: 10px 12px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ad-text);
    background: var(--ad-surface);
    border: 1px solid var(--ad-line);
    border-radius: 6px;
  }

  input::placeholder { color: var(--ad-text-mute); }

  input:focus, select:focus {
    outline: none;
    border-color: var(--ad-accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 201, 0.15);
  }

  .soon { border-left: 3px solid var(--ad-amber); }

  .soon-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .soon-window {
    margin-left: auto;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    text-transform: none;
    letter-spacing: 0;
    font-size: 13px;
    color: var(--ad-text-dim);
  }

  .soon-note {
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--ad-text-dim);
  }

  /* Rows are built by the script, hence :global. */
  .soon :global(.left-badge) {
    display: inline-block;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
    border-radius: 999px;
    white-space: nowrap;
    background: var(--ad-amber-soft);
    color: var(--ad-amber);
  }

  /* Under an hour is the one that needs attention now. */
  .soon :global(.left-badge.urgent) { background: var(--ad-red-soft); color: var(--ad-red); }

  .picks {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-bottom: 18px;
  }

  .picks :global(.pick) {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ad-text);
  }

  .picks :global(input[type="checkbox"]) { width: 16px; height: 16px; }

  .table-wrap { overflow-x: auto; margin-bottom: 10px; }

  .soon { border-left: 3px solid var(--ad-amber); }

  .soon-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .soon-window {
    margin-left: auto;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    text-transform: none;
    letter-spacing: 0;
    font-size: 13px;
    color: var(--ad-text-dim);
  }

  .soon-note {
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--ad-text-dim);
  }

  /* Rows are built by the script, hence :global. */
  .soon :global(.left-badge) {
    display: inline-block;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
    border-radius: 999px;
    white-space: nowrap;
    background: var(--ad-amber-soft);
    color: var(--ad-amber);
  }

  /* Under an hour is the one that needs attention now. */
  .soon :global(.left-badge.urgent) { background: var(--ad-red-soft); color: var(--ad-red); }

  .picks {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-bottom: 18px;
  }

  .picks :global(.pick) {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ad-text);
  }

  .picks :global(input[type="checkbox"]) { width: 16px; height: 16px; }

  .table-wrap {
    background: var(--ad-surface);
    border: 1px solid var(--ad-line);
    border-radius: 8px;
    box-shadow: 0 1px 2px rgba(23, 34, 51, 0.05);
  }

  .tbl { width: 100%; border-collapse: collapse; font-size: 13.5px; }

  .tbl :global(tbody tr:nth-child(even)) { background: #fafbfd; }
  .tbl :global(tbody tr:hover) { background: var(--ad-accent-soft); }
  .tbl :global(tbody tr:last-child td) { border-bottom: none; }

  .tbl th {
    padding: 12px 14px;
    background: #f4f6fa;
    text-align: left;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ad-text-mute);
    border-bottom: 1px solid var(--ad-line);
    white-space: nowrap;
  }

  .tbl :global(td) {
    padding: 12px 14px;
    border-bottom: 1px solid var(--ad-line-soft);
    color: var(--ad-text);
    vertical-align: middle;
  }

  .tbl :global(td.right), .tbl th.right { text-align: right; white-space: nowrap; }

  .tbl :global(code) {
    font-family: 'Courier New', monospace;
    font-size: 13px;
    color: var(--ad-text);
  }

  .tbl :global(.pill) {
    display: inline-block;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    border-radius: 999px;
    white-space: nowrap;
    background: var(--ad-line-soft);
    color: var(--ad-text-dim);
    border: none;
    text-transform: none;
  }

  /* Green = sellable, amber = out with a customer, grey = parked,
     red = needs a human. */
  .tbl :global(.pill.available) { background: var(--ad-green-soft); color: var(--ad-green); }
  .tbl :global(.pill.active)    { background: var(--ad-green-soft); color: var(--ad-green); }
  .tbl :global(.pill.rented)    { background: var(--ad-amber-soft); color: var(--ad-amber); }
  .tbl :global(.pill.pending)   { background: var(--ad-accent-soft); color: var(--ad-accent); }
  .tbl :global(.pill.sold)      { background: #ede9fe; color: #5b32b8; }
  .tbl :global(.pill.disabled)  { background: var(--ad-line-soft); color: var(--ad-text-mute); }
  .tbl :global(.pill.expired)   { background: var(--ad-line-soft); color: var(--ad-text-mute); }
  .tbl :global(.pill.cancelled) { background: var(--ad-line-soft); color: var(--ad-text-mute); }
  .tbl :global(.pill.payment_expired) { background: var(--ad-line-soft); color: var(--ad-text-mute); }
  .tbl :global(.pill.extended)  { background: var(--ad-accent-soft); color: var(--ad-accent); }
  .tbl :global(.pill.awaiting_stock) { background: var(--ad-red-soft); color: var(--ad-red); }
  .tbl :global(.pill.error)     { background: var(--ad-red-soft); color: var(--ad-red); }

  /* ─── buttons ──────────────────────────────── */
  .btn {
    display: inline-block;
    padding: 10px 18px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: #fff;
    background: var(--ad-accent);
    border: 1px solid var(--ad-accent);
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .btn:hover { background: #1d54ab; }

  .btn.ghost {
    color: var(--ad-text-dim);
    background: var(--ad-surface);
    border-color: var(--ad-line);
  }

  .btn.ghost:hover { background: #f4f6fa; color: var(--ad-text); }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }

  /* Row actions are created by the script, hence :global. */
  .tbl :global(.mini) {
    padding: 6px 11px;
    margin-left: 6px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: var(--ad-text-dim);
    background: var(--ad-surface);
    border: 1px solid var(--ad-line);
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .muted, .tbl :global(.muted) { color: var(--ad-text-mute); font-size: 13px; }

  .tbl :global(tr.edit-row td) {
    background: var(--ad-bg);
    padding: 18px 14px;
  }

  .tbl :global(.edit-form .grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
    margin-bottom: 16px;
  }

  .tbl :global(.edit-form label) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ad-text-mute);
  }

  .tbl :global(tr.edit-row) { background: #f4f6fa !important; }

  .tbl :global(.edit-form input),
  .tbl :global(.edit-form select) {
    padding: 9px 11px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ad-text);
    background: var(--ad-surface);
    border: 1px solid var(--ad-line);
    border-radius: 6px;
  }

  .tbl :global(.edit-form input:focus),
  .tbl :global(.edit-form select:focus) {
    outline: none;
    border-color: var(--ad-accent);
  }

  .tbl :global(.edit-actions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .tbl :global(.edit-actions .btn) {
    display: inline-block;
    padding: 9px 18px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: var(--ad-accent);
    border: 1px solid var(--ad-accent);
    border-radius: 6px;
    cursor: pointer;
  }

  .tbl :global(.edit-actions .btn.ghost) {
    color: var(--ad-text-dim);
    background: var(--ad-surface);
    border-color: var(--ad-line);
  }
  .tbl :global(.edit-actions .btn:disabled) { opacity: 0.5; cursor: not-allowed; }

  .tbl :global(.edit-hint) { font-size: 11px; color: var(--ad-text-mute); }

  .tbl :global(.mini:disabled) { opacity: 0.45; cursor: default; }

  .tbl :global(.mini:hover:not(:disabled)) { border-color: var(--ad-accent); color: var(--ad-accent); }
  .tbl :global(.mini.danger) { color: var(--ad-red); }
  .tbl :global(.mini.danger:hover) { border-color: var(--ad-red); background: var(--ad-red-soft); }

  .tbl :global(.muted), .muted { color: var(--ad-text-mute); font-size: 12px; }
</style>

<script>
  const el = (id) => document.getElementById(id);
  const fmtVnd = (n) => new Intl.NumberFormat('vi-VN').format(n || 0) + '₫';
  const fmtTime = (s) => (s ? new Date(s * 1000).toLocaleString('vi-VN') : '—');

  function notice(message, isError) {
    const box = el('adminNotice');
    box.textContent = message;
    box.classList.toggle('error', Boolean(isError));
    box.hidden = false;
  }

  async function api(path, options = {}) {
    const res = await fetch('/api/admin/' + path, {
      credentials: 'same-origin',
      headers: options.body ? { 'content-type': 'application/json' } : undefined,
      ...options,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw Object.assign(new Error(data.error || String(res.status)), { data });
    return data;
  }

  let IS_OWNER = false;
  let GROUPS = [];

  const a_groupId = (account) => (account.groupId == null ? null : Number(account.groupId));

  /* ─── rendering ──────────────────────────────── */

  function cell(row, text, cls) {
    const td = document.createElement('td');
    if (cls) td.className = cls;
    if (text instanceof Node) td.appendChild(text);
    else td.textContent = text ?? '—';
    row.appendChild(td);
    return td;
  }

  function pill(text, kind) {
    const span = document.createElement('span');
    span.className = 'pill ' + (kind || '');
    span.textContent = text;
    return span;
  }

  function renderStats(s) {
    const items = [
      [s.accounts, 'Tài khoản'],
      [s.available, 'Còn trống'],
      [s.rented, 'Đang thuê'],
      [s.sold, 'Đã bán'],
      [s.disabled, 'Tạm khoá'],
      [s.activeRentals, 'Đơn đang chạy'],
      [s.expiringSoon, 'Sắp hết hạn (24h)'],
      [s.awaitingStock, 'Chờ xử lý'],
      [fmtVnd(s.revenue), 'Doanh thu'],
    ];
    const box = el('stats');
    box.textContent = '';
    for (const [value, label] of items) {
      const d = document.createElement('div');
      d.className = 'stat-box';
      const b = document.createElement('b');
      b.textContent = String(value ?? 0);
      const sp = document.createElement('span');
      sp.textContent = label;
      d.append(b, sp);
      box.appendChild(d);
    }
  }

  function renderAccounts(accounts) {
    const body = el('accountsBody');
    body.textContent = '';
    if (!accounts.length) {
      const tr = document.createElement('tr');
      const td = cell(tr, 'Kho trống — thêm tài khoản ở trên.');
      td.colSpan = 8;
      td.className = 'muted';
      body.appendChild(tr);
      return;
    }

    for (const a of accounts) {
      const tr = document.createElement('tr');
      cell(tr, String(a.id));

      const login = document.createElement('code');
      login.textContent = a.login;
      cell(tr, login);

      cell(tr, a.groupName || '— chưa phân nhóm —');
      cell(tr, a.email || '—');
      cell(tr, pill(a.status, a.status));
      cell(
        tr,
        a.rental
          // userEmail is null for providers that give none; userKey always exists.
          ? `${a.rental.userEmail || a.rental.userKey} · đến ${fmtTime(a.rental.expiresAt)}`
          : '—'
      );
      cell(tr, [a.note, a.internalNote && '(' + a.internalNote + ')'].filter(Boolean).join(' ') || '—');

      const actions = document.createElement('td');
      actions.className = 'right';

      const reveal = document.createElement('button');
      reveal.className = 'mini';
      reveal.textContent = 'Xem mật khẩu';
      reveal.addEventListener('click', () => revealAccount(a, actions, reveal));
      actions.appendChild(reveal);

      const edit = document.createElement('button');
      edit.className = 'mini';
      edit.textContent = 'Sửa';
      edit.addEventListener('click', () => editAccount(a, tr));
      actions.appendChild(edit);

      const del = document.createElement('button');
      del.className = 'mini danger';
      del.textContent = 'Xoá';
      del.addEventListener('click', () => removeAccount(a));
      actions.appendChild(del);

      tr.appendChild(actions);
      body.appendChild(tr);
    }
  }

  function renderOrders(orders) {
    const body = el('ordersBody');
    body.textContent = '';
    if (!orders.length) {
      const tr = document.createElement('tr');
      const td = cell(tr, 'Chưa có đơn nào.');
      td.colSpan = 8;
      td.className = 'muted';
      body.appendChild(tr);
      return;
    }
    for (const o of orders) {
      const tr = document.createElement('tr');
      const code = document.createElement('code');
      code.textContent = String(o.orderCode);
      cell(tr, code);
      cell(tr, o.userEmail || o.userKey);
      cell(tr, `${o.planId} (${o.hours}h)` + (o.extendsOrder ? ` · gia hạn #${o.extendsOrder}` : ''));
      cell(tr, fmtVnd(o.amount));
      cell(tr, pill(o.status, o.status));
      cell(tr, o.accountLogin || '—');
      cell(tr, fmtTime(o.createdAt));
      cell(tr, fmtTime(o.expiresAt));
      body.appendChild(tr);
    }
  }


  function fillGroupSelect(select) {
    if (!select) return;
    const current = select.value;
    select.textContent = '';
    if (IS_OWNER) {
      const none = document.createElement('option');
      none.value = '';
      none.textContent = '— chưa phân nhóm —';
      select.appendChild(none);
    }
    for (const g of GROUPS) {
      const option = document.createElement('option');
      option.value = String(g.id);
      option.textContent = g.name;
      select.appendChild(option);
    }
    select.value = current;
  }

  function humanLeft(seconds) {
    if (seconds <= 0) return 'hết hạn';
    const d = Math.floor(seconds / 86400);
    const h = Math.floor((seconds % 86400) / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    if (d > 0) return `${d} ngày ${h} giờ`;
    if (h > 0) return `${h} giờ ${String(m).padStart(2, '0')} phút`;
    return `${m} phút`;
  }

  function renderExpiring(rows, hours) {
    const wrap = el('expiringWrap');
    const body = el('expiringBody');
    body.textContent = '';

    // Hide the whole block when there is nothing to act on, rather than showing
    // an empty table that reads like a problem.
    if (!rows.length) {
      wrap.hidden = true;
      return;
    }
    wrap.hidden = false;

    const nowSec = Math.floor(Date.now() / 1000);
    for (const r of rows) {
      const tr = document.createElement('tr');
      const left = r.expiresAt - nowSec;
      const badge = document.createElement('span');
      badge.className = 'left-badge' + (left <= 3600 ? ' urgent' : '');
      badge.textContent = humanLeft(left);
      cell(tr, badge);

      const login = document.createElement('code');
      login.textContent = r.accountLogin;
      cell(tr, login);

      cell(tr, r.groupName || '—');
      cell(tr, r.userEmail || r.userKey);
      cell(tr, `${r.planId} (${r.rentedHours}h)`);
      cell(tr, fmtTime(r.expiresAt));
      const code = document.createElement('code');
      code.textContent = String(r.orderCode);
      cell(tr, code);
      body.appendChild(tr);
    }
  }

  async function loadExpiring() {
    const hours = el('expiringHours')?.value || 24;
    try {
      const data = await api('expiring?hours=' + hours);
      renderExpiring(data.expiring, data.hours);
    } catch {
      el('expiringWrap').hidden = true;
    }
  }

  el('expiringHours')?.addEventListener('change', loadExpiring);

  function renderGroups(groups) {
    GROUPS = groups;
    fillGroupSelect(el('addGroup'));

    const body = el('groupsBody');
    if (!body) return;
    body.textContent = '';
    if (!groups.length) {
      const tr = document.createElement('tr');
      const td = cell(tr, 'Chưa có nhóm nào — thêm ở trên.');
      td.colSpan = 5;
      td.className = 'muted';
      body.appendChild(tr);
    }
    for (const g of groups) {
      const tr = document.createElement('tr');
      cell(tr, String(g.id));
      cell(tr, g.name);
      cell(tr, g.note || '—');
      cell(tr, String(g.accounts));
      const actions = document.createElement('td');
      actions.className = 'right';
      const del = document.createElement('button');
      del.className = 'mini danger';
      del.textContent = 'Xoá';
      del.addEventListener('click', async () => {
        if (!confirm(`Xoá nhóm "${g.name}"?`)) return;
        try {
          const data = await api('groups/' + g.id, { method: 'DELETE' });
          renderGroups(data.groups);
          notice('Đã xoá nhóm "' + g.name + '".', false);
          loadAll();
        } catch (err) {
          if (err.data?.error === 'group_not_empty') {
            notice(
              'Nhóm còn ' + err.data.accounts + ' tài khoản. Chuyển chúng sang nhóm khác trước khi xoá.',
              true
            );
          } else {
            notice('Xoá nhóm thất bại: ' + err.message, true);
          }
        }
      });
      actions.appendChild(del);
      tr.appendChild(actions);
      body.appendChild(tr);
    }

    // Checkbox list for assigning groups to a manager.
    const picks = el('managerGroupPicks');
    if (picks) {
      picks.textContent = '';
      for (const g of groups) {
        const label = document.createElement('label');
        label.className = 'pick';
        const box = document.createElement('input');
        box.type = 'checkbox';
        box.value = String(g.id);
        box.name = 'group';
        label.append(box, document.createTextNode(' ' + g.name));
        picks.appendChild(label);
      }
    }
  }

  function renderManagers(managers) {
    const body = el('managersBody');
    if (!body) return;
    body.textContent = '';
    if (!managers.length) {
      const tr = document.createElement('tr');
      const td = cell(tr, 'Chưa có quản trị viên nào. Chủ shop luôn truy cập được qua ADMIN_EMAILS.');
      td.colSpan = 5;
      td.className = 'muted';
      body.appendChild(tr);
      return;
    }
    for (const m of managers) {
      const tr = document.createElement('tr');
      cell(tr, String(m.id));
      const id = document.createElement('code');
      id.textContent = m.identity;
      cell(tr, id);
      cell(tr, m.label || '—');
      cell(tr, m.groupNames || '(chưa gán nhóm)');
      const actions = document.createElement('td');
      actions.className = 'right';
      const del = document.createElement('button');
      del.className = 'mini danger';
      del.textContent = 'Xoá';
      del.addEventListener('click', async () => {
        if (!confirm(`Xoá quyền quản trị của "${m.identity}"?`)) return;
        try {
          const data = await api('managers/' + m.id, { method: 'DELETE' });
          renderManagers(data.managers);
          notice('Đã xoá quản trị viên "' + m.identity + '".', false);
        } catch (err) {
          notice('Xoá thất bại: ' + err.message, true);
        }
      });
      actions.appendChild(del);
      tr.appendChild(actions);
      body.appendChild(tr);
    }
  }

  /* ─── actions ────────────────────────────────── */

  async function revealAccount(account, container, button) {
    button.disabled = true;
    try {
      const data = await api('accounts/' + account.id + '/reveal', { method: 'POST' });
      const lines = [
        'Login: ' + data.login,
        'Mật khẩu: ' + data.password,
        data.email ? 'Email: ' + data.email : null,
        data.emailPassword ? 'Mật khẩu email: ' + data.emailPassword : null,
      ].filter(Boolean);
      // Shown inline rather than in a dialog so it can be copied, and it
      // disappears on the next refresh instead of lingering.
      const pre = document.createElement('div');
      pre.className = 'muted';
      pre.style.marginTop = '8px';
      pre.style.textAlign = 'left';
      pre.style.fontFamily = "'Courier New', monospace";
      pre.textContent = lines.join('\n');
      pre.style.whiteSpace = 'pre-wrap';
      container.appendChild(pre);
      // Disable in place rather than remove: removing it shifts "Sửa"/"Xoá"
      // left, so the next click lands on a different action than the one the
      // eye expects — an easy way to delete an account by accident.
      button.textContent = 'Đã hiện';
      button.disabled = true;
    } catch (err) {
      notice('Không đọc được mật khẩu: ' + (err.data?.hint || err.message), true);
      button.disabled = false;
    }
  }

  const EDIT_FIELDS = [
    { name: 'login', label: 'Login', value: (a) => a.login || '' },
    { name: 'email', label: 'Email', value: (a) => a.email || '' },
    { name: 'password', label: 'Mật khẩu Steam', placeholder: 'để trống = giữ nguyên', value: () => '' },
    { name: 'emailPassword', label: 'Mật khẩu email', placeholder: 'để trống = giữ nguyên', value: () => '' },
    { name: 'note', label: 'Ghi chú cho khách', value: (a) => a.note || '' },
    { name: 'internalNote', label: 'Ghi chú nội bộ', value: (a) => a.internalNote || '' },
  ];

  /** Opens an inline editor beneath the row. One at a time. */
  function editAccount(account, row) {
    const existing = document.querySelector('tr.edit-row');
    const wasMine = existing && existing.dataset.for === String(account.id);
    if (existing) existing.remove();
    if (wasMine) return; // clicking "Sửa" again closes it

    const tr = document.createElement('tr');
    tr.className = 'edit-row';
    tr.dataset.for = String(account.id);
    const td = document.createElement('td');
    td.colSpan = 8;

    const form = document.createElement('form');
    form.className = 'edit-form';

    const grid = document.createElement('div');
    grid.className = 'grid';
    for (const field of EDIT_FIELDS) {
      const label = document.createElement('label');
      label.textContent = field.label;
      const input = document.createElement('input');
      input.name = field.name;
      input.value = field.value(account);
      input.autocomplete = 'off';
      if (field.placeholder) input.placeholder = field.placeholder;
      label.appendChild(input);
      grid.appendChild(label);
    }

    // Only groups this actor may use — reassigning into someone else's group is
    // refused server-side anyway.
    const groupLabel = document.createElement('label');
    groupLabel.textContent = 'Nhóm';
    const groupSelect = document.createElement('select');
    groupSelect.name = 'groupId';
    if (IS_OWNER) {
      const none = document.createElement('option');
      none.value = '';
      none.textContent = '— chưa phân nhóm —';
      groupSelect.appendChild(none);
    }
    for (const g of GROUPS) {
      const option = document.createElement('option');
      option.value = String(g.id);
      option.textContent = g.name;
      if (g.id === a_groupId(account)) option.selected = true;
      groupSelect.appendChild(option);
    }
    groupLabel.appendChild(groupSelect);
    grid.appendChild(groupLabel);

    const statusLabel = document.createElement('label');
    statusLabel.textContent = 'Trạng thái';
    const select = document.createElement('select');
    select.name = 'status';
    for (const value of ['available', 'rented', 'sold', 'disabled']) {
      const option = document.createElement('option');
      option.value = value;
      option.textContent = value;
      if (value === account.status) option.selected = true;
      select.appendChild(option);
    }
    statusLabel.appendChild(select);
    grid.appendChild(statusLabel);
    form.appendChild(grid);

    const actions = document.createElement('div');
    actions.className = 'edit-actions';

    const save = document.createElement('button');
    save.type = 'submit';
    save.className = 'btn';
    save.textContent = 'Lưu thay đổi';

    const cancel = document.createElement('button');
    cancel.type = 'button';
    cancel.className = 'btn ghost';
    cancel.textContent = 'Huỷ';
    cancel.addEventListener('click', () => tr.remove());

    const hint = document.createElement('span');
    hint.className = 'edit-hint';
    hint.textContent = 'Ô mật khẩu để trống sẽ giữ nguyên mật khẩu đang lưu.';

    actions.append(save, cancel, hint);
    form.appendChild(actions);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      save.disabled = true;
      const payload = Object.fromEntries(new FormData(form).entries());
      try {
        const data = await api('accounts/' + account.id, {
          method: 'PATCH',
          body: JSON.stringify(payload),
        });
        renderAccounts(data.accounts);
        notice('Đã cập nhật tài khoản #' + account.id + '.', false);
        loadSummary();
      } catch (err) {
        save.disabled = false;
        if (err.data?.error === 'rental_active') {
          notice(
            'Tài khoản đang có đơn thuê #' + err.data.orderCode +
              ' — không thể đổi về "available" khi khách vẫn đang dùng.',
            true
          );
        } else if (err.data?.error === 'duplicate_login') {
          notice('Login này đã thuộc về tài khoản #' + err.data.id + '.', true);
        } else {
          notice('Cập nhật thất bại: ' + err.message, true);
        }
      }
    });

    td.appendChild(form);
    tr.appendChild(td);
    row.insertAdjacentElement('afterend', tr);
    form.querySelector('input')?.focus();
  }

  async function removeAccount(account) {
    if (!confirm(`Xoá tài khoản "${account.login}"? Lịch sử đơn hàng vẫn được giữ.`)) return;
    try {
      const data = await api('accounts/' + account.id, { method: 'DELETE' });
      renderAccounts(data.accounts);
      notice('Đã xoá tài khoản "' + account.login + '".', false);
      loadSummary();
    } catch (err) {
      if (err.data?.error === 'rental_active') {
        // Deleting mid-rental strips the login from a paying customer, so it
        // needs a second, explicit confirmation.
        const ok = confirm(
          'Tài khoản đang được thuê (đơn #' + err.data.orderCode + ', đến ' +
            fmtTime(err.data.expiresAt) + ').\n\nXoá vẫn sẽ khiến khách mất quyền truy cập. Tiếp tục?'
        );
        if (!ok) return;
        try {
          const data = await api('accounts/' + account.id + '?force=1', { method: 'DELETE' });
          renderAccounts(data.accounts);
          notice('Đã xoá tài khoản đang thuê "' + account.login + '".', true);
          loadSummary();
        } catch (e2) {
          notice('Xoá thất bại: ' + e2.message, true);
        }
        return;
      }
      notice('Xoá thất bại: ' + err.message, true);
    }
  }

  el('addForm').addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.target;
    const payload = Object.fromEntries(new FormData(form).entries());
    const submit = form.querySelector('button[type="submit"]');
    submit.disabled = true;
    try {
      const data = await api('accounts', { method: 'POST', body: JSON.stringify(payload) });
      renderAccounts(data.accounts);
      notice('Đã thêm "' + payload.login + '" vào kho.', false);
      form.reset();
      loadSummary();
    } catch (err) {
      const map = {
        duplicate_login: 'Login này đã có trong kho.',
        login_required: 'Thiếu login.',
        password_required: 'Thiếu mật khẩu Steam.',
      };
      notice(map[err.data?.error] || 'Thêm thất bại: ' + err.message, true);
    } finally {
      submit.disabled = false;
    }
  });

  el('groupForm')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.target;
    const submit = form.querySelector('button[type="submit"]');
    submit.disabled = true;
    try {
      const data = await api('groups', {
        method: 'POST',
        body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
      });
      renderGroups(data.groups);
      notice('Đã thêm nhóm.', false);
      form.reset();
    } catch (err) {
      notice(err.data?.error === 'duplicate_group' ? 'Tên nhóm này đã tồn tại.' : 'Thêm nhóm thất bại: ' + err.message, true);
    } finally {
      submit.disabled = false;
    }
  });

  el('managerForm')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.target;
    const submit = form.querySelector('button[type="submit"]');
    submit.disabled = true;
    const groupIds = [...form.querySelectorAll('input[name="group"]:checked')].map((b) => Number(b.value));
    try {
      const data = await api('managers', {
        method: 'POST',
        body: JSON.stringify({
          identity: form.identity.value,
          label: form.label.value,
          groupIds,
        }),
      });
      renderManagers(data.managers);
      notice(
        groupIds.length
          ? 'Đã lưu quản trị viên.'
          : 'Đã lưu, nhưng chưa gán nhóm nào — người này sẽ không thấy tài khoản nào.',
        !groupIds.length
      );
      form.reset();
      form.querySelectorAll('input[name="group"]').forEach((b) => (b.checked = false));
    } catch (err) {
      notice('Lưu quản trị viên thất bại: ' + err.message, true);
    } finally {
      submit.disabled = false;
    }
  });

  /* ─── boot ───────────────────────────────────── */

  async function loadSummary() {
    try {
      renderStats(await api('summary'));
    } catch {
      /* stats are decorative; the tables carry the real state */
    }
  }

  async function loadAll() {
    try {
      const [groups, accounts, orders] = await Promise.all([api('groups'), api('accounts'), api('orders')]);
      renderGroups(groups.groups);
      renderAccounts(accounts.accounts);
      renderOrders(orders.orders);
      await loadExpiring();
      if (IS_OWNER) {
        try {
          renderManagers((await api('managers')).managers);
        } catch {
          /* owner-only; ignore if it ever 403s */
        }
      }
      await loadSummary();
    } catch (err) {
      notice('Không tải được dữ liệu: ' + err.message, true);
    }
  }

  el('refreshBtn').addEventListener('click', loadAll);

  // The "còn lại" column is only correct at render time, so re-render it once a
  // minute. Cheap: it re-fetches nothing unless a row actually lapses.
  setInterval(() => {
    if (!el('expiringWrap').hidden) loadExpiring();
  }, 60_000);

  (async function boot() {
    let session;
    try {
      session = await api('session');
    } catch {
      session = { admin: false };
    }
    el('adminLoading').hidden = true;

    if (!session.admin) {
      el('deniedBody').textContent = session.email
        ? `Tài khoản ${session.email} không nằm trong danh sách quản trị (ADMIN_EMAILS).`
        : 'Bạn cần đăng nhập bằng tài khoản quản trị.';
      el('adminDenied').hidden = false;
      return;
    }

    IS_OWNER = session.role === 'owner';
    el('adminWho').textContent =
      (IS_OWNER ? 'Chủ shop: ' : 'Quản trị viên (theo nhóm): ') + (session.email || '—');
    // Group and manager administration is the owner's alone.
    const owner = el('ownerOnly');
    if (owner) owner.hidden = !IS_OWNER;
    el('adminPanel').hidden = false;
    loadAll();
  })();
</script>
