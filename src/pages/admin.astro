---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { GAMES, DEFAULT_GAME } from '../data/rental-plans.js';

const games = Object.entries(GAMES).map(([id, g]) => ({ id, name: g.name }));
---

<Layout
  advisor={false} title="Admin · FunGaming VN" description="Quản trị tài khoản cho thuê và đơn hàng.">
  <Header compact brand="Admin" tagline="Account pool · Orders" taglineVi="Quản trị kho tài khoản và đơn thuê" />

  <section id="adminLoading" class="state">⟡ Đang kiểm tra quyền truy cập…</section>

  <section id="adminDenied" class="state" hidden>
    <p class="denied-title">Không có quyền truy cập</p>
    <p class="denied-body" id="deniedBody"></p>
    <a class="btn" href="/thuegame/theisle">Về trang thành viên</a>
  </section>

  <section id="adminPanel" hidden>
    <div class="admin-bar">
      <span class="admin-who" id="adminWho"></span>
      <button type="button" class="btn ghost" id="refreshBtn">Tải lại</button>
    </div>

    <p id="adminNotice" class="notice" hidden></p>

    <div class="stats" id="stats"></div>

    <!-- The daily number, straight after the tiles: this is what the panel gets
         opened for each day. -->
    <section id="reportWrap" class="card daily">
      <div class="soon-head">
        <h2 class="head" style="margin:0">📊 Báo cáo ngày</h2>
        <label class="soon-window">Ngày
          <input type="date" id="reportDate" />
          <button type="button" id="reportPrev" class="mini">◀ Hôm trước</button>
          <button type="button" id="reportToday" class="mini">Hôm nay</button>
        </label>
      </div>
      <p id="reportTotals" class="report-totals"></p>
      <p id="reportWarn" class="report-warn" hidden></p>
      <div class="report-cols">
        <div class="table-wrap">
          <table class="tbl">
            <thead><tr><th>Nguồn tài khoản</th><th class="right">Đơn</th><th class="right">Doanh thu</th></tr></thead>
            <tbody id="reportBuckets"></tbody>
          </table>
        </div>
        <div class="table-wrap">
          <table class="tbl">
            <thead><tr><th>Gói</th><th class="right">Đơn</th><th class="right">Doanh thu</th></tr></thead>
            <tbody id="reportPlans"></tbody>
          </table>
        </div>
      </div>
      <p class="note">
        Đây là <strong>doanh thu</strong>, không phải lợi nhuận — hệ thống không lưu giá
        nhập tài khoản hay tỉ lệ chia cho quản lý.
      </p>
    </section>

    <!-- Renter complaints. Above "sắp hết hạn" on purpose: an expiry is a
         schedule, a report is somebody stuck right now. -->
    <section id="reportsWrap" class="card reports" hidden>
      <div class="soon-head">
        <h2 class="head" style="margin:0">🚨 Khách báo lỗi</h2>
        <label class="soon-window">
          <input type="checkbox" id="reportsAll" /> Xem cả đã xử lý
        </label>
      </div>
      <p id="reportsTelegram" class="note" hidden></p>
      <div class="table-wrap">
        <table class="tbl">
          <thead>
            <tr>
              <th>Lúc</th><th>Lý do</th><th>Tài khoản</th><th>Khách</th>
              <th>Nội dung</th><th>Mã đơn</th><th></th>
            </tr>
          </thead>
          <tbody id="reportsBody"></tbody>
        </table>
      </div>
    </section>

    <section id="expiringWrap" class="card soon" hidden>
      <div class="soon-head">
        <h2 class="head" style="margin:0">⏳ Sắp hết hạn</h2>
        <label class="soon-window">Trong
          <select id="expiringHours">
            <option value="6" selected>6 giờ</option>
            <option value="24">24 giờ</option>
            <option value="72">3 ngày</option>
            <option value="168">7 ngày</option>
          </select>
        </label>
      </div>
      <div class="table-wrap">
        <table class="tbl">
          <thead>
            <tr>
              <th>Còn lại</th><th>Tài khoản</th><th>Nhóm</th><th>Khách</th>
              <th>Gói</th><th>Hết hạn lúc</th><th>Mã đơn</th>
            </tr>
          </thead>
          <tbody id="expiringBody"></tbody>
        </table>
      </div>
      <p class="soon-note">
        Sau khi hết hạn, tài khoản tự trả về kho — nhớ đổi mật khẩu Steam trước khi
        cho thuê lại, vì khách cũ vẫn biết mật khẩu hiện tại.
      </p>
    </section>


    <h2 class="head spaced" id="accountsSection">Kho tài khoản</h2>

    <form id="addForm" class="card form">
      <p class="form-title">Thêm tài khoản</p>
      <div class="grid">
        <label>Game
          <select name="game">
            {games.map((g) => <option value={g.id} selected={g.id === DEFAULT_GAME}>{g.name}</option>)}
          </select>
        </label>
        <label>Nhóm
          <select name="groupId" id="addGroup"><option value="">— chưa phân nhóm —</option></select>
        </label>
        <label>Login <input name="login" required autocomplete="off" /></label>
        <label>Mật khẩu Steam <input name="password" required autocomplete="new-password" /></label>
        <label>Email <input name="email" autocomplete="off" /></label>
        <label>Mật khẩu email <input name="emailPassword" autocomplete="new-password" /></label>
        <label>Ghi chú cho khách <input name="note" placeholder="Hiện cùng thông tin đăng nhập" /></label>
        <label>Ghi chú nội bộ <input name="internalNote" placeholder="Chỉ admin thấy" /></label>
      </div>
      <button type="submit" class="btn">Thêm vào kho</button>
    </form>

    <div class="listbar">
      <input type="search" id="accountsQ" class="listbar-q"
             placeholder="Tìm theo tên tài khoản hoặc email…" />
      <span class="listbar-count" id="accountsCount"></span>
      <span class="listbar-pager">
        <button type="button" class="mini" id="accountsPrev">‹ Trước</button>
        <span id="accountsPage"></span>
        <button type="button" class="mini" id="accountsNext">Sau ›</button>
      </span>
    </div>
    <div class="table-wrap">
      <table class="tbl" id="accountsTable">
        <thead>
          <tr>
            <th>#</th><th>Login</th><th>Nhóm</th><th>Email</th><th>Trạng thái</th>
            <th>Đang thuê</th><th>Ghi chú</th><th class="right">Thao tác</th>
          </tr>
        </thead>
        <tbody id="accountsBody"></tbody>
      </table>
    </div>

    <h2 class="head spaced" id="ordersSection">Đơn hàng</h2>
    <div class="listbar">
      <input type="search" id="ordersQ" class="listbar-q"
             placeholder="Tìm theo mã đơn, email khách hoặc tên tài khoản…" />
      <span class="listbar-count" id="ordersCount"></span>
      <span class="listbar-pager">
        <button type="button" class="mini" id="ordersPrev">‹ Trước</button>
        <span id="ordersPage"></span>
        <button type="button" class="mini" id="ordersNext">Sau ›</button>
      </span>
    </div>
    <div class="table-wrap">
      <table class="tbl" id="ordersTable">
        <thead>
          <tr>
            <th>Mã đơn</th><th>Khách</th><th>Gói</th><th>Số tiền</th>
            <th>Trạng thái</th><th>Tài khoản</th><th>Tạo lúc</th><th>Hết hạn</th>
            <th class="right">Sửa</th>
          </tr>
        </thead>
        <tbody id="ordersBody"></tbody>
      </table>
    </div>

    <!-- Floating section jump. The panel is long enough that Kho tài khoản and Đơn
         hàng are several screens apart, and both are edited in the same sitting. -->
    <nav id="quickNav" class="quicknav" aria-label="Chuyển nhanh">
      <button type="button" id="qnToggle" class="qn-toggle" aria-expanded="true"
              title="Thu gọn / mở rộng">⚡</button>
      <div id="qnLinks" class="qn-links">
        <a href="#reportWrap" data-jump="reportWrap">📊 Báo cáo</a>
        <a href="#reportsWrap" data-jump="reportsWrap">🚨 Báo lỗi</a>
        <a href="#expiringWrap" data-jump="expiringWrap">⏳ Sắp hết hạn</a>
        <a href="#accountsSection" data-jump="accountsSection">🗄️ Tài khoản</a>
        <a href="#ordersSection" data-jump="ordersSection">🧾 Đơn hàng</a>
        <a href="#ownerOnly" data-jump="ownerOnly">👥 Nhóm</a>
      </div>
    </nav>

    <section id="ownerOnly" hidden>
      <h2 class="head">Nhóm tài khoản</h2>
      <form id="groupForm" class="card form">
        <p class="form-title">Thêm nhóm</p>
        <div class="grid">
          <label>Tên nhóm <input name="name" required autocomplete="off" placeholder="Kho A" /></label>
          <label>Ghi chú <input name="note" autocomplete="off" placeholder="Nhà cung cấp, lô hàng…" /></label>
        </div>
        <button type="submit" class="btn">Thêm nhóm</button>
      </form>
      <div class="table-wrap">
        <table class="tbl">
          <thead><tr><th>#</th><th>Tên</th><th>Ghi chú</th><th>Số tài khoản</th><th class="right">Thao tác</th></tr></thead>
          <tbody id="groupsBody"></tbody>
        </table>
      </div>

      <h2 class="head spaced">Quản trị viên</h2>
      <form id="managerForm" class="card form">
        <p class="form-title">Thêm / cập nhật quản trị viên</p>
        <div class="grid">
          <label>Email hoặc provider:sub
            <input name="identity" required autocomplete="off" placeholder="an@shop.vn" />
          </label>
          <label>Tên gợi nhớ <input name="label" autocomplete="off" placeholder="An — kho A" /></label>
        </div>
        <p class="form-title">Nhóm được quản lý</p>
        <div id="managerGroupPicks" class="picks"></div>
        <button type="submit" class="btn">Lưu quản trị viên</button>
      </form>
      <div class="table-wrap">
        <table class="tbl">
          <thead><tr><th>#</th><th>Danh tính</th><th>Tên</th><th>Nhóm</th><th class="right">Thao tác</th></tr></thead>
          <tbody id="managersBody"></tbody>
        </table>
      </div>
    </section>

  </section>
</Layout>

<!-- Admin runs on a light dashboard theme: dense tabular data is far easier to
     scan on light-on-dark's opposite. These overrides are global because the
     shell (body, header) comes from global.css — but this <style> only ships in
     admin.html, so the shop's dark theme is untouched. -->
<style is:global>
  :root {
    --ad-bg: #eef1f6;
    --ad-surface: #ffffff;
    --ad-line: #d9dfe8;
    --ad-line-soft: #eaeef4;
    --ad-text: #1f2733;
    --ad-text-dim: #5b6676;
    --ad-text-mute: #8b96a5;
    --ad-accent: #2563c9;
    --ad-accent-soft: #e8f0fd;
    --ad-green: #1f7a45;
    --ad-green-soft: #e4f4ea;
    --ad-amber: #9a6206;
    --ad-amber-soft: #fdf0d9;
    --ad-red: #b3261e;
    --ad-red-soft: #fbe6e5;
  }

  html, body {
    background: var(--ad-bg);
    color: var(--ad-text);
  }

  /* The shop's vignette + scanline overlay would only muddy a data view. */
  body { background-image: none; }
  body::before { display: none; }

  .wrap { max-width: 1240px; padding: 28px 20px 80px; }

  /* Header: keep the logo, drop the gold-on-black treatment. */
  header { padding: 8px 0 22px; }
  header h1 { color: var(--ad-text); text-shadow: none; }
  header .brand-fun { color: var(--ad-text); }
  header .brand-gaming { color: var(--ad-text-mute); }
  header .tagline { color: var(--ad-text-dim); }
  header .tagline-vi { color: var(--ad-text-mute); }
  header .brand-logo { filter: none; }

  #toTop { background: var(--ad-surface); color: var(--ad-text); border-color: var(--ad-line); }
</style>

<style>
  .state {
    text-align: center;
    padding: 60px 20px;
    color: var(--ad-text-dim);
    font-size: 14px;
  }

  .denied-title {
    font-size: 20px;
    font-weight: 600;
    color: var(--ad-text);
    margin-bottom: 10px;
  }

  .denied-body { font-size: 13px; color: var(--ad-text-mute); margin-bottom: 22px; line-height: 1.7; }

  .admin-bar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 18px;
    margin-bottom: 18px;
    background: var(--ad-surface);
    border: 1px solid var(--ad-line);
    border-radius: 8px;
    box-shadow: 0 1px 2px rgba(23, 34, 51, 0.05);
  }

  .admin-who { flex: 1; font-size: 13px; color: var(--ad-text-dim); }

  .notice {
    padding: 12px 16px;
    margin-bottom: 18px;
    font-size: 13px;
    line-height: 1.6;
    border: 1px solid #bfd4f5;
    border-radius: 8px;
    background: var(--ad-accent-soft);
    color: #16407f;
  }

  .notice.error { border-color: #f0c2bf; background: var(--ad-red-soft); color: var(--ad-red); }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 12px;
    margin-bottom: 32px;
  }

  .stats :global(.stat-box) {
    padding: 16px 12px;
    text-align: center;
    background: var(--ad-surface);
    border: 1px solid var(--ad-line);
    border-radius: 8px;
    box-shadow: 0 1px 2px rgba(23, 34, 51, 0.05);
  }

  .stats :global(.stat-box b) {
    display: block;
    font-size: 24px;
    font-weight: 700;
    color: var(--ad-text);
    margin-bottom: 4px;
  }

  .stats :global(.stat-box span) {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ad-text-mute);
  }

  .head {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--ad-text);
    margin-bottom: 14px;
  }

  .head.spaced { margin-top: 44px; }

  .card {
    padding: 20px;
    margin-bottom: 22px;
    background: var(--ad-surface);
    border: 1px solid var(--ad-line);
    border-radius: 8px;
    box-shadow: 0 1px 2px rgba(23, 34, 51, 0.05);
  }

  .form-title {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ad-accent);
    margin-bottom: 16px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 14px;
    margin-bottom: 18px;
  }

  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ad-text-mute);
  }

  input, select {
    padding: 10px 12px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ad-text);
    background: var(--ad-surface);
    border: 1px solid var(--ad-line);
    border-radius: 6px;
  }

  input::placeholder { color: var(--ad-text-mute); }

  input:focus, select:focus {
    outline: none;
    border-color: var(--ad-accent);
    box-shadow: 0 0 0 3px rgba(37, 99, 201, 0.15);
  }

  .soon { border-left: 3px solid var(--ad-amber); }

  /* Red, not amber: an expiry is scheduled, a report is somebody stuck now. */
  .listbar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin-bottom: 10px;
  }

  .listbar-q {
    flex: 1 1 260px;
    min-width: 220px;
    padding: 7px 10px;
    font: inherit;
    font-size: 13px;
    border: 1px solid var(--ad-line);
    border-radius: 4px;
  }

  .listbar-count { font-size: 12px; color: var(--ad-text-mute); }

  .listbar-pager {
    display: flex;
    gap: 6px;
    align-items: center;
    margin-left: auto;
    font-size: 12px;
    color: var(--ad-text-dim);
  }

  .daily { border-left: 3px solid var(--ad-accent); }

  .report-totals {
    margin: 4px 0 8px;
    font-size: 18px;
    font-weight: 600;
    color: var(--ad-text);
  }

  .report-warn {
    margin: 0 0 12px;
    padding: 9px 12px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--ad-red);
    background: var(--ad-red-soft);
    border-radius: 4px;
  }

  .report-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  @media (max-width: 720px) {
    .report-cols { grid-template-columns: 1fr; }
  }

  .daily :global(.urgent) { color: var(--ad-red); font-weight: 600; }

  .reports { border-left: 3px solid var(--ad-red); }

  /* Inline order editor. Built in JS, hence :global() on its innards. */
  .card :global(tr.order-editor) > td { background: var(--ad-accent-soft); }

  .card :global(.oe-form) {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: end;
    padding: 6px 2px;
  }

  .card :global(.oe-form label) {
    display: grid;
    gap: 4px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ad-text-mute);
  }

  .card :global(.oe-form select),
  .card :global(.oe-form input) {
    min-width: 160px;
    padding: 6px 8px;
    font: inherit;
    font-size: 13px;
  }

  /* Rows and cells are built in JS, hence :global(). */
  .reports :global(td) { vertical-align: top; }
  .reports :global(.urgent) { color: var(--ad-red); font-weight: 600; }
  .reports :global(tr.urgent-row) { background: var(--ad-red-soft); }
  .reports :global(.mini) { margin-right: 6px; }

  .soon-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .soon-window {
    margin-left: auto;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    text-transform: none;
    letter-spacing: 0;
    font-size: 13px;
    color: var(--ad-text-dim);
  }

  .soon-note {
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--ad-text-dim);
  }

  /* Rows are built by the script, hence :global. */
  .soon :global(.left-badge) {
    display: inline-block;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
    border-radius: 999px;
    white-space: nowrap;
    background: var(--ad-amber-soft);
    color: var(--ad-amber);
  }

  /* Under an hour is the one that needs attention now. */
  .soon :global(.left-badge.urgent) { background: var(--ad-red-soft); color: var(--ad-red); }

  .picks {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-bottom: 18px;
  }

  .picks :global(.pick) {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ad-text);
  }

  .picks :global(input[type="checkbox"]) { width: 16px; height: 16px; }

  .table-wrap { overflow-x: auto; margin-bottom: 10px; }

  .soon { border-left: 3px solid var(--ad-amber); }

  .soon-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }

  .soon-window {
    margin-left: auto;
    flex-direction: row;
    align-items: center;
    gap: 8px;
    text-transform: none;
    letter-spacing: 0;
    font-size: 13px;
    color: var(--ad-text-dim);
  }

  .soon-note {
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--ad-text-dim);
  }

  /* Rows are built by the script, hence :global. */
  .soon :global(.left-badge) {
    display: inline-block;
    padding: 3px 10px;
    font-size: 12px;
    font-weight: 600;
    border-radius: 999px;
    white-space: nowrap;
    background: var(--ad-amber-soft);
    color: var(--ad-amber);
  }

  /* Under an hour is the one that needs attention now. */
  .soon :global(.left-badge.urgent) { background: var(--ad-red-soft); color: var(--ad-red); }

  .picks {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-bottom: 18px;
  }

  .picks :global(.pick) {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ad-text);
  }

  .picks :global(input[type="checkbox"]) { width: 16px; height: 16px; }

  .table-wrap {
    background: var(--ad-surface);
    border: 1px solid var(--ad-line);
    border-radius: 8px;
    box-shadow: 0 1px 2px rgba(23, 34, 51, 0.05);
  }

  .tbl { width: 100%; border-collapse: collapse; font-size: 13.5px; }

  .tbl :global(tbody tr:nth-child(even)) { background: #fafbfd; }
  .tbl :global(tbody tr:hover) { background: var(--ad-accent-soft); }
  .tbl :global(tbody tr:last-child td) { border-bottom: none; }

  .tbl th {
    padding: 12px 14px;
    background: #f4f6fa;
    text-align: left;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ad-text-mute);
    border-bottom: 1px solid var(--ad-line);
    white-space: nowrap;
  }

  .tbl :global(td) {
    padding: 12px 14px;
    border-bottom: 1px solid var(--ad-line-soft);
    color: var(--ad-text);
    vertical-align: middle;
  }

  .tbl :global(td.right), .tbl th.right { text-align: right; white-space: nowrap; }

  .tbl :global(code) {
    font-family: 'Courier New', monospace;
    font-size: 13px;
    color: var(--ad-text);
  }

  .tbl :global(.pill) {
    display: inline-block;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    border-radius: 999px;
    white-space: nowrap;
    background: var(--ad-line-soft);
    color: var(--ad-text-dim);
    border: none;
    text-transform: none;
  }

  /* Green = sellable, amber = out with a customer, grey = parked,
     red = needs a human. */
  .tbl :global(.pill.available) { background: var(--ad-green-soft); color: var(--ad-green); }
  /* Created in JS, so it needs :global() — Astro's scoping attribute is not on it. */
  /* ─── Floating section jump ─────────────────── */

  .quicknav {
    position: fixed;
    /* Sits above the global #toTop button (Layout.astro: right/bottom 24px, 44px
       tall, z-index 50) instead of underneath it — right edges aligned so the two
       read as one stack. */
    right: 24px;
    bottom: 80px;
    z-index: 40;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
  }

  .qn-toggle {
    width: 40px;
    height: 40px;
    font-size: 17px;
    line-height: 1;
    color: var(--ad-accent);
    background: var(--ad-card);
    border: 1px solid var(--ad-line);
    border-radius: 50%;
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.16);
    cursor: pointer;
  }

  .qn-toggle:hover { border-color: var(--ad-accent); }

  .qn-links {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
    padding: 6px;
    background: var(--ad-card);
    border: 1px solid var(--ad-line);
    border-radius: 8px;
    box-shadow: 0 6px 20px rgba(15, 23, 42, 0.14);
  }

  .qn-links[hidden] { display: none; }

  .qn-links a,
  .qn-links button {
    padding: 7px 12px;
    font: inherit;
    font-size: 12.5px;
    text-align: left;
    white-space: nowrap;
    color: var(--ad-text);
    background: none;
    border: 0;
    border-radius: 5px;
    text-decoration: none;
    cursor: pointer;
  }

  .qn-links a:hover,
  .qn-links button:hover {
    background: var(--ad-accent-soft);
    color: var(--ad-accent);
  }

  .qn-links a[hidden] { display: none; }

  /* The dock would cover the pager controls on a phone, where the page is one
     column and every row is already full width. */
  @media (max-width: 640px) {
    .quicknav { right: 16px; bottom: 74px; }
    .qn-links a, .qn-links button { padding: 9px 12px; }
  }

  .tbl :global(.field-hint) {
    display: block;
    margin-top: 3px;
    font-size: 11px;
    font-weight: 400;
    color: var(--ad-text-mute);
  }

  .tbl :global(.reserved-for) {
    margin-top: 2px;
    font-size: 11.5px;
    color: #5b32b8;
  }

  .tbl :global(.pill.active)    { background: var(--ad-green-soft); color: var(--ad-green); }
  .tbl :global(.pill.rented)    { background: var(--ad-amber-soft); color: var(--ad-amber); }
  .tbl :global(.pill.pending)   { background: var(--ad-accent-soft); color: var(--ad-accent); }
  .tbl :global(.pill.sold)      { background: #ede9fe; color: #5b32b8; }
  .tbl :global(.pill.disabled)  { background: var(--ad-line-soft); color: var(--ad-text-mute); }
  .tbl :global(.pill.expired)   { background: var(--ad-line-soft); color: var(--ad-text-mute); }
  .tbl :global(.pill.cancelled) { background: var(--ad-line-soft); color: var(--ad-text-mute); }
  .tbl :global(.pill.payment_expired) { background: var(--ad-line-soft); color: var(--ad-text-mute); }
  .tbl :global(.pill.extended)  { background: var(--ad-accent-soft); color: var(--ad-accent); }
  .tbl :global(.pill.awaiting_stock) { background: var(--ad-red-soft); color: var(--ad-red); }
  .tbl :global(.pill.error)     { background: var(--ad-red-soft); color: var(--ad-red); }

  /* ─── buttons ──────────────────────────────── */
  .btn {
    display: inline-block;
    padding: 10px 18px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    color: #fff;
    background: var(--ad-accent);
    border: 1px solid var(--ad-accent);
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .btn:hover { background: #1d54ab; }

  .btn.ghost {
    color: var(--ad-text-dim);
    background: var(--ad-surface);
    border-color: var(--ad-line);
  }

  .btn.ghost:hover { background: #f4f6fa; color: var(--ad-text); }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }

  /* Row actions are created by the script, hence :global. */
  .tbl :global(.mini) {
    padding: 6px 11px;
    margin-left: 6px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 500;
    color: var(--ad-text-dim);
    background: var(--ad-surface);
    border: 1px solid var(--ad-line);
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .muted, .tbl :global(.muted) { color: var(--ad-text-mute); font-size: 13px; }

  .tbl :global(tr.edit-row td) {
    background: var(--ad-bg);
    padding: 18px 14px;
  }

  .tbl :global(.edit-form .grid) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 14px;
    margin-bottom: 16px;
  }

  .tbl :global(.edit-form label) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ad-text-mute);
  }

  .tbl :global(tr.edit-row) { background: #f4f6fa !important; }

  .tbl :global(.edit-form input),
  .tbl :global(.edit-form select) {
    padding: 9px 11px;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ad-text);
    background: var(--ad-surface);
    border: 1px solid var(--ad-line);
    border-radius: 6px;
  }

  .tbl :global(.edit-form input:focus),
  .tbl :global(.edit-form select:focus) {
    outline: none;
    border-color: var(--ad-accent);
  }

  .tbl :global(.edit-actions) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .tbl :global(.edit-actions .btn) {
    display: inline-block;
    padding: 9px 18px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    background: var(--ad-accent);
    border: 1px solid var(--ad-accent);
    border-radius: 6px;
    cursor: pointer;
  }

  .tbl :global(.edit-actions .btn.ghost) {
    color: var(--ad-text-dim);
    background: var(--ad-surface);
    border-color: var(--ad-line);
  }
  .tbl :global(.edit-actions .btn:disabled) { opacity: 0.5; cursor: not-allowed; }

  .tbl :global(.edit-hint) { font-size: 11px; color: var(--ad-text-mute); }

  .tbl :global(.mini:disabled) { opacity: 0.45; cursor: default; }

  .tbl :global(.mini:hover:not(:disabled)) { border-color: var(--ad-accent); color: var(--ad-accent); }
  .tbl :global(.mini.danger) { color: var(--ad-red); }
  .tbl :global(.mini.danger:hover) { border-color: var(--ad-red); background: var(--ad-red-soft); }

  .tbl :global(.muted), .muted { color: var(--ad-text-mute); font-size: 12px; }
</style>

<script>
  const el = (id) => document.getElementById(id);
  const fmtVnd = (n) => new Intl.NumberFormat('vi-VN').format(n || 0) + '₫';
  const fmtTime = (s) => (s ? new Date(s * 1000).toLocaleString('vi-VN') : '—');

  function notice(message, isError) {
    const box = el('adminNotice');
    box.textContent = message;
    box.classList.toggle('error', Boolean(isError));
    box.hidden = false;
  }

  async function api(path, options = {}) {
    const res = await fetch('/api/admin/' + path, {
      credentials: 'same-origin',
      headers: options.body ? { 'content-type': 'application/json' } : undefined,
      ...options,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw Object.assign(new Error(data.error || String(res.status)), { data });
    return data;
  }

  let IS_OWNER = false;
  let GROUPS = [];

  const a_groupId = (account) => (account.groupId == null ? null : Number(account.groupId));

  /* ─── rendering ──────────────────────────────── */

  function cell(row, text, cls) {
    const td = document.createElement('td');
    if (cls) td.className = cls;
    if (text instanceof Node) td.appendChild(text);
    else td.textContent = text ?? '—';
    row.appendChild(td);
    return td;
  }

  function pill(text, kind) {
    const span = document.createElement('span');
    span.className = 'pill ' + (kind || '');
    span.textContent = text;
    return span;
  }

  function renderStats(s) {
    const items = [
      [s.accounts, 'Tài khoản'],
      [s.available, 'Còn trống'],
      [s.rented, 'Đang thuê'],
      [s.sold, 'Đã bán'],
      [s.disabled, 'Tạm khoá'],
      [s.activeRentals, 'Đơn đang chạy'],
      [s.expiringSoon, 'Sắp hết hạn (24h)'],
      [s.openReports, 'Khách báo lỗi'],
      [s.awaitingStock, 'Chờ xử lý'],
      [fmtVnd(s.revenue), 'Doanh thu'],
    ];
    const box = el('stats');
    box.textContent = '';
    for (const [value, label] of items) {
      const d = document.createElement('div');
      d.className = 'stat-box';
      const b = document.createElement('b');
      b.textContent = String(value ?? 0);
      const sp = document.createElement('span');
      sp.textContent = label;
      d.append(b, sp);
      box.appendChild(d);
    }
  }

  function renderAccounts(accounts) {
    const body = el('accountsBody');
    body.textContent = '';
    if (!accounts.length) {
      const tr = document.createElement('tr');
      const td = cell(tr, 'Kho trống — thêm tài khoản ở trên.');
      td.colSpan = 8;
      td.className = 'muted';
      body.appendChild(tr);
      return;
    }

    for (const a of accounts) {
      const tr = document.createElement('tr');
      cell(tr, String(a.id));

      const login = document.createElement('code');
      login.textContent = a.login;
      cell(tr, login);

      cell(tr, a.groupName || '— chưa phân nhóm —');
      cell(tr, a.email || '—');
      cell(tr, pill(a.status, a.status));
      const holder = document.createElement('div');
      if (a.rental) {
        const line = document.createElement('div');
        // userEmail is null for providers that give none; userKey always exists.
        line.textContent = `${a.rental.userEmail || a.rental.userKey} · đến ${fmtTime(a.rental.expiresAt)}`;
        holder.appendChild(line);
      }
      if (a.reservedFor) {
        // Shown whether or not it is rented right now: the hold outlives the rental,
        // which is the whole point of it.
        const held = document.createElement('div');
        held.className = 'reserved-for';
        held.textContent = '🔒 giữ cho ' + a.reservedFor;
        holder.appendChild(held);
      }
      if (!a.rental && !a.reservedFor) holder.textContent = '—';
      cell(tr, holder);
      cell(tr, [a.note, a.internalNote && '(' + a.internalNote + ')'].filter(Boolean).join(' ') || '—');

      const actions = document.createElement('td');
      actions.className = 'right';

      const reveal = document.createElement('button');
      reveal.className = 'mini';
      reveal.textContent = 'Xem mật khẩu';
      reveal.addEventListener('click', () => revealAccount(a, actions, reveal));
      actions.appendChild(reveal);

      const edit = document.createElement('button');
      edit.className = 'mini';
      edit.textContent = 'Sửa';
      edit.addEventListener('click', () => editAccount(a, tr));
      actions.appendChild(edit);

      const del = document.createElement('button');
      del.className = 'mini danger';
      del.textContent = 'Xoá';
      del.addEventListener('click', () => removeAccount(a));
      actions.appendChild(del);

      tr.appendChild(actions);
      body.appendChild(tr);
    }
  }

  function renderOrders(orders) {
    const body = el('ordersBody');
    body.textContent = '';
    if (!orders.length) {
      const tr = document.createElement('tr');
      const td = cell(tr, 'Chưa có đơn nào.');
      td.colSpan = 9;
      td.className = 'muted';
      body.appendChild(tr);
      return;
    }
    for (const o of orders) {
      const tr = document.createElement('tr');
      const code = document.createElement('code');
      code.textContent = String(o.orderCode);
      cell(tr, code);
      cell(tr, o.userEmail || o.userKey);
      cell(tr, `${o.planId} (${o.hours}h)` + (o.extendsOrder ? ` · gia hạn #${o.extendsOrder}` : ''));
      cell(tr, fmtVnd(o.amount));
      cell(tr, pill(o.status, o.status));
      cell(tr, o.accountLogin || '—');
      cell(tr, fmtTime(o.createdAt));
      cell(tr, fmtTime(o.expiresAt));

      const actions = document.createElement('td');
      actions.className = 'right';
      const edit = document.createElement('button');
      edit.type = 'button';
      edit.className = 'mini';
      edit.textContent = 'Sửa';
      edit.addEventListener('click', () => {
        openOrderEditor(o, tr).catch((err) =>
          notice('Không mở được trình sửa đơn: ' + err.message, true));
      });
      actions.appendChild(edit);
      tr.appendChild(actions);

      body.appendChild(tr);
    }
  }

  /**
   * Inline editor for one order: set its status and/or move it onto a specific
   * account. Exists for the three states nothing else could fix — paid with no
   * stock, sitting on an account that turned out to be banned, and orders whose
   * account was never released.
   */
  async function openOrderEditor(order, afterRow) {
    // One editor at a time, or two open rows can disagree about the same account.
    document.querySelectorAll('tr.order-editor').forEach((r) => r.remove());

    const tr = document.createElement('tr');
    tr.className = 'order-editor';
    const td = document.createElement('td');
    td.colSpan = 9;

    const form = document.createElement('div');
    form.className = 'oe-form';

    const statusLabel = document.createElement('label');
    statusLabel.textContent = 'Trạng thái';
    const status = document.createElement('select');
    for (const value of ['active', 'expired', 'cancelled', 'awaiting_stock']) {
      const opt = document.createElement('option');
      opt.value = value;
      opt.textContent = value;
      if (value === order.status) opt.selected = true;
      status.appendChild(opt);
    }
    statusLabel.appendChild(status);

    const acctLabel = document.createElement('label');
    acctLabel.textContent = 'Tài khoản';
    const account = document.createElement('select');
    const keep = document.createElement('option');
    keep.value = '';
    keep.textContent = order.accountLogin ? `— giữ ${order.accountLogin} —` : '— chưa gán —';
    account.appendChild(keep);
    // Fetched rather than read from the rendered page: the table now shows one page
    // at a time, and an assignable account can sit on any of them. The pool is small
    // (a handful at a time), so one request is cheaper than paging to find them.
    let assignable = [];
    try {
      assignable = (await api('accounts?status=available&limit=200')).accounts || [];
    } catch (err) {
      notice('Không tải được danh sách tài khoản trống: ' + err.message, true);
    }
    for (const a of assignable) {
      const opt = document.createElement('option');
      opt.value = String(a.id);
      opt.textContent = a.login + (a.banState === 'banned' ? '  ⚠ BANNED' : '');
      account.appendChild(opt);
    }
    acctLabel.appendChild(account);

    const hoursLabel = document.createElement('label');
    hoursLabel.textContent = 'Giờ (khi kích hoạt lại)';
    const hours = document.createElement('input');
    hours.type = 'number';
    hours.min = '1';
    hours.value = String(order.hours || 24);
    hoursLabel.appendChild(hours);

    // Extending a running rental is a different operation from setting the length
    // of a reactivation, so it gets its own field rather than overloading the one
    // above — which the server only reads when an order becomes active.
    const canExtend = order.status === 'active' && order.expiresAt != null;
    const addLabel = document.createElement('label');
    addLabel.textContent = 'Cộng thêm giờ';
    const addHours = document.createElement('input');
    addHours.type = 'number';
    addHours.min = '1';
    addHours.placeholder = canExtend ? 'vd 24 — cộng vào hạn hiện tại' : '—';
    addHours.disabled = !canExtend;
    addLabel.appendChild(addHours);
    if (!canExtend) {
      const why = document.createElement('span');
      why.className = 'field-hint';
      why.textContent = order.expiresAt == null && order.status === 'active'
        ? 'Đơn mua — không có thời hạn để cộng.'
        : 'Chỉ cộng được cho đơn đang thuê.';
      addLabel.appendChild(why);
    }

    const save = document.createElement('button');
    save.type = 'button';
    save.className = 'primary';
    save.textContent = 'Lưu';

    const cancel = document.createElement('button');
    cancel.type = 'button';
    cancel.className = 'mini';
    cancel.textContent = 'Đóng';
    cancel.addEventListener('click', () => tr.remove());

    save.addEventListener('click', async () => {
      save.disabled = true;
      const payload = { hours: Number(hours.value) || order.hours };
      if (status.value !== order.status) payload.status = status.value;
      if (account.value) payload.accountId = Number(account.value);
      const extra = Number(addHours.value);
      if (extra > 0) payload.addHours = extra;
      // `hours` rides along on every save but only takes effect on a
      // reactivation, so it must not count as a change on its own — otherwise
      // every "Lưu" would look like an edit. addHours does count.
      if (payload.status === undefined && payload.accountId === undefined && payload.addHours === undefined) {
        notice('Chưa có gì thay đổi.', true);
        save.disabled = false;
        return;
      }
      try {
        await api('orders/' + order.orderCode, { method: 'PATCH', body: JSON.stringify(payload) });
        tr.remove();
        // Both lists: assigning an account changes its status too.
        await Promise.all([loadOrdersPage(), loadAccountsPage(), loadSummary()]);
      } catch (err) {
        // A refused ban assignment is the one worth offering to override, and only
        // after the operator has been told why.
        if (err.data?.error === 'account_banned') {
          if (confirmBanned(err.data.login)) {
            try {
              await api('orders/' + order.orderCode, {
                method: 'PATCH',
                body: JSON.stringify({ ...payload, force: true }),
              });
              tr.remove();
              await Promise.all([loadOrdersPage(), loadAccountsPage(), loadSummary()]);
              return;
            } catch (err2) {
              notice('Vẫn không gán được: ' + err2.message, true);
            }
          }
        } else {
          notice(orderPatchError(err), true);
        }
        save.disabled = false;
      }
    });

    form.append(statusLabel, acctLabel, hoursLabel, save, cancel);
    td.appendChild(form);
    tr.appendChild(td);
    afterRow.insertAdjacentElement('afterend', tr);
    status.focus();
  }

  function confirmBanned(login) {
    return window.confirm(
      `Tài khoản ${login} đã bị ban/khoá. Khách sẽ KHÔNG đăng nhập được.\n\n` +
        'Vẫn gán tài khoản này?'
    );
  }

  function orderPatchError(err) {
    const map = {
      needs_account: 'Phải gán tài khoản trước khi chuyển sang active.',
      account_unavailable: 'Tài khoản đó đang được thuê hoặc không còn trống.',
      wrong_game: 'Tài khoản đó thuộc game khác.',
      forbidden: 'Bạn không quản lý tài khoản/đơn này.',
      nothing_to_do: 'Chưa có gì thay đổi.',
      unknown_account: 'Không tìm thấy tài khoản.',
      unknown_order: 'Không tìm thấy đơn.',
    };
    return 'Sửa đơn thất bại: ' + (map[err.data?.error] || err.message);
  }


  function fillGroupSelect(select) {
    if (!select) return;
    const current = select.value;
    select.textContent = '';
    if (IS_OWNER) {
      const none = document.createElement('option');
      none.value = '';
      none.textContent = '— chưa phân nhóm —';
      select.appendChild(none);
    }
    for (const g of GROUPS) {
      const option = document.createElement('option');
      option.value = String(g.id);
      option.textContent = g.name;
      select.appendChild(option);
    }
    select.value = current;
  }

  function humanLeft(seconds) {
    if (seconds <= 0) return 'hết hạn';
    const d = Math.floor(seconds / 86400);
    const h = Math.floor((seconds % 86400) / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    if (d > 0) return `${d} ngày ${h} giờ`;
    if (h > 0) return `${h} giờ ${String(m).padStart(2, '0')} phút`;
    return `${m} phút`;
  }

  function renderExpiring(rows, hours) {
    const wrap = el('expiringWrap');
    const body = el('expiringBody');
    body.textContent = '';

    // Hide the whole block when there is nothing to act on, rather than showing
    // an empty table that reads like a problem.
    if (!rows.length) {
      wrap.hidden = true;
      return;
    }
    wrap.hidden = false;

    const nowSec = Math.floor(Date.now() / 1000);
    for (const r of rows) {
      const tr = document.createElement('tr');
      const left = r.expiresAt - nowSec;
      const badge = document.createElement('span');
      badge.className = 'left-badge' + (left <= 3600 ? ' urgent' : '');
      badge.textContent = humanLeft(left);
      cell(tr, badge);

      const login = document.createElement('code');
      login.textContent = r.accountLogin;
      cell(tr, login);

      cell(tr, r.groupName || '—');
      cell(tr, r.userEmail || r.userKey);
      cell(tr, `${r.planId} (${r.rentedHours}h)`);
      cell(tr, fmtTime(r.expiresAt));
      const code = document.createElement('code');
      code.textContent = String(r.orderCode);
      cell(tr, code);
      body.appendChild(tr);
    }
  }

  async function loadExpiring() {
    const hours = el('expiringHours')?.value || 24;
    try {
      const data = await api('expiring?hours=' + hours);
      renderExpiring(data.expiring, data.hours);
    } catch {
      el('expiringWrap').hidden = true;
    }
  }

  el('expiringHours')?.addEventListener('change', loadExpiring);

  function renderReports(reports, telegram) {
    const wrap = el('reportsWrap');
    const body = el('reportsBody');
    if (!wrap || !body) return;
    body.textContent = '';

    // Hidden entirely when there is nothing to answer — an empty complaints table
    // reads like a problem of its own.
    if (!reports.length && !el('reportsAll')?.checked) {
      wrap.hidden = true;
      return;
    }
    wrap.hidden = false;

    const tg = el('reportsTelegram');
    if (tg) {
      tg.hidden = telegram;
      tg.textContent = telegram
        ? ''
        : 'Telegram chưa cấu hình đúng nên báo lỗi không được đẩy tới bạn — danh sách này là nguồn duy nhất.';
    }

    if (!reports.length) {
      const tr = document.createElement('tr');
      const td = cell(tr, 'Không có báo lỗi nào.');
      td.colSpan = 7;
      body.appendChild(tr);
      return;
    }

    for (const r of reports) {
      const tr = document.createElement('tr');
      if (r.status === 'open' && r.urgent) tr.className = 'urgent-row';
      cell(tr, fmtTime(r.createdAt));

      const reason = cell(tr, (r.urgent ? '🚨 ' : '') + r.reasonLabel);
      if (r.urgent) reason.className = 'urgent';

      cell(tr, r.accountLogin || ('#' + (r.accountId ?? '?')));
      cell(tr, r.userEmail || r.userKey);
      cell(tr, r.message || '—');
      cell(tr, String(r.orderCode));

      const actions = document.createElement('td');
      if (r.status === 'open') {
        // An intruder report means the previous holder still knows the password,
        // so the remedy is offered right here rather than left to be remembered.
        if (r.urgent && r.accountLogin) {
          const rotate = document.createElement('button');
          rotate.type = 'button';
          rotate.className = 'mini';
          rotate.textContent = 'Copy lệnh đổi pass';
          rotate.addEventListener('click', async () => {
            const cmd = `python scripts/steam_change_password.py --db --remote --account ${r.accountLogin}`;
            try {
              await navigator.clipboard.writeText(cmd);
              rotate.textContent = 'Đã copy';
              setTimeout(() => (rotate.textContent = 'Copy lệnh đổi pass'), 1500);
            } catch {
              rotate.textContent = 'Lỗi copy';
            }
          });
          actions.appendChild(rotate);
        }
        const done = document.createElement('button');
        done.type = 'button';
        done.className = 'mini';
        done.textContent = 'Đã xử lý';
        done.addEventListener('click', async () => {
          done.disabled = true;
          try {
            await api('reports/resolve', {
              method: 'POST',
              body: JSON.stringify({ id: r.id }),
            });
            await Promise.all([loadReports(), loadSummary()]);
          } catch (err) {
            done.disabled = false;
            notice('Không xử lý được báo lỗi: ' + err.message, true);
          }
        });
        actions.appendChild(done);
      } else {
        actions.textContent = 'đã xử lý' + (r.resolvedBy ? ' · ' + r.resolvedBy : '');
      }
      tr.appendChild(actions);
      body.appendChild(tr);
    }
  }

  async function loadReports() {
    try {
      const all = el('reportsAll')?.checked ? '?all=1' : '';
      const data = await api('reports' + all);
      renderReports(data.reports || [], data.telegram);
    } catch {
      el('reportsWrap').hidden = true;
    }
  }

  /* ─── paged lists ───────────────────────────────
     The tables outgrew "fetch everything": 102 accounts and 225 orders, both
     climbing. Each list keeps its own page and query so an edit does not throw the
     operator back to page 1 of an unfiltered list. */

  const views = {
    accounts: { page: 1, q: '', limit: 50 },
    orders: { page: 1, q: '', limit: 50 },
  };

  function renderPager(name, meta) {
    const view = views[name];
    // Trust the server's page number: it clamps, so asking for page 9 of 3 lands on
    // 3 and the control must agree with what is actually on screen.
    if (meta) view.page = meta.page;
    const total = meta?.total ?? 0;
    const pages = meta?.pages ?? 1;
    el(`${name}Count`).textContent = view.q
      ? `${total} kết quả cho “${view.q}”`
      : `${total} bản ghi`;
    el(`${name}Page`).textContent = `Trang ${meta?.page ?? 1}/${pages}`;
    el(`${name}Prev`).disabled = (meta?.page ?? 1) <= 1;
    el(`${name}Next`).disabled = (meta?.page ?? 1) >= pages;
  }

  function listQuery(name) {
    const view = views[name];
    const params = new URLSearchParams({ page: String(view.page), limit: String(view.limit) });
    if (view.q) params.set('q', view.q);
    return params.toString();
  }

  async function loadAccountsPage() {
    const data = await api('accounts?' + listQuery('accounts'));
    renderAccounts(data.accounts);
    renderPager('accounts', data.page);
  }

  async function loadOrdersPage() {
    const data = await api('orders?' + listQuery('orders'));
    renderOrders(data.orders);
    renderPager('orders', data.page);
  }

  const LOADERS = { accounts: loadAccountsPage, orders: loadOrdersPage };

  function wireList(name) {
    const input = el(`${name}Q`);
    let timer = null;
    input?.addEventListener('input', () => {
      // Debounced: typing an order code is eight keystrokes, and each one would
      // otherwise be a round trip that could land out of order.
      clearTimeout(timer);
      timer = setTimeout(() => {
        views[name].q = input.value.trim();
        views[name].page = 1; // a new search starts at the beginning
        LOADERS[name]().catch((err) => notice('Tìm kiếm thất bại: ' + err.message, true));
      }, 300);
    });
    el(`${name}Prev`)?.addEventListener('click', () => {
      if (views[name].page > 1) {
        views[name].page -= 1;
        LOADERS[name]().catch((err) => notice('Không tải được trang: ' + err.message, true));
      }
    });
    el(`${name}Next`)?.addEventListener('click', () => {
      views[name].page += 1;
      LOADERS[name]().catch((err) => notice('Không tải được trang: ' + err.message, true));
    });
  }

  wireList('accounts');
  wireList('orders');

  el('reportsAll')?.addEventListener('change', loadReports);

  function renderReport(r) {
    el('reportTotals').textContent =
      `${r.date} · ${r.totals.orders} đơn đã thanh toán · ${fmtVnd(r.totals.revenue)}` +
      (r.scope === 'groups' ? '  (chỉ nhóm của bạn)' : '');

    // Sold-but-unusable and paid-but-undelivered both inflate the revenue figure
    // while being the opposite of a good day, so they are stated next to it.
    const w = r.warnings || {};
    const parts = [];
    if (w.onBannedAccounts) {
      parts.push(
        `${w.onBannedAccounts} đơn trên tài khoản đã bị ban (${fmtVnd(w.onBannedRevenue)})`
      );
    }
    if (w.undelivered) {
      parts.push(`${w.undelivered} đơn đã thu tiền nhưng chưa giao tài khoản (${fmtVnd(w.undeliveredRevenue)})`);
    }
    const warn = el('reportWarn');
    warn.hidden = parts.length === 0;
    warn.textContent = parts.length ? '⚠ ' + parts.join(' · ') : '';

    const fill = (tbody, rows, nameOf) => {
      tbody.textContent = '';
      if (!rows.length) {
        const tr = document.createElement('tr');
        const td = cell(tr, 'Không có đơn nào trong ngày này.');
        td.colSpan = 3;
        td.className = 'muted';
        tbody.appendChild(tr);
        return;
      }
      for (const row of rows) {
        const tr = document.createElement('tr');
        const label = cell(tr, nameOf(row));
        if (row.onBanned) {
          const flag = document.createElement('span');
          flag.className = 'urgent';
          flag.textContent = `  ⚠ ${row.onBanned} bị ban`;
          label.appendChild(flag);
        }
        cell(tr, String(row.orders)).className = 'right';
        cell(tr, fmtVnd(row.revenue)).className = 'right';
        tbody.appendChild(tr);
      }
    };
    fill(el('reportBuckets'), r.buckets || [], (b) => b.label);
    fill(el('reportPlans'), r.plans || [], (p) => p.plan);
  }

  async function loadReport() {
    const date = el('reportDate')?.value;
    try {
      const data = await api('report' + (date ? '?date=' + encodeURIComponent(date) : ''));
      // Reflect the day the server actually reported on, so the picker cannot drift
      // from the numbers beside it.
      if (el('reportDate') && data.date) el('reportDate').value = data.date;
      renderReport(data);
    } catch (err) {
      el('reportTotals').textContent = 'Không tải được báo cáo: ' + err.message;
    }
  }

  el('reportDate')?.addEventListener('change', loadReport);
  el('reportToday')?.addEventListener('click', () => {
    el('reportDate').value = '';
    loadReport();
  });
  el('reportPrev')?.addEventListener('click', () => {
    const input = el('reportDate');
    // Step from the shown day, in date arithmetic that ignores timezones — the
    // server owns the day boundary.
    const base = input.value || new Date().toISOString().slice(0, 10);
    const d = new Date(base + 'T12:00:00Z');
    d.setUTCDate(d.getUTCDate() - 1);
    input.value = d.toISOString().slice(0, 10);
    loadReport();
  });

  function renderGroups(groups) {
    GROUPS = groups;
    fillGroupSelect(el('addGroup'));

    const body = el('groupsBody');
    if (!body) return;
    body.textContent = '';
    if (!groups.length) {
      const tr = document.createElement('tr');
      const td = cell(tr, 'Chưa có nhóm nào — thêm ở trên.');
      td.colSpan = 5;
      td.className = 'muted';
      body.appendChild(tr);
    }
    for (const g of groups) {
      const tr = document.createElement('tr');
      cell(tr, String(g.id));
      cell(tr, g.name);
      cell(tr, g.note || '—');
      cell(tr, String(g.accounts));
      const actions = document.createElement('td');
      actions.className = 'right';
      const del = document.createElement('button');
      del.className = 'mini danger';
      del.textContent = 'Xoá';
      del.addEventListener('click', async () => {
        if (!confirm(`Xoá nhóm "${g.name}"?`)) return;
        try {
          const data = await api('groups/' + g.id, { method: 'DELETE' });
          renderGroups(data.groups);
          notice('Đã xoá nhóm "' + g.name + '".', false);
          loadAll();
        } catch (err) {
          if (err.data?.error === 'group_not_empty') {
            notice(
              'Nhóm còn ' + err.data.accounts + ' tài khoản. Chuyển chúng sang nhóm khác trước khi xoá.',
              true
            );
          } else {
            notice('Xoá nhóm thất bại: ' + err.message, true);
          }
        }
      });
      actions.appendChild(del);
      tr.appendChild(actions);
      body.appendChild(tr);
    }

    // Checkbox list for assigning groups to a manager.
    const picks = el('managerGroupPicks');
    if (picks) {
      picks.textContent = '';
      for (const g of groups) {
        const label = document.createElement('label');
        label.className = 'pick';
        const box = document.createElement('input');
        box.type = 'checkbox';
        box.value = String(g.id);
        box.name = 'group';
        label.append(box, document.createTextNode(' ' + g.name));
        picks.appendChild(label);
      }
    }
  }

  function renderManagers(managers) {
    const body = el('managersBody');
    if (!body) return;
    body.textContent = '';
    if (!managers.length) {
      const tr = document.createElement('tr');
      const td = cell(tr, 'Chưa có quản trị viên nào. Chủ shop luôn truy cập được qua ADMIN_EMAILS.');
      td.colSpan = 5;
      td.className = 'muted';
      body.appendChild(tr);
      return;
    }
    for (const m of managers) {
      const tr = document.createElement('tr');
      cell(tr, String(m.id));
      const id = document.createElement('code');
      id.textContent = m.identity;
      cell(tr, id);
      cell(tr, m.label || '—');
      cell(tr, m.groupNames || '(chưa gán nhóm)');
      const actions = document.createElement('td');
      actions.className = 'right';
      const del = document.createElement('button');
      del.className = 'mini danger';
      del.textContent = 'Xoá';
      del.addEventListener('click', async () => {
        if (!confirm(`Xoá quyền quản trị của "${m.identity}"?`)) return;
        try {
          const data = await api('managers/' + m.id, { method: 'DELETE' });
          renderManagers(data.managers);
          notice('Đã xoá quản trị viên "' + m.identity + '".', false);
        } catch (err) {
          notice('Xoá thất bại: ' + err.message, true);
        }
      });
      actions.appendChild(del);
      tr.appendChild(actions);
      body.appendChild(tr);
    }
  }

  /* ─── actions ────────────────────────────────── */

  async function revealAccount(account, container, button) {
    button.disabled = true;
    try {
      const data = await api('accounts/' + account.id + '/reveal', { method: 'POST' });
      const lines = [
        'Login: ' + data.login,
        'Mật khẩu: ' + data.password,
        data.email ? 'Email: ' + data.email : null,
        data.emailPassword ? 'Mật khẩu email: ' + data.emailPassword : null,
      ].filter(Boolean);
      // Shown inline rather than in a dialog so it can be copied, and it
      // disappears on the next refresh instead of lingering.
      const pre = document.createElement('div');
      pre.className = 'muted';
      pre.style.marginTop = '8px';
      pre.style.textAlign = 'left';
      pre.style.fontFamily = "'Courier New', monospace";
      pre.textContent = lines.join('\n');
      pre.style.whiteSpace = 'pre-wrap';
      container.appendChild(pre);
      // Disable in place rather than remove: removing it shifts "Sửa"/"Xoá"
      // left, so the next click lands on a different action than the one the
      // eye expects — an easy way to delete an account by accident.
      button.textContent = 'Đã hiện';
      button.disabled = true;
    } catch (err) {
      notice('Không đọc được mật khẩu: ' + (err.data?.hint || err.message), true);
      button.disabled = false;
    }
  }

  const EDIT_FIELDS = [
    { name: 'login', label: 'Login', value: (a) => a.login || '' },
    { name: 'email', label: 'Email', value: (a) => a.email || '' },
    { name: 'password', label: 'Mật khẩu Steam', placeholder: 'để trống = giữ nguyên', value: () => '' },
    { name: 'emailPassword', label: 'Mật khẩu email', placeholder: 'để trống = giữ nguyên', value: () => '' },
    { name: 'note', label: 'Ghi chú cho khách', value: (a) => a.note || '' },
    { name: 'internalNote', label: 'Ghi chú nội bộ', value: (a) => a.internalNote || '' },
    {
      name: 'reservedFor',
      label: 'Giữ cho khách (email)',
      placeholder: 'để trống = không giữ',
      value: (a) => a.reservedFor || '',
    },
  ];

  /** Opens an inline editor beneath the row. One at a time. */
  function editAccount(account, row) {
    const existing = document.querySelector('tr.edit-row');
    const wasMine = existing && existing.dataset.for === String(account.id);
    if (existing) existing.remove();
    if (wasMine) return; // clicking "Sửa" again closes it

    const tr = document.createElement('tr');
    tr.className = 'edit-row';
    tr.dataset.for = String(account.id);
    const td = document.createElement('td');
    td.colSpan = 8;

    const form = document.createElement('form');
    form.className = 'edit-form';

    const grid = document.createElement('div');
    grid.className = 'grid';
    for (const field of EDIT_FIELDS) {
      const label = document.createElement('label');
      label.textContent = field.label;
      const input = document.createElement('input');
      input.name = field.name;
      input.value = field.value(account);
      input.autocomplete = 'off';
      if (field.placeholder) input.placeholder = field.placeholder;
      label.appendChild(input);
      grid.appendChild(label);
    }

    // Only groups this actor may use — reassigning into someone else's group is
    // refused server-side anyway.
    const groupLabel = document.createElement('label');
    groupLabel.textContent = 'Nhóm';
    const groupSelect = document.createElement('select');
    groupSelect.name = 'groupId';
    if (IS_OWNER) {
      const none = document.createElement('option');
      none.value = '';
      none.textContent = '— chưa phân nhóm —';
      groupSelect.appendChild(none);
    }
    for (const g of GROUPS) {
      const option = document.createElement('option');
      option.value = String(g.id);
      option.textContent = g.name;
      if (g.id === a_groupId(account)) option.selected = true;
      groupSelect.appendChild(option);
    }
    groupLabel.appendChild(groupSelect);
    grid.appendChild(groupLabel);

    const statusLabel = document.createElement('label');
    statusLabel.textContent = 'Trạng thái';
    const select = document.createElement('select');
    select.name = 'status';
    for (const value of ['available', 'rented', 'sold', 'disabled']) {
      const option = document.createElement('option');
      option.value = value;
      option.textContent = value;
      if (value === account.status) option.selected = true;
      select.appendChild(option);
    }
    statusLabel.appendChild(select);
    grid.appendChild(statusLabel);
    form.appendChild(grid);

    const actions = document.createElement('div');
    actions.className = 'edit-actions';

    const save = document.createElement('button');
    save.type = 'submit';
    save.className = 'btn';
    save.textContent = 'Lưu thay đổi';

    const cancel = document.createElement('button');
    cancel.type = 'button';
    cancel.className = 'btn ghost';
    cancel.textContent = 'Huỷ';
    cancel.addEventListener('click', () => tr.remove());

    const hint = document.createElement('span');
    hint.className = 'edit-hint';
    hint.textContent = 'Ô mật khẩu để trống sẽ giữ nguyên mật khẩu đang lưu.';

    actions.append(save, cancel, hint);
    form.appendChild(actions);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      save.disabled = true;
      const payload = Object.fromEntries(new FormData(form).entries());
      try {
        const data = await api('accounts/' + account.id, {
          method: 'PATCH',
          body: JSON.stringify(payload),
        });
        await loadAccountsPage();
        notice('Đã cập nhật tài khoản #' + account.id + '.', false);
        loadSummary();
      } catch (err) {
        save.disabled = false;
        if (err.data?.error === 'rental_active') {
          notice(
            'Tài khoản đang có đơn thuê #' + err.data.orderCode +
              ' — không thể đổi về "available" khi khách vẫn đang dùng.',
            true
          );
        } else if (err.data?.error === 'duplicate_login') {
          notice('Login này đã thuộc về tài khoản #' + err.data.id + '.', true);
        } else {
          notice('Cập nhật thất bại: ' + err.message, true);
        }
      }
    });

    td.appendChild(form);
    tr.appendChild(td);
    row.insertAdjacentElement('afterend', tr);
    form.querySelector('input')?.focus();
  }

  async function removeAccount(account) {
    if (!confirm(`Xoá tài khoản "${account.login}"? Lịch sử đơn hàng vẫn được giữ.`)) return;
    try {
      const data = await api('accounts/' + account.id, { method: 'DELETE' });
      await loadAccountsPage();
      notice('Đã xoá tài khoản "' + account.login + '".', false);
      loadSummary();
    } catch (err) {
      if (err.data?.error === 'rental_active') {
        // Deleting mid-rental strips the login from a paying customer, so it
        // needs a second, explicit confirmation.
        const ok = confirm(
          'Tài khoản đang được thuê (đơn #' + err.data.orderCode + ', đến ' +
            fmtTime(err.data.expiresAt) + ').\n\nXoá vẫn sẽ khiến khách mất quyền truy cập. Tiếp tục?'
        );
        if (!ok) return;
        try {
          const data = await api('accounts/' + account.id + '?force=1', { method: 'DELETE' });
          await loadAccountsPage();
          notice('Đã xoá tài khoản đang thuê "' + account.login + '".', true);
          loadSummary();
        } catch (e2) {
          notice('Xoá thất bại: ' + e2.message, true);
        }
        return;
      }
      notice('Xoá thất bại: ' + err.message, true);
    }
  }

  el('addForm').addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.target;
    const payload = Object.fromEntries(new FormData(form).entries());
    const submit = form.querySelector('button[type="submit"]');
    submit.disabled = true;
    try {
      const data = await api('accounts', { method: 'POST', body: JSON.stringify(payload) });
      await loadAccountsPage();
      notice('Đã thêm "' + payload.login + '" vào kho.', false);
      form.reset();
      loadSummary();
    } catch (err) {
      const map = {
        duplicate_login: 'Login này đã có trong kho.',
        login_required: 'Thiếu login.',
        password_required: 'Thiếu mật khẩu Steam.',
      };
      notice(map[err.data?.error] || 'Thêm thất bại: ' + err.message, true);
    } finally {
      submit.disabled = false;
    }
  });

  el('groupForm')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.target;
    const submit = form.querySelector('button[type="submit"]');
    submit.disabled = true;
    try {
      const data = await api('groups', {
        method: 'POST',
        body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
      });
      renderGroups(data.groups);
      notice('Đã thêm nhóm.', false);
      form.reset();
    } catch (err) {
      notice(err.data?.error === 'duplicate_group' ? 'Tên nhóm này đã tồn tại.' : 'Thêm nhóm thất bại: ' + err.message, true);
    } finally {
      submit.disabled = false;
    }
  });

  el('managerForm')?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const form = event.target;
    const submit = form.querySelector('button[type="submit"]');
    submit.disabled = true;
    const groupIds = [...form.querySelectorAll('input[name="group"]:checked')].map((b) => Number(b.value));
    try {
      const data = await api('managers', {
        method: 'POST',
        body: JSON.stringify({
          identity: form.identity.value,
          label: form.label.value,
          groupIds,
        }),
      });
      renderManagers(data.managers);
      notice(
        groupIds.length
          ? 'Đã lưu quản trị viên.'
          : 'Đã lưu, nhưng chưa gán nhóm nào — người này sẽ không thấy tài khoản nào.',
        !groupIds.length
      );
      form.reset();
      form.querySelectorAll('input[name="group"]').forEach((b) => (b.checked = false));
    } catch (err) {
      notice('Lưu quản trị viên thất bại: ' + err.message, true);
    } finally {
      submit.disabled = false;
    }
  });

  /* ─── boot ───────────────────────────────────── */

  async function loadSummary() {
    try {
      renderStats(await api('summary'));
    } catch {
      /* stats are decorative; the tables carry the real state */
    }
  }

  async function loadAll() {
    try {
      const groups = await api('groups');
      renderGroups(groups.groups);
      // Through the paged loaders, so the pagers reflect the current page and query
      // rather than being blank until the first interaction.
      await Promise.all([loadAccountsPage(), loadOrdersPage()]);
      await Promise.all([loadExpiring(), loadReports(), loadReport()]);
      if (IS_OWNER) {
        try {
          renderManagers((await api('managers')).managers);
        } catch {
          /* owner-only; ignore if it ever 403s */
        }
      }
      await loadSummary();
    } catch (err) {
      notice('Không tải được dữ liệu: ' + err.message, true);
    }
  }

  el('refreshBtn').addEventListener('click', loadAll);

  // The "còn lại" column is only correct at render time, so re-render it once a
  // minute. Cheap: it re-fetches nothing unless a row actually lapses.
  setInterval(() => {
    if (!el('expiringWrap').hidden) loadExpiring();
  }, 60_000);

  (async function boot() {
    let session;
    try {
      session = await api('session');
    } catch {
      session = { admin: false };
    }
    el('adminLoading').hidden = true;

    if (!session.admin) {
      el('deniedBody').textContent = session.email
        ? `Tài khoản ${session.email} không nằm trong danh sách quản trị (ADMIN_EMAILS).`
        : 'Bạn cần đăng nhập bằng tài khoản quản trị.';
      el('adminDenied').hidden = false;
      return;
    }

    IS_OWNER = session.role === 'owner';
    el('adminWho').textContent =
      (IS_OWNER ? 'Chủ shop: ' : 'Quản trị viên (theo nhóm): ') + (session.email || '—');
    // Group and manager administration is the owner's alone.
    const owner = el('ownerOnly');
    if (owner) owner.hidden = !IS_OWNER;
    el('adminPanel').hidden = false;
    loadAll();
  })();

  /* ─── Floating section jump ─────────────────── */

  {
    const nav = el('quickNav');
    const links = el('qnLinks');
    const toggle = el('qnToggle');

    // Several sections are hidden until their data arrives, or for a manager who
    // is not the owner. A jump to something invisible is worse than no jump, so
    // each entry mirrors its target's visibility.
    const entries = [...links.querySelectorAll('a[data-jump]')];
    const syncVisibility = () => {
      let shown = 0;
      for (const a of entries) {
        const target = el(a.dataset.jump);
        const visible = Boolean(target) && !target.hidden && target.offsetParent !== null;
        a.hidden = !visible;
        if (visible) shown++;
      }
      // Nothing to jump to yet — do not float an empty box over the page.
      nav.hidden = shown === 0;
    };

    // Those sections are unhidden by their own loaders, so watch rather than
    // sampling once at startup and getting it permanently wrong.
    const observer = new MutationObserver(syncVisibility);
    for (const a of entries) {
      const target = el(a.dataset.jump);
      if (target) observer.observe(target, { attributes: true, attributeFilter: ['hidden'] });
    }
    syncVisibility();

    const collapse = (collapsed) => {
      links.hidden = collapsed;
      toggle.setAttribute('aria-expanded', String(!collapsed));
      try {
        localStorage.setItem('fgQuickNav', collapsed ? 'closed' : 'open');
      } catch {
        /* private mode — the preference just does not persist */
      }
    };
    let startClosed = false;
    try {
      startClosed = localStorage.getItem('fgQuickNav') === 'closed';
    } catch {
      /* ignore */
    }
    collapse(startClosed);
    toggle.addEventListener('click', () => collapse(!links.hidden));

    for (const a of entries) {
      a.addEventListener('click', (e) => {
        const target = el(a.dataset.jump);
        if (!target) return;
        e.preventDefault();
        // Nudge up a little so the heading is not flush against the viewport edge.
        const top = target.getBoundingClientRect().top + window.scrollY - 14;
        window.scrollTo({ top: Math.max(top, 0), behavior: 'smooth' });
      });
    }

  }

</script>
