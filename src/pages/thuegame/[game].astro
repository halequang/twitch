---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { GAMES, compactParts, formatVnd, gameFromSlug, gameIds, gameSlug } from '../../data/rental-plans.js';

// One page per game, from one file: every game in the catalogue gets its own URL at
// build time. The slug comes from the catalogue's own `path`, so /thuegame/theisle
// keeps working exactly as before and a new game needs no new file.
export function getStaticPaths() {
  return gameIds().map((id) => ({ params: { game: gameSlug(id) } }));
}

// Card faces for the memory game — 8 pairs on a 4×4 board.
const glyphs = ['⚔', '🗡', '✦', '⚱', '⚜', '🛡', '🔥', '💀'];

// Plans are rendered at build time; live stock comes from /api/rent/plans.
const gameId = gameFromSlug(Astro.params.game);
const rentalGame = GAMES[gameId];
// Per-game palette, overriding the block's own custom properties. The rest of the
// stylesheet reads those variables, so a game re-themes without touching any rule.
// One card per duration, each holding the plans that are alternatives within it —
// "1 ngày" offering the plain and the vetted (no_ban) account, "1 tuần" the plain
// and the VOIP week. Resolved here so the template is a layout and nothing else.
//
// A game with no `groups` still renders: each plan becomes its own single-variant
// card, which is exactly what the page did before groups existed.
const planCards = (rentalGame.groups
  ? rentalGame.groups.map((group) => ({
      group,
      plans: rentalGame.plans.filter((p) => p.group === group.id),
    }))
  : rentalGame.plans.map((plan) => ({ group: { ...plan, id: plan.id }, plans: [plan] }))
).filter((card) => card.plans.length);

const theme = rentalGame.theme
  ? `--isle-bg:${rentalGame.theme.bg};--isle-bg-2:${rentalGame.theme.bg2};`
    + `--isle-line:${rentalGame.theme.line};--isle-green:${rentalGame.theme.accent};`
  : null;
---

<Layout
  advisor={false}
  title="Game Zone · FunGaming VN"
  description="Khu vực thành viên FunGaming VN — đăng nhập bằng Google hoặc Apple để chơi mini game và theo dõi kỷ lục của bạn."
>
  <Header
    compact
    brand="Game Zone"
    tagline="Member Area · Mini Game · Sign in with Google or Apple"
    taglineVi="Đăng nhập bằng Google hoặc Apple để vào khu vực thành viên"
  />

  <!-- Signed out -->
  <section id="authGate" class="panel" hidden>
    <SectionTitle
      title="Login"
      subtitle="Sign in with Google or Apple to enter the member area"
    />
    <div class="gate">
      <p class="gate-desc">
        Dùng tài khoản Google hoặc Apple của bạn để vào Game Zone. Chúng tôi chỉ
        lưu tên, email và ảnh đại diện của bạn.
      </p>
      <div class="providers">
        <div id="gsiButton" class="provider-button"></div>
        <!-- Apple's SDK renders into this div by id; the data-* attributes are
             its documented styling hooks. -->
        <div
          id="appleid-signin"
          class="provider-button"
          data-color="black"
          data-border="true"
          data-type="sign in"
          data-height="40"
          data-border-radius="20"
          hidden
        ></div>
      </div>
      <div class="or"><span>hoặc</span></div>

      <div class="email-auth">
        <div class="ea-tabs">
          <button id="tabLogin" type="button" class="ea-tab active">Đăng nhập</button>
          <button id="tabRegister" type="button" class="ea-tab">Đăng ký</button>
        </div>

        <!-- Says whose password this is, in both directions. A customer on a page
             about Steam accounts can otherwise reasonably type their STEAM password
             here, and a scanner reading "Mật khẩu" next to the word Steam cannot
             tell this from credential harvesting either. -->
        <form id="loginForm" class="ea-form">
          <p class="ea-scope">
            Mật khẩu <strong>tài khoản FunGaming VN</strong> của bạn.
            Không phải mật khẩu Steam — shop không bao giờ hỏi mật khẩu Steam của bạn.
          </p>
          <label class="ea-label" for="loginEmail">Email</label>
          <input id="loginEmail" class="ea-input" type="email" autocomplete="email" required />
          <label class="ea-label" for="loginPassword">Mật khẩu FunGaming VN</label>
          <input id="loginPassword" class="ea-input" type="password" autocomplete="current-password" required />
          <button type="submit" class="btn ea-submit">Đăng nhập</button>
        </form>

        <!-- Step 1 of 3. Each step is its own form so the browser offers the right
             autofill and the on-screen keyboard matches what is being asked for. -->
        <form id="regEmailForm" class="ea-form" hidden>
          <label class="ea-label" for="regEmail">Email</label>
          <input id="regEmail" class="ea-input" type="email" autocomplete="email" required />
          <p class="ea-hint">Chúng tôi sẽ gửi mã xác minh 6 số tới email này.</p>
          <button type="submit" class="btn ea-submit">Gửi mã xác minh</button>
        </form>

        <form id="regCodeForm" class="ea-form" hidden>
          <p class="ea-note">Đã gửi mã tới <strong id="regSentTo"></strong></p>
          <label class="ea-label" for="regCode">Mã xác minh</label>
          <input
            id="regCode"
            class="ea-input ea-code"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            maxlength="6"
            required
          />
          <button type="submit" class="btn ea-submit">Xác minh</button>
          <div class="ea-links">
            <button id="regResend" type="button" class="ea-link">Gửi lại mã</button>
            <button id="regBack" type="button" class="ea-link">Đổi email</button>
          </div>
        </form>

        <form id="regPassForm" class="ea-form" hidden>
          <p class="ea-note ok">✓ Đã xác minh <strong id="regVerified"></strong></p>
          <p class="ea-scope">
            Đặt mật khẩu cho <strong>tài khoản FunGaming VN</strong>. Đừng dùng lại
            mật khẩu Steam của bạn.
          </p>
          <label class="ea-label" for="regPass">Tạo mật khẩu</label>
          <input id="regPass" class="ea-input" type="password" autocomplete="new-password" required />
          <label class="ea-label" for="regPass2">Nhập lại mật khẩu</label>
          <input id="regPass2" class="ea-input" type="password" autocomplete="new-password" required />
          <p class="ea-hint">Tối thiểu 8 ký tự.</p>
          <button type="submit" class="btn ea-submit">Tạo tài khoản &amp; đăng nhập</button>
        </form>

        <p id="eaMsg" class="ea-msg" hidden></p>
      </div>

      <p id="authError" class="gate-error" hidden></p>
      <p class="gate-note">
        Bằng việc đăng nhập, bạn đồng ý cho FunGaming VN đọc thông tin hồ sơ cơ bản
        từ nhà cung cấp bạn chọn.
      </p>
    </div>
  </section>

  <!-- Loading -->
  <section id="authLoading" class="panel">
    <p class="loading">⟡ Đang kiểm tra phiên đăng nhập…</p>
  </section>

  <!-- Signed in -->
  <section id="member" class="panel" hidden>
    <div class="account">
      <img id="userPicture" class="avatar" alt="" width="56" height="56" hidden />
      <div class="account-meta">
        <p class="account-name" id="userName"></p>
        <p class="account-email" id="userEmail"></p>
      </div>
      <button id="logoutBtn" type="button" class="btn ghost">Đăng xuất</button>
    </div>
    <p id="memberError" class="member-error" hidden></p>

    <!-- The Isle rental, themed to match the shop's own artwork for it. The
         jungle palette is scoped to this block so the rest of the member area
         keeps the site's gold theme. -->
    <section class="isle" data-game={gameId} style={theme}>
      <header class="isle-banner">
        <div class="isle-moon" aria-hidden="true"></div>
        <svg class="isle-ridge" viewBox="0 0 600 90" preserveAspectRatio="none" aria-hidden="true">
          <path
            d="M0 90 L0 62 L38 40 L74 60 L118 30 L160 58 L206 34 L250 62 L300 28 L352 60 L398 36 L444 62 L490 34 L536 58 L572 42 L600 64 L600 90 Z"
            fill="currentColor"
          />
        </svg>
        <p class="isle-kicker">— {rentalGame.kicker} —</p>
        <h3 class="isle-title">{rentalGame.name}</h3>
        <p class="isle-subtitle">{rentalGame.flourish} {rentalGame.subtitle} {rentalGame.flourish}</p>
      </header>

      <p class="isle-blurb">{rentalGame.blurb}</p>
      <p class="isle-tagline">{rentalGame.tagline}</p>

    <div class="rent">
      <p id="rentNotice" class="rent-notice" hidden></p>

      <!-- payOS embedded checkout. Its SDK injects an iframe into #payosEmbed,
           sized to 100% height, so the container must set its own height. -->
      <div id="payosEmbedWrap" class="embed-wrap" hidden>
        <div class="embed-head">
          <span class="embed-title">Quét mã QR hoặc chuyển khoản để hoàn tất</span>
          <button id="payosClose" type="button" class="btn ghost">Đóng</button>
        </div>
        <div id="payosEmbed" class="embed-frame"></div>
        <p class="embed-note">
          Cửa sổ này sẽ tự đóng sau khi thanh toán thành công. Vui lòng không tắt trình duyệt.
          Nếu form không hiển thị,
          <!-- Always-present escape hatch: the embedded frame is cross-origin, so
               the page cannot tell whether it rendered. -->
          <a id="payosOpenHosted" href="#" target="_blank" rel="noopener">mở trang thanh toán payOS</a>.
        </p>
      </div>

      <!-- Live rentals and unpaid orders are rendered here by the script. -->
      <div id="rentOrders" class="rent-orders" hidden></div>

      <!-- Shown once a payment settles. A first-time renter's real question is
           "where do I get the account now?", so the credentials are put in front
           of them here and the box also names the section that keeps showing
           them, for when this popup is closed. Inside .isle to inherit its
           palette; position:fixed takes it out of the flow. -->
      <div id="doneModal" class="done-modal" hidden>
        <div class="done-card" role="dialog" aria-modal="true" aria-labelledby="doneTitle">
          <button id="doneClose" type="button" class="done-x" aria-label="Đóng">×</button>
          <p class="done-mark" aria-hidden="true">✓</p>
          <h4 id="doneTitle" class="done-title">Đơn hoàn tất</h4>
          <p id="doneSub" class="done-sub"></p>
          <div id="doneBody" class="done-body"></div>
          <div class="done-where">
            <span class="done-where-icon" aria-hidden="true">📍</span>
            <p>
              Thông tin đăng nhập luôn nằm ở mục <strong>“Tài khoản đang thuê”</strong> ngay
              trên trang này — đăng nhập lại bất cứ lúc nào để xem lại.
               <strong>mật khẩu mới luôn hiển thị trang web</strong>.
            </p>
          </div>
          <button id="doneGo" type="button" class="btn done-go">Xem tài khoản của tôi</button>
        </div>
      </div>

      <!-- One pool-wide figure was misleading once plans stopped sharing a pool:
           a no_ban account counts for the VOIP week and for nothing else. The
           number now lives on each card, next to the price it applies to. -->

      <!-- Above the plan cards on purpose: this is the one limitation that can make
           renting the wrong choice, so it has to be read before "Thuê ngay" rather
           than sitting in the small print underneath. -->
      {rentalGame.warning && (
        <div class="rent-warning" role="note">
          <p class="warn-title">{rentalGame.warning.title}</p>
          <p set:html={rentalGame.warning.body.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />
          <p class="warn-advice" set:html={rentalGame.warning.advice.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')} />
        </div>
      )}

      <div
        class="plans"
        data-game={gameId}
        data-plans={JSON.stringify(rentalGame.plans.map((p) => ({ id: p.id, label: p.label, amount: p.amount })))}
        data-purchase={rentalGame.purchase
          ? JSON.stringify({
              id: rentalGame.purchase.id,
              label: rentalGame.purchase.label,
              amount: rentalGame.purchase.amount,
              icon: rentalGame.purchase.icon,
              note: rentalGame.purchase.note,
            })
          : undefined}
      >
        {
          planCards.map(({ group, plans }) => (
            <div class={group.featured ? 'plan-group featured' : 'plan-group'}>
              {group.badge && <span class="plan-badge">{group.badge}</span>}
              <p class="plan-icon" aria-hidden="true">{group.icon}</p>
              <p class="plan-kicker">{group.kicker}</p>
              <p class="plan-label">{group.label}</p>
              <span class="plan-rule" aria-hidden="true"></span>

              <div class={plans.length > 1 ? 'plan-variants' : 'plan-variants single'}>
                {plans.map((plan) => (
                  /* Keeps the class `plan`: the stock script marks a sold-out card
                     with btn.closest('.plan'), and it is THIS card that sells out —
                     no_ban stock running dry must not grey out its neighbour. */
                  <div class="plan">
                    {plans.length > 1 && <p class="plan-variant">{plan.variant}</p>}
                    <p class="plan-price">
                      {compactParts(plan.amount).value}<span class="plan-unit">{compactParts(plan.amount).unit}</span>
                      <span class="plan-exact">{formatVnd(plan.amount)}</span>
                    </p>
                    <p class="plan-note">{plan.note}</p>
                    <p class="plan-stock" data-stock-for={plan.id}>&nbsp;</p>
                    <div class="plan-forecast" data-forecast-for={plan.id} hidden></div>
                    <label class="plan-qty">
                      <span>Số lượng</span>
                      <input
                        type="number"
                        class="qty-input"
                        data-qty-for={plan.id}
                        value="1"
                        min="1"
                        max="10"
                        inputmode="numeric"
                      />
                    </label>
                    {plan.perks && (
                      <div class="plan-perks">
                        <p class="perks-title">★ Đặc quyền</p>
                        <div class="perks-row">
                          {plan.perks.map((perk) => <span class="perk">{perk}</span>)}
                        </div>
                      </div>
                    )}
                    <button type="button" class="btn rent-btn" data-plan={plan.id}>Thuê ngay</button>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="features">
        <p class="features-title">⚔️ Đặc điểm dịch vụ</p>
        <ul class="features-list">
          {rentalGame.features.map((f) => <li>{f}</li>)}
        </ul>
      </div>

      <p class="rent-terms">
        Thanh toán qua PayOS (chuyển khoản / QR ngân hàng). Tài khoản được cho thuê
        theo thời gian, vui lòng không đổi mật khẩu hoặc thông tin đăng nhập.
      </p>

      <!-- Demand for games the shop does not carry. Below the plans on purpose: it is
           for the customer who did not find what they came for, and putting it above
           would offer a wish list to someone who could just buy. -->
      <div class="gr" id="gameRequest">
        <p class="gr-title">🎮 Không thấy game bạn muốn?</p>
        <p class="gr-sub">
          Gửi tên game bạn muốn thuê — shop sẽ ưu tiên nhập acc cho game nhiều người
          yêu cầu nhất. Bạn sẽ thấy trạng thái ngay tại đây.
        </p>
        <p id="grNotice" class="gr-notice" hidden></p>
        <div class="gr-form">
          <label class="gr-label" for="grName">Tên game</label>
          <input id="grName" type="text" maxlength="60" autocomplete="off"
                 placeholder="vd: Rust, ARK, Dead by Daylight" />
          <label class="gr-label" for="grNote">Ghi chú (không bắt buộc)</label>
          <input id="grNote" type="text" maxlength="400" autocomplete="off"
                 placeholder="vd: cần acc có DLC, chơi server VN" />
          <button id="grSend" class="gr-btn" type="button">Gửi yêu cầu</button>
        </div>
        <div id="grMine" class="gr-mine" hidden></div>
      </div>
    </div>

      <p class="isle-motto">{rentalGame.motto}</p>
    </section>

    <SectionTitle
      title="Memory of the Exile"
      subtitle="Lật tìm 8 cặp biểu tượng — ít lượt lật nhất thắng"
      spaced={true}
    />

    <div class="game">
      <div class="scoreboard">
        <div class="stat"><span class="stat-label">Lượt lật</span><span class="stat-value" id="statMoves">0</span></div>
        <div class="stat"><span class="stat-label">Cặp</span><span class="stat-value" id="statPairs">0 / 8</span></div>
        <div class="stat"><span class="stat-label">Thời gian</span><span class="stat-value" id="statTime">0:00</span></div>
        <div class="stat"><span class="stat-label">Kỷ lục (lượt)</span><span class="stat-value" id="statBest">—</span></div>
      </div>

      <div id="board" class="board" data-glyphs={JSON.stringify(glyphs)}></div>

      <p id="gameResult" class="game-result" hidden></p>
      <button id="restartBtn" type="button" class="btn">Chơi lại</button>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .panel { margin-bottom: 8px; }

  .loading {
    text-align: center;
    color: var(--text-muted);
    font-size: 13px;
    letter-spacing: 0.08em;
    padding: 48px 0;
  }

  /* ─── Login gate ───────────────────────────── */
  .gate {
    max-width: 440px;
    margin: 0 auto;
    padding: 32px 28px;
    text-align: center;
    background: linear-gradient(180deg, var(--bg-2) 0%, var(--bg-1) 100%);
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .gate-desc {
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-dim);
    margin-bottom: 24px;
  }

  .providers {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  /* Both SDKs inject their own button markup here; fix the box so the two sit
     at the same width and the layout does not jump as they load. */
  .provider-button {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 220px;
    min-height: 40px;
  }

  .provider-button[hidden] { display: none; }

  #appleid-signin { cursor: pointer; }
  #appleid-signin > div { width: 100%; }

  /* ─── Email sign-up / sign-in ──────────────── */

  .or {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 22px 0 18px;
    color: var(--text-dim);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .or::before,
  .or::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .email-auth { text-align: left; }

  .ea-tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }

  .ea-tab {
    padding: 8px 14px;
    font: inherit;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    cursor: pointer;
  }

  .ea-tab:hover { color: var(--gold-bright); }

  .ea-tab.active {
    color: var(--gold);
    border-bottom-color: var(--gold);
  }

  .ea-form { display: block; }
  .ea-form[hidden] { display: none; }

  .ea-label {
    display: block;
    margin-bottom: 5px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .ea-input {
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 14px;
    padding: 10px 12px;
    font: inherit;
    font-size: 14px;
    color: var(--text);
    background: var(--bg-1);
    border: 1px solid var(--line);
    border-radius: 3px;
  }

  .ea-input:focus {
    outline: none;
    border-color: var(--gold-dim);
  }

  /* One code, spaced out so a mistyped digit is easy to spot. */
  .ea-code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 20px;
    letter-spacing: 0.4em;
    text-align: center;
  }

  .ea-submit { width: 100%; }

  .ea-hint {
    margin: -6px 0 14px;
    font-size: 11px;
    line-height: 1.6;
    color: var(--text-dim);
  }

  .ea-note {
    margin: 0 0 14px;
    padding: 9px 12px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--text);
    background: rgba(200, 164, 74, 0.06);
    border-left: 2px solid var(--gold-dim);
  }

  .ea-note.ok { border-left-color: #5f8f4e; }
  .ea-note strong { color: var(--gold); }

  .ea-links {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-top: 12px;
  }

  .ea-link {
    padding: 0;
    font: inherit;
    font-size: 12px;
    color: var(--text-dim);
    background: none;
    border: 0;
    text-decoration: underline;
    cursor: pointer;
  }

  .ea-link:hover { color: var(--gold-bright); }
  .ea-link:disabled { opacity: 0.5; cursor: not-allowed; text-decoration: none; }

  .ea-msg {
    margin: 14px 0 0;
    padding: 10px 12px;
    font-size: 12.5px;
    line-height: 1.6;
    border-radius: 3px;
    background: rgba(122, 42, 42, 0.12);
    border: 1px solid #6a3030;
    color: #d98a8a;
  }

  .ea-msg.ok {
    background: rgba(95, 143, 78, 0.12);
    border-color: #3f6a33;
    color: #9ec98c;
  }

  .gate-error {
    margin-top: 18px;
    font-size: 12px;
    line-height: 1.6;
    color: #d98a8a;
  }

  .gate-note {
    margin-top: 22px;
    font-size: 11px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* ─── Account bar ──────────────────────────── */
  .account {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: linear-gradient(180deg, var(--bg-2) 0%, var(--bg-1) 100%);
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid var(--gold-dim);
    object-fit: cover;
  }

  .account-meta { flex: 1; min-width: 0; }

  .member-error {
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.6;
    color: #d98a8a;
    text-align: center;
  }

  .account-name {
    font-family: 'Cinzel', serif;
    font-size: 16px;
    letter-spacing: 0.06em;
    color: var(--gold-bright);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .account-email {
    font-size: 12px;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ─── Buttons ──────────────────────────────── */
  .btn {
    display: inline-block;
    padding: 10px 22px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bg-0);
    background: linear-gradient(180deg, var(--gold-bright) 0%, var(--gold) 100%);
    border: 1px solid var(--gold-dim);
    border-radius: 3px;
    cursor: pointer;
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .btn:hover { filter: brightness(1.1); transform: translateY(-1px); }

  .btn.ghost {
    color: var(--gold);
    background: transparent;
  }

  .btn.ghost:hover { color: var(--gold-bright); border-color: var(--gold); }

  /* ─── The Isle rental block ────────────────── */
  /* Jungle palette, deliberately scoped to this section only. */
  .isle {
    --isle-bg: #0c1a10;
    --isle-bg-2: #101f14;
    --isle-line: #2c4a2f;
    --isle-green: #7fae63;
    --isle-cream: #f3e3b3;
    --isle-gold: #e8c877;

    margin-top: 56px;
    background: var(--isle-bg);
    border: 1px solid var(--isle-line);
    border-radius: 6px;
    overflow: hidden;
  }

  .isle-banner {
    position: relative;
    padding: 44px 24px 40px;
    text-align: center;
    background:
      radial-gradient(ellipse at 50% 120%, rgba(127, 174, 99, 0.18) 0%, transparent 60%),
      linear-gradient(180deg, #050d07 0%, #0f2213 100%);
    border-bottom: 2px solid var(--isle-green);
    overflow: hidden;
  }

  .isle-moon {
    position: absolute;
    top: 26px;
    right: 8%;
    width: 74px;
    height: 74px;
    border-radius: 50%;
    background: #f6f3d8;
    box-shadow: 0 0 48px 14px rgba(246, 243, 216, 0.28);
  }

  /* Treeline silhouette along the bottom of the banner. */
  .isle-ridge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: 62px;
    color: #050d07;
    opacity: 0.9;
  }

  .isle-kicker,
  .isle-title,
  .isle-subtitle { position: relative; z-index: 1; }

  .isle-kicker {
    font-size: 12px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--isle-cream);
    margin-bottom: 10px;
  }

  .isle-title {
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: clamp(34px, 7vw, 64px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--isle-gold);
    text-shadow: 0 0 28px rgba(232, 200, 119, 0.45);
    margin-bottom: 8px;
  }

  .isle-subtitle {
    font-size: 13px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--isle-green);
  }

  .isle-blurb {
    margin: 28px 24px 4px;
    font-size: clamp(15px, 2.4vw, 20px);
    font-style: italic;
    font-weight: 500;
    color: var(--isle-cream);
    text-align: center;
  }

  .isle-tagline {
    margin: 0 24px 8px;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--isle-green);
    text-align: center;
  }

  .gr {
    margin-top: 18px;
    padding: 16px;
    background: var(--isle-bg-2);
    border: 1px solid var(--isle-line);
    border-radius: 4px;
  }

  .gr-title {
    margin: 0 0 4px;
    font-size: 14px;
    font-weight: 700;
    color: var(--isle-cream);
  }

  .gr-sub {
    margin: 0 0 12px;
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .gr-form { display: flex; flex-direction: column; gap: 6px; }

  .gr-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .gr-form input {
    padding: 10px 12px;
    font: inherit;
    font-size: 13.5px;
    color: var(--isle-cream);
    background: var(--isle-bg);
    border: 1px solid var(--isle-line);
    border-radius: 3px;
  }

  .gr-form input:focus {
    outline: none;
    border-color: var(--isle-gold);
  }

  .gr-btn {
    margin-top: 8px;
    padding: 11px 16px;
    font: inherit;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--isle-bg);
    background: linear-gradient(180deg, var(--isle-cream) 0%, var(--isle-gold) 100%);
    border: 1px solid var(--isle-gold);
    border-radius: 3px;
    cursor: pointer;
  }

  .gr-btn:hover { filter: brightness(1.08); }
  .gr-btn:disabled { opacity: 0.5; cursor: not-allowed; filter: none; }

  .gr-notice {
    margin: 0 0 10px;
    padding: 9px 11px;
    font-size: 12.5px;
    line-height: 1.6;
    border-radius: 3px;
    background: rgba(127, 174, 99, 0.12);
    border: 1px solid var(--isle-green);
    color: var(--isle-cream);
  }

  .gr-notice.error {
    background: rgba(248, 113, 113, 0.1);
    border-color: #f87171;
    color: #ffd9d9;
  }

  .gr-mine {
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px dashed var(--isle-line);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .gr-mine-title {
    margin: 0 0 2px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--text-muted);
  }

  .gr-row {
    padding: 11px 13px;
    font-size: 12.5px;
    background: var(--isle-bg);
    border: 1px solid var(--isle-line);
    /* The status colour lives on the left edge, so a list of several requests can be
       scanned down that edge without reading a word of it. */
    border-left: 3px solid var(--isle-line);
    border-radius: 4px;
  }

  .gr-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 9px;
  }

  .gr-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
  }

  .gr-name {
    color: var(--isle-cream);
    font-size: 13.5px;
    font-weight: 700;
    /* Takes the space it needs and lets the meta group sit at the far end; when
       there is not enough room for both, the whole group drops to the next line
       together. */
    flex: 0 1 auto;
    min-width: 0;
    word-break: break-word;
  }

  .gr-badge {
    padding: 2px 9px;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
    border-radius: 999px;
    border: 1px solid currentColor;
    opacity: 0.95;
  }

  .gr-count {
    padding: 2px 8px;
    font-size: 11px;
    color: var(--isle-cream);
    background: rgba(232, 200, 119, 0.12);
    border-radius: 999px;
    white-space: nowrap;
  }

  .gr-when {
    font-size: 11px;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .gr-note {
    margin: 7px 0 0;
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-muted);
    /* Their own words, quoted back — indented so it reads as a quote and not as a
       second sentence from the shop. */
    padding-left: 9px;
    border-left: 2px solid var(--isle-line);
  }

  .gr-reply {
    margin: 9px 0 0;
    padding: 8px 10px;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--isle-cream);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--isle-line);
    border-radius: 3px;
  }

  .gr-reply strong { color: var(--text-muted); font-weight: 600; }
  .gr-em { margin-right: 7px; }

  /* One colour per state, on the edge and the badge together. */
  .gr-row.gr-open { border-left-color: var(--isle-line); }
  .gr-row.gr-open .gr-badge { color: var(--text-muted); }

  .gr-row.gr-planned { border-left-color: var(--isle-gold); }
  .gr-row.gr-planned .gr-badge { color: var(--isle-gold); }

  .gr-row.gr-added { border-left-color: var(--isle-green); }
  .gr-row.gr-added .gr-badge { color: var(--isle-green); }
  /* The one state that is an invitation: it earns the brighter treatment, and it is
     the only one whose reply is dressed as good news. */
  .gr-row.gr-added { background: rgba(127, 174, 99, 0.07); }
  .gr-row.gr-added .gr-reply {
    background: rgba(127, 174, 99, 0.12);
    border-color: var(--isle-green);
  }

  .gr-row.gr-declined { border-left-color: #6b5555; opacity: 0.75; }
  .gr-row.gr-declined .gr-badge { color: #c99; }

  .isle-motto {
    padding: 20px 24px 26px;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--isle-line);
    text-align: center;
  }

  /* ─── Rentals ──────────────────────────────── */
  .rent { text-align: center; padding: 24px; }

  .rent-notice {
    margin-bottom: 20px;
    padding: 12px 16px;
    font-size: 13px;
    line-height: 1.6;
    border: 1px solid var(--gold-dim);
    border-radius: 3px;
    background: rgba(200, 164, 74, 0.06);
    color: var(--text);
  }

  /* ─── Order-complete popup ─────────────────── */

  .done-modal {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(4, 10, 6, 0.82);
    backdrop-filter: blur(3px);
  }

  .done-modal[hidden] { display: none; }

  .done-card {
    position: relative;
    width: 100%;
    max-width: 460px;
    max-height: 88vh;
    overflow-y: auto;
    padding: 30px 26px 24px;
    background: var(--isle-bg-2);
    border: 1px solid var(--isle-green);
    border-radius: 6px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.55);
    animation: done-in 0.22s ease-out;
  }

  @keyframes done-in {
    from { opacity: 0; transform: translateY(8px) scale(0.985); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .done-card { animation: none; }
  }

  .done-x {
    position: absolute;
    top: 8px;
    right: 10px;
    padding: 4px 8px;
    font: inherit;
    font-size: 20px;
    line-height: 1;
    color: var(--isle-green);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .done-x:hover { color: var(--isle-cream); }

  .done-mark {
    width: 52px;
    height: 52px;
    margin: 0 auto 14px;
    font-size: 26px;
    line-height: 48px;
    text-align: center;
    color: var(--isle-bg);
    background: var(--isle-green);
    border-radius: 50%;
  }

  .done-title {
    margin: 0 0 6px;
    font-size: 20px;
    text-align: center;
    color: var(--isle-cream);
  }

  .done-sub {
    margin: 0 0 18px;
    font-size: 12.5px;
    text-align: center;
    color: var(--isle-green);
  }

  .done-body { margin-bottom: 16px; }

  /* Credential rows are built in JS, so they carry no scoping attribute. */
  .done-body :global(.creds) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 8px 12px;
    align-items: center;
    margin: 0;
    padding: 14px;
    background: rgba(127, 174, 99, 0.07);
    border: 1px solid var(--isle-line);
    border-radius: 4px;
  }

  .done-body :global(.creds dt) {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--isle-green);
  }

  .done-body :global(.creds dd) {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 14px;
    color: var(--isle-cream);
    word-break: break-all;
  }

  .done-body :global(.copy-btn) {
    padding: 4px 10px;
    font-size: 11px;
    color: var(--isle-green);
    background: none;
    border: 1px solid var(--isle-line);
    border-radius: 3px;
    cursor: pointer;
  }

  .done-body :global(.copy-btn:hover) {
    color: var(--isle-cream);
    border-color: var(--isle-green);
  }

  .done-body :global(.done-fallback) {
    margin: 0;
    padding: 14px;
    font-size: 13px;
    line-height: 1.65;
    color: var(--isle-cream);
    background: rgba(127, 174, 99, 0.07);
    border: 1px solid var(--isle-line);
    border-radius: 4px;
  }

  .done-where {
    display: flex;
    gap: 10px;
    margin-bottom: 18px;
    padding: 12px 14px;
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--isle-cream);
    background: rgba(232, 200, 119, 0.06);
    border-left: 2px solid var(--isle-gold);
  }

  .done-where p { margin: 0; }
  .done-where strong { color: var(--isle-gold); font-weight: 600; }
  .done-where-icon { flex: none; }

  .done-go { width: 100%; }

  /* The rental list is flagged briefly after "Xem tài khoản của tôi", so the eye
     lands on the right block once the popup is out of the way. */
  .rent-orders.flash {
    animation: orders-flash 1.6s ease-out;
  }

  @keyframes orders-flash {
    0%, 100% { box-shadow: none; }
    25%      { box-shadow: 0 0 0 2px var(--isle-gold); }
  }

  body.modal-open { overflow: hidden; }

  .rent-notice.error {
    border-color: #6a3030;
    background: rgba(122, 42, 42, 0.12);
    color: #d98a8a;
  }

  /* Rental cards are built by the script at runtime, so they never receive
     Astro's scoping attribute — reach them with :global(), same as the game
     tiles. */
  .rent-orders { margin-bottom: 24px; }

  .rent-orders :global(.rental) {
    text-align: left;
    padding: 18px 20px;
    margin-bottom: 12px;
    background: linear-gradient(180deg, var(--bg-2) 0%, var(--bg-1) 100%);
    border: 1px solid var(--gold-dim);
    border-radius: 4px;
  }

  .rent-orders :global(.rental.pending) { border-color: var(--line); }

  .rent-orders :global(.rental-head) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 12px;
  }

  .rent-orders :global(.rental-title) {
    font-family: 'Cinzel', serif;
    font-size: 15px;
    color: var(--gold-bright);
    letter-spacing: 0.05em;
  }

  .rent-orders :global(.rental-status) {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 2px 8px;
  }

  .rent-orders :global(.rental-countdown) {
    margin-left: auto;
    font-size: 12px;
    color: var(--gold);
  }

  .rent-orders :global(.creds) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 10px 14px;
    align-items: center;
    padding: 14px;
    background: var(--bg-0);
    border: 1px solid var(--line);
    border-radius: 3px;
  }

  .rent-orders :global(.creds dt) {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .rent-orders :global(.creds dd) {
    font-family: 'Courier New', monospace;
    font-size: 15px;
    color: var(--text);
    word-break: break-all;
  }

  .rent-orders :global(.copy-btn) {
    padding: 5px 12px;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 2px;
    cursor: pointer;
    white-space: nowrap;
  }

  .rent-orders :global(.copy-btn:hover) {
    border-color: var(--gold-dim);
    color: var(--gold-bright);
  }

  .rent-orders :global(.extend) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .rent-orders :global(.extend-label) {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-right: 4px;
  }

  .rent-orders :global(.extend-btn) {
    padding: 7px 14px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: var(--gold);
    background: transparent;
    border: 1px solid var(--gold-dim);
    border-radius: 3px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .rent-orders :global(.extend-btn:hover) {
    color: var(--gold-bright);
    border-color: var(--gold);
  }

  .rent-orders :global(.extend-btn:disabled) { opacity: 0.4; cursor: not-allowed; }

  .rent-orders :global(.extend-why) {
    flex: 1 1 100%;
    margin: 8px 0 0;
    font-size: 11.5px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .rent-orders :global(.upgrade) {
    width: 100%;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--isle-line);
  }

  .rent-orders :global(.upgrade-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    margin-top: 8px;
  }

  .rent-orders :global(.upgrade-btn) {
    padding: 8px 15px;
    font-family: 'Inter', sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--isle-cream);
    background: rgba(232, 200, 119, 0.1);
    border: 1px solid var(--gold-dim);
    border-radius: 3px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }

  .rent-orders :global(.upgrade-btn:hover:not(:disabled)) {
    color: var(--gold-bright);
    border-color: var(--gold);
    background: rgba(232, 200, 119, 0.18);
  }

  .rent-orders :global(.upgrade-btn:disabled) { opacity: 0.5; cursor: not-allowed; }

  .rent-orders :global(.upgrade-note) {
    flex: 1 1 220px;
    margin: 0;
    font-size: 11.5px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .rent-orders :global(.addon) {
    width: 100%;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px dashed var(--isle-line);
  }

  .rent-orders :global(.addon-row) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 8px;
  }

  .rent-orders :global(.addon-game) {
    flex: 0 0 100%;
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: var(--isle-cream);
  }

  /* The old price, struck through beside the addon price. Muted and a shade
     smaller so the number being charged still reads first. */
  .rent-orders :global(.extend-btn .was-price) {
    margin-right: 2px;
    font-size: 11px;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: line-through;
  }

  .rent-orders :global(.extend-btn.has-discount) { border-color: var(--gold); }

  .rent-orders :global(.extend-btn .now-price) { font-weight: 700; }

  .rent-orders :global(.addon-note) {
    flex: 1 1 200px;
    margin: 0;
    font-size: 11.5px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .rent-orders :global(.buy) {
    width: 100%;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--isle-line);
  }

  .rent-orders :global(.buy-btn) {
    width: 100%;
    padding: 11px 16px;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--isle-bg);
    background: linear-gradient(180deg, var(--isle-cream) 0%, var(--isle-gold) 100%);
    border: 1px solid var(--isle-gold);
    border-radius: 3px;
    cursor: pointer;
  }

  .rent-orders :global(.buy-btn:hover) { filter: brightness(1.08); }
  .rent-orders :global(.buy-btn:disabled) { opacity: 0.5; cursor: not-allowed; filter: none; }

  .rent-orders :global(.buy-note) {
    margin: 7px 0 0;
    font-size: 11.5px;
    line-height: 1.6;
    text-align: center;
    color: var(--isle-green);
  }

  .rent-orders :global(.owned-note) {
    margin: 0;
    padding: 11px 14px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--isle-cream);
    background: rgba(232, 200, 119, 0.08);
    border-left: 2px solid var(--isle-gold);
  }

  /* Built in JS, so no scoping attribute — reach them with :global() under a
     static ancestor. Same reason as .rental above. */
  .ea-scope {
    margin: 0 0 4px;
    padding: 9px 11px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--isle-cream);
    background: rgba(232, 200, 119, 0.07);
    border-left: 2px solid var(--isle-gold);
    border-radius: 3px;
  }

  .ea-scope strong { color: var(--isle-gold); font-weight: 600; }

  .rent-orders :global(.guard) {
