---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import { DEFAULT_GAME, GAMES, compactParts, formatVnd } from '../../data/rental-plans.js';

// Card faces for the memory game — 8 pairs on a 4×4 board.
const glyphs = ['⚔', '🗡', '✦', '⚱', '⚜', '🛡', '🔥', '💀'];

// Plans are rendered at build time; live stock comes from /api/rent/plans.
const rentalGame = GAMES[DEFAULT_GAME];
---

<Layout
  advisor={false}
  title="Game Zone · FunGaming VN"
  description="Khu vực thành viên FunGaming VN — đăng nhập bằng Google hoặc Apple để chơi mini game và theo dõi kỷ lục của bạn."
>
  <Header
    compact
    brand="Game Zone"
    tagline="Member Area · Mini Game · Sign in with Google or Apple"
    taglineVi="Đăng nhập bằng Google hoặc Apple để vào khu vực thành viên"
  />

  <!-- Signed out -->
  <section id="authGate" class="panel" hidden>
    <SectionTitle
      title="Login"
      subtitle="Sign in with Google or Apple to enter the member area"
    />
    <div class="gate">
      <p class="gate-desc">
        Dùng tài khoản Google hoặc Apple của bạn để vào Game Zone. Chúng tôi chỉ
        lưu tên, email và ảnh đại diện của bạn.
      </p>
      <div class="providers">
        <div id="gsiButton" class="provider-button"></div>
        <!-- Apple's SDK renders into this div by id; the data-* attributes are
             its documented styling hooks. -->
        <div
          id="appleid-signin"
          class="provider-button"
          data-color="black"
          data-border="true"
          data-type="sign in"
          data-height="40"
          data-border-radius="20"
          hidden
        ></div>
      </div>
      <div class="or"><span>hoặc</span></div>

      <div class="email-auth">
        <div class="ea-tabs">
          <button id="tabLogin" type="button" class="ea-tab active">Đăng nhập</button>
          <button id="tabRegister" type="button" class="ea-tab">Đăng ký</button>
        </div>

        <!-- Says whose password this is, in both directions. A customer on a page
             about Steam accounts can otherwise reasonably type their STEAM password
             here, and a scanner reading "Mật khẩu" next to the word Steam cannot
             tell this from credential harvesting either. -->
        <form id="loginForm" class="ea-form">
          <p class="ea-scope">
            Mật khẩu <strong>tài khoản FunGaming VN</strong> của bạn.
            Không phải mật khẩu Steam — shop không bao giờ hỏi mật khẩu Steam của bạn.
          </p>
          <label class="ea-label" for="loginEmail">Email</label>
          <input id="loginEmail" class="ea-input" type="email" autocomplete="email" required />
          <label class="ea-label" for="loginPassword">Mật khẩu FunGaming VN</label>
          <input id="loginPassword" class="ea-input" type="password" autocomplete="current-password" required />
          <button type="submit" class="btn ea-submit">Đăng nhập</button>
        </form>

        <!-- Step 1 of 3. Each step is its own form so the browser offers the right
             autofill and the on-screen keyboard matches what is being asked for. -->
        <form id="regEmailForm" class="ea-form" hidden>
          <label class="ea-label" for="regEmail">Email</label>
          <input id="regEmail" class="ea-input" type="email" autocomplete="email" required />
          <p class="ea-hint">Chúng tôi sẽ gửi mã xác minh 6 số tới email này.</p>
          <button type="submit" class="btn ea-submit">Gửi mã xác minh</button>
        </form>

        <form id="regCodeForm" class="ea-form" hidden>
          <p class="ea-note">Đã gửi mã tới <strong id="regSentTo"></strong></p>
          <label class="ea-label" for="regCode">Mã xác minh</label>
          <input
            id="regCode"
            class="ea-input ea-code"
            type="text"
            inputmode="numeric"
            autocomplete="one-time-code"
            maxlength="6"
            required
          />
          <button type="submit" class="btn ea-submit">Xác minh</button>
          <div class="ea-links">
            <button id="regResend" type="button" class="ea-link">Gửi lại mã</button>
            <button id="regBack" type="button" class="ea-link">Đổi email</button>
          </div>
        </form>

        <form id="regPassForm" class="ea-form" hidden>
          <p class="ea-note ok">✓ Đã xác minh <strong id="regVerified"></strong></p>
          <p class="ea-scope">
            Đặt mật khẩu cho <strong>tài khoản FunGaming VN</strong>. Đừng dùng lại
            mật khẩu Steam của bạn.
          </p>
          <label class="ea-label" for="regPass">Tạo mật khẩu</label>
          <input id="regPass" class="ea-input" type="password" autocomplete="new-password" required />
          <label class="ea-label" for="regPass2">Nhập lại mật khẩu</label>
          <input id="regPass2" class="ea-input" type="password" autocomplete="new-password" required />
          <p class="ea-hint">Tối thiểu 8 ký tự.</p>
          <button type="submit" class="btn ea-submit">Tạo tài khoản &amp; đăng nhập</button>
        </form>

        <p id="eaMsg" class="ea-msg" hidden></p>
      </div>

      <p id="authError" class="gate-error" hidden></p>
      <p class="gate-note">
        Bằng việc đăng nhập, bạn đồng ý cho FunGaming VN đọc thông tin hồ sơ cơ bản
        từ nhà cung cấp bạn chọn.
      </p>
    </div>
  </section>

  <!-- Loading -->
  <section id="authLoading" class="panel">
    <p class="loading">⟡ Đang kiểm tra phiên đăng nhập…</p>
  </section>

  <!-- Signed in -->
  <section id="member" class="panel" hidden>
    <div class="account">
      <img id="userPicture" class="avatar" alt="" width="56" height="56" hidden />
      <div class="account-meta">
        <p class="account-name" id="userName"></p>
        <p class="account-email" id="userEmail"></p>
      </div>
      <button id="logoutBtn" type="button" class="btn ghost">Đăng xuất</button>
    </div>
    <p id="memberError" class="member-error" hidden></p>

    <!-- The Isle rental, themed to match the shop's own artwork for it. The
         jungle palette is scoped to this block so the rest of the member area
         keeps the site's gold theme. -->
    <section class="isle">
      <header class="isle-banner">
        <div class="isle-moon" aria-hidden="true"></div>
        <svg class="isle-ridge" viewBox="0 0 600 90" preserveAspectRatio="none" aria-hidden="true">
          <path
            d="M0 90 L0 62 L38 40 L74 60 L118 30 L160 58 L206 34 L250 62 L300 28 L352 60 L398 36 L444 62 L490 34 L536 58 L572 42 L600 64 L600 90 Z"
            fill="currentColor"
          />
        </svg>
        <p class="isle-kicker">— {rentalGame.kicker} —</p>
        <h3 class="isle-title">{rentalGame.name}</h3>
        <p class="isle-subtitle">🦎 {rentalGame.subtitle} 🦎</p>
      </header>

      <p class="isle-blurb">{rentalGame.blurb}</p>
      <p class="isle-tagline">{rentalGame.tagline}</p>

    <div class="rent">
      <p id="rentNotice" class="rent-notice" hidden></p>

      <!-- payOS embedded checkout. Its SDK injects an iframe into #payosEmbed,
           sized to 100% height, so the container must set its own height. -->
      <div id="payosEmbedWrap" class="embed-wrap" hidden>
        <div class="embed-head">
          <span class="embed-title">Quét mã QR hoặc chuyển khoản để hoàn tất</span>
          <button id="payosClose" type="button" class="btn ghost">Đóng</button>
        </div>
        <div id="payosEmbed" class="embed-frame"></div>
        <p class="embed-note">
          Cửa sổ này sẽ tự đóng sau khi thanh toán thành công. Vui lòng không tắt trình duyệt.
          Nếu form không hiển thị,
          <!-- Always-present escape hatch: the embedded frame is cross-origin, so
               the page cannot tell whether it rendered. -->
          <a id="payosOpenHosted" href="#" target="_blank" rel="noopener">mở trang thanh toán payOS</a>.
        </p>
      </div>

      <!-- Live rentals and unpaid orders are rendered here by the script. -->
      <div id="rentOrders" class="rent-orders" hidden></div>

      <!-- Shown once a payment settles. A first-time renter's real question is
           "where do I get the account now?", so the credentials are put in front
           of them here and the box also names the section that keeps showing
           them, for when this popup is closed. Inside .isle to inherit its
           palette; position:fixed takes it out of the flow. -->
      <div id="doneModal" class="done-modal" hidden>
        <div class="done-card" role="dialog" aria-modal="true" aria-labelledby="doneTitle">
          <button id="doneClose" type="button" class="done-x" aria-label="Đóng">×</button>
          <p class="done-mark" aria-hidden="true">✓</p>
          <h4 id="doneTitle" class="done-title">Đơn hoàn tất</h4>
          <p id="doneSub" class="done-sub"></p>
          <div id="doneBody" class="done-body"></div>
          <div class="done-where">
            <span class="done-where-icon" aria-hidden="true">📍</span>
            <p>
              Thông tin đăng nhập luôn nằm ở mục <strong>“Tài khoản đang thuê”</strong> ngay
              trên trang này — đăng nhập lại bất cứ lúc nào để xem lại.
               <strong>mật khẩu mới luôn hiển thị trang web</strong>.
            </p>
          </div>
          <button id="doneGo" type="button" class="btn done-go">Xem tài khoản của tôi</button>
        </div>
      </div>

      <!-- One pool-wide figure was misleading once plans stopped sharing a pool:
           a no_ban account counts for the VOIP week and for nothing else. The
           number now lives on each card, next to the price it applies to. -->

      <!-- Above the plan cards on purpose: this is the one limitation that can make
           renting the wrong choice, so it has to be read before "Thuê ngay" rather
           than sitting in the small print underneath. -->
      <div class="rent-warning" role="note">
        <p class="warn-title">⚠ LƯU Ý</p>
        <p>
          Acc cho thuê <strong>không hỗ trợ đăng nhập qua trang web hoặc PM bên thứ 3</strong>
          để sử dụng voice chat hoặc các tính năng custom khác, tùy server khác nhau.
        </p>
        <p class="warn-advice">
          👉 Ae nào muốn chơi những server bắt buộc sử dụng voice thì mình khuyên
          <strong>nên mua acc luôn</strong> để chơi cho thoải mái nhé!
        </p>
      </div>

      <div
        class="plans"
        data-plans={JSON.stringify(rentalGame.plans.map((p) => ({ id: p.id, label: p.label, amount: p.amount })))}
        data-purchase={rentalGame.purchase
          ? JSON.stringify({
              id: rentalGame.purchase.id,
              label: rentalGame.purchase.label,
              amount: rentalGame.purchase.amount,
              icon: rentalGame.purchase.icon,
              note: rentalGame.purchase.note,
            })
          : undefined}
      >
        {
          rentalGame.plans.map((plan) => (
            <div class={plan.featured ? 'plan featured' : 'plan'}>
              {plan.badge && <span class="plan-badge">{plan.badge}</span>}
              <p class="plan-icon" aria-hidden="true">{plan.icon}</p>
              <p class="plan-kicker">{plan.kicker}</p>
              <p class="plan-label">{plan.label}</p>
              <span class="plan-rule" aria-hidden="true"></span>
              <p class="plan-price">
                {compactParts(plan.amount).value}<span class="plan-unit">{compactParts(plan.amount).unit}</span>
                <span class="plan-exact">{formatVnd(plan.amount)}</span>
              </p>
              <p class="plan-note">{plan.note}</p>
              <p class="plan-stock" data-stock-for={plan.id}>&nbsp;</p>
              <div class="plan-forecast" data-forecast-for={plan.id} hidden></div>
              <label class="plan-qty">
                <span>Số lượng</span>
                <input
                  type="number"
                  class="qty-input"
                  data-qty-for={plan.id}
                  value="1"
                  min="1"
                  max="10"
                  inputmode="numeric"
                />
              </label>
              {plan.perks && (
                <div class="plan-perks">
                  <p class="perks-title">★ Đặc quyền gói tuần</p>
                  <div class="perks-row">
                    {plan.perks.map((perk) => <span class="perk">{perk}</span>)}
                  </div>
                </div>
              )}
              <button type="button" class="btn rent-btn" data-plan={plan.id}>Thuê ngay</button>
            </div>
          ))
        }
      </div>

      <div class="features">
        <p class="features-title">⚔️ Đặc điểm dịch vụ</p>
        <ul class="features-list">
          {rentalGame.features.map((f) => <li>{f}</li>)}
        </ul>
      </div>

      <p class="rent-terms">
        Thanh toán qua PayOS (chuyển khoản / QR ngân hàng). Tài khoản được cho thuê
        theo thời gian, vui lòng không đổi mật khẩu hoặc thông tin đăng nhập.
      </p>
    </div>

      <p class="isle-motto">{rentalGame.motto}</p>
    </section>

    <SectionTitle
      title="Memory of the Exile"
      subtitle="Lật tìm 8 cặp biểu tượng — ít lượt lật nhất thắng"
      spaced={true}
    />

    <div class="game">
      <div class="scoreboard">
        <div class="stat"><span class="stat-label">Lượt lật</span><span class="stat-value" id="statMoves">0</span></div>
        <div class="stat"><span class="stat-label">Cặp</span><span class="stat-value" id="statPairs">0 / 8</span></div>
        <div class="stat"><span class="stat-label">Thời gian</span><span class="stat-value" id="statTime">0:00</span></div>
        <div class="stat"><span class="stat-label">Kỷ lục (lượt)</span><span class="stat-value" id="statBest">—</span></div>
      </div>

      <div id="board" class="board" data-glyphs={JSON.stringify(glyphs)}></div>

      <p id="gameResult" class="game-result" hidden></p>
      <button id="restartBtn" type="button" class="btn">Chơi lại</button>
    </div>
  </section>

  <Footer />
</Layout>

<style>
  .panel { margin-bottom: 8px; }

  .loading {
    text-align: center;
    color: var(--text-muted);
    font-size: 13px;
    letter-spacing: 0.08em;
    padding: 48px 0;
  }

  /* ─── Login gate ───────────────────────────── */
  .gate {
    max-width: 440px;
    margin: 0 auto;
    padding: 32px 28px;
    text-align: center;
    background: linear-gradient(180deg, var(--bg-2) 0%, var(--bg-1) 100%);
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .gate-desc {
    font-size: 13px;
    line-height: 1.7;
    color: var(--text-dim);
    margin-bottom: 24px;
  }

  .providers {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  /* Both SDKs inject their own button markup here; fix the box so the two sit
     at the same width and the layout does not jump as they load. */
  .provider-button {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 220px;
    min-height: 40px;
  }

  .provider-button[hidden] { display: none; }

  #appleid-signin { cursor: pointer; }
  #appleid-signin > div { width: 100%; }

  /* ─── Email sign-up / sign-in ──────────────── */

  .or {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 22px 0 18px;
    color: var(--text-dim);
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .or::before,
  .or::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--line);
  }

  .email-auth { text-align: left; }

  .ea-tabs {
    display: flex;
    gap: 4px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }

  .ea-tab {
    padding: 8px 14px;
    font: inherit;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--text-dim);
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    cursor: pointer;
  }

  .ea-tab:hover { color: var(--gold-bright); }

  .ea-tab.active {
    color: var(--gold);
    border-bottom-color: var(--gold);
  }

  .ea-form { display: block; }
  .ea-form[hidden] { display: none; }

  .ea-label {
    display: block;
    margin-bottom: 5px;
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .ea-input {
    width: 100%;
    box-sizing: border-box;
    margin-bottom: 14px;
    padding: 10px 12px;
    font: inherit;
    font-size: 14px;
    color: var(--text);
    background: var(--bg-1);
    border: 1px solid var(--line);
    border-radius: 3px;
  }

  .ea-input:focus {
    outline: none;
    border-color: var(--gold-dim);
  }

  /* One code, spaced out so a mistyped digit is easy to spot. */
  .ea-code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 20px;
    letter-spacing: 0.4em;
    text-align: center;
  }

  .ea-submit { width: 100%; }

  .ea-hint {
    margin: -6px 0 14px;
    font-size: 11px;
    line-height: 1.6;
    color: var(--text-dim);
  }

  .ea-note {
    margin: 0 0 14px;
    padding: 9px 12px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--text);
    background: rgba(200, 164, 74, 0.06);
    border-left: 2px solid var(--gold-dim);
  }

  .ea-note.ok { border-left-color: #5f8f4e; }
  .ea-note strong { color: var(--gold); }

  .ea-links {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-top: 12px;
  }

  .ea-link {
    padding: 0;
    font: inherit;
    font-size: 12px;
    color: var(--text-dim);
    background: none;
    border: 0;
    text-decoration: underline;
    cursor: pointer;
  }

  .ea-link:hover { color: var(--gold-bright); }
  .ea-link:disabled { opacity: 0.5; cursor: not-allowed; text-decoration: none; }

  .ea-msg {
    margin: 14px 0 0;
    padding: 10px 12px;
    font-size: 12.5px;
    line-height: 1.6;
    border-radius: 3px;
    background: rgba(122, 42, 42, 0.12);
    border: 1px solid #6a3030;
    color: #d98a8a;
  }

  .ea-msg.ok {
    background: rgba(95, 143, 78, 0.12);
    border-color: #3f6a33;
    color: #9ec98c;
  }

  .gate-error {
    margin-top: 18px;
    font-size: 12px;
    line-height: 1.6;
    color: #d98a8a;
  }

  .gate-note {
    margin-top: 22px;
    font-size: 11px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* ─── Account bar ──────────────────────────── */
  .account {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    background: linear-gradient(180deg, var(--bg-2) 0%, var(--bg-1) 100%);
    border: 1px solid var(--line);
    border-radius: 4px;
  }

  .avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 1px solid var(--gold-dim);
    object-fit: cover;
  }

  .account-meta { flex: 1; min-width: 0; }

  .member-error {
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.6;
    color: #d98a8a;
    text-align: center;
  }

  .account-name {
    font-family: 'Cinzel', serif;
    font-size: 16px;
    letter-spacing: 0.06em;
    color: var(--gold-bright);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .account-email {
    font-size: 12px;
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ─── Buttons ──────────────────────────────── */
  .btn {
    display: inline-block;
    padding: 10px 22px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--bg-0);
    background: linear-gradient(180deg, var(--gold-bright) 0%, var(--gold) 100%);
    border: 1px solid var(--gold-dim);
    border-radius: 3px;
    cursor: pointer;
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .btn:hover { filter: brightness(1.1); transform: translateY(-1px); }

  .btn.ghost {
    color: var(--gold);
    background: transparent;
  }

  .btn.ghost:hover { color: var(--gold-bright); border-color: var(--gold); }

  /* ─── The Isle rental block ────────────────── */
  /* Jungle palette, deliberately scoped to this section only. */
  .isle {
    --isle-bg: #0c1a10;
    --isle-bg-2: #101f14;
    --isle-line: #2c4a2f;
    --isle-green: #7fae63;
    --isle-cream: #f3e3b3;
    --isle-gold: #e8c877;

    margin-top: 56px;
    background: var(--isle-bg);
    border: 1px solid var(--isle-line);
    border-radius: 6px;
    overflow: hidden;
  }

  .isle-banner {
    position: relative;
    padding: 44px 24px 40px;
    text-align: center;
    background:
      radial-gradient(ellipse at 50% 120%, rgba(127, 174, 99, 0.18) 0%, transparent 60%),
      linear-gradient(180deg, #050d07 0%, #0f2213 100%);
    border-bottom: 2px solid var(--isle-green);
    overflow: hidden;
  }

  .isle-moon {
    position: absolute;
    top: 26px;
    right: 8%;
    width: 74px;
    height: 74px;
    border-radius: 50%;
    background: #f6f3d8;
    box-shadow: 0 0 48px 14px rgba(246, 243, 216, 0.28);
  }

  /* Treeline silhouette along the bottom of the banner. */
  .isle-ridge {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: 62px;
    color: #050d07;
    opacity: 0.9;
  }

  .isle-kicker,
  .isle-title,
  .isle-subtitle { position: relative; z-index: 1; }

  .isle-kicker {
    font-size: 12px;
    letter-spacing: 0.34em;
    text-transform: uppercase;
    color: var(--isle-cream);
    margin-bottom: 10px;
  }

  .isle-title {
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: clamp(34px, 7vw, 64px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--isle-gold);
    text-shadow: 0 0 28px rgba(232, 200, 119, 0.45);
    margin-bottom: 8px;
  }

  .isle-subtitle {
    font-size: 13px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--isle-green);
  }

  .isle-blurb {
    margin: 28px 24px 4px;
    font-size: clamp(15px, 2.4vw, 20px);
    font-style: italic;
    font-weight: 500;
    color: var(--isle-cream);
    text-align: center;
  }

  .isle-tagline {
    margin: 0 24px 8px;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--isle-green);
    text-align: center;
  }

  .isle-motto {
    padding: 20px 24px 26px;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--isle-line);
    text-align: center;
  }

  /* ─── Rentals ──────────────────────────────── */
  .rent { text-align: center; padding: 24px; }

  .rent-notice {
    margin-bottom: 20px;
    padding: 12px 16px;
    font-size: 13px;
    line-height: 1.6;
    border: 1px solid var(--gold-dim);
    border-radius: 3px;
    background: rgba(200, 164, 74, 0.06);
    color: var(--text);
  }

  /* ─── Order-complete popup ─────────────────── */

  .done-modal {
    position: fixed;
    inset: 0;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(4, 10, 6, 0.82);
    backdrop-filter: blur(3px);
  }

  .done-modal[hidden] { display: none; }

  .done-card {
    position: relative;
    width: 100%;
    max-width: 460px;
    max-height: 88vh;
    overflow-y: auto;
    padding: 30px 26px 24px;
    background: var(--isle-bg-2);
    border: 1px solid var(--isle-green);
    border-radius: 6px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.55);
    animation: done-in 0.22s ease-out;
  }

  @keyframes done-in {
    from { opacity: 0; transform: translateY(8px) scale(0.985); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .done-card { animation: none; }
  }

  .done-x {
    position: absolute;
    top: 8px;
    right: 10px;
    padding: 4px 8px;
    font: inherit;
    font-size: 20px;
    line-height: 1;
    color: var(--isle-green);
    background: none;
    border: 0;
    cursor: pointer;
  }

  .done-x:hover { color: var(--isle-cream); }

  .done-mark {
    width: 52px;
    height: 52px;
    margin: 0 auto 14px;
    font-size: 26px;
    line-height: 48px;
    text-align: center;
    color: var(--isle-bg);
    background: var(--isle-green);
    border-radius: 50%;
  }

  .done-title {
    margin: 0 0 6px;
    font-size: 20px;
    text-align: center;
    color: var(--isle-cream);
  }

  .done-sub {
    margin: 0 0 18px;
    font-size: 12.5px;
    text-align: center;
    color: var(--isle-green);
  }

  .done-body { margin-bottom: 16px; }

  /* Credential rows are built in JS, so they carry no scoping attribute. */
  .done-body :global(.creds) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 8px 12px;
    align-items: center;
    margin: 0;
    padding: 14px;
    background: rgba(127, 174, 99, 0.07);
    border: 1px solid var(--isle-line);
    border-radius: 4px;
  }

  .done-body :global(.creds dt) {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--isle-green);
  }

  .done-body :global(.creds dd) {
    margin: 0;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 14px;
    color: var(--isle-cream);
    word-break: break-all;
  }

  .done-body :global(.copy-btn) {
    padding: 4px 10px;
    font-size: 11px;
    color: var(--isle-green);
    background: none;
    border: 1px solid var(--isle-line);
    border-radius: 3px;
    cursor: pointer;
  }

  .done-body :global(.copy-btn:hover) {
    color: var(--isle-cream);
    border-color: var(--isle-green);
  }

  .done-body :global(.done-fallback) {
    margin: 0;
    padding: 14px;
    font-size: 13px;
    line-height: 1.65;
    color: var(--isle-cream);
    background: rgba(127, 174, 99, 0.07);
    border: 1px solid var(--isle-line);
    border-radius: 4px;
  }

  .done-where {
    display: flex;
    gap: 10px;
    margin-bottom: 18px;
    padding: 12px 14px;
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--isle-cream);
    background: rgba(232, 200, 119, 0.06);
    border-left: 2px solid var(--isle-gold);
  }

  .done-where p { margin: 0; }
  .done-where strong { color: var(--isle-gold); font-weight: 600; }
  .done-where-icon { flex: none; }

  .done-go { width: 100%; }

  /* The rental list is flagged briefly after "Xem tài khoản của tôi", so the eye
     lands on the right block once the popup is out of the way. */
  .rent-orders.flash {
    animation: orders-flash 1.6s ease-out;
  }

  @keyframes orders-flash {
    0%, 100% { box-shadow: none; }
    25%      { box-shadow: 0 0 0 2px var(--isle-gold); }
  }

  body.modal-open { overflow: hidden; }

  .rent-notice.error {
    border-color: #6a3030;
    background: rgba(122, 42, 42, 0.12);
    color: #d98a8a;
  }

  /* Rental cards are built by the script at runtime, so they never receive
     Astro's scoping attribute — reach them with :global(), same as the game
     tiles. */
  .rent-orders { margin-bottom: 24px; }

  .rent-orders :global(.rental) {
    text-align: left;
    padding: 18px 20px;
    margin-bottom: 12px;
    background: linear-gradient(180deg, var(--bg-2) 0%, var(--bg-1) 100%);
    border: 1px solid var(--gold-dim);
    border-radius: 4px;
  }

  .rent-orders :global(.rental.pending) { border-color: var(--line); }

  .rent-orders :global(.rental-head) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 12px;
  }

  .rent-orders :global(.rental-title) {
    font-family: 'Cinzel', serif;
    font-size: 15px;
    color: var(--gold-bright);
    letter-spacing: 0.05em;
  }

  .rent-orders :global(.rental-status) {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 2px 8px;
  }

  .rent-orders :global(.rental-countdown) {
    margin-left: auto;
    font-size: 12px;
    color: var(--gold);
  }

  .rent-orders :global(.creds) {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 10px 14px;
    align-items: center;
    padding: 14px;
    background: var(--bg-0);
    border: 1px solid var(--line);
    border-radius: 3px;
  }

  .rent-orders :global(.creds dt) {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .rent-orders :global(.creds dd) {
    font-family: 'Courier New', monospace;
    font-size: 15px;
    color: var(--text);
    word-break: break-all;
  }

  .rent-orders :global(.copy-btn) {
    padding: 5px 12px;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 2px;
    cursor: pointer;
    white-space: nowrap;
  }

  .rent-orders :global(.copy-btn:hover) {
    border-color: var(--gold-dim);
    color: var(--gold-bright);
  }

  .rent-orders :global(.extend) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }

  .rent-orders :global(.extend-label) {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-right: 4px;
  }

  .rent-orders :global(.extend-btn) {
    padding: 7px 14px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    color: var(--gold);
    background: transparent;
    border: 1px solid var(--gold-dim);
    border-radius: 3px;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .rent-orders :global(.extend-btn:hover) {
    color: var(--gold-bright);
    border-color: var(--gold);
  }

  .rent-orders :global(.extend-btn:disabled) { opacity: 0.5; cursor: not-allowed; }

  .rent-orders :global(.buy) {
    width: 100%;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--isle-line);
  }

  .rent-orders :global(.buy-btn) {
    width: 100%;
    padding: 11px 16px;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--isle-bg);
    background: linear-gradient(180deg, var(--isle-cream) 0%, var(--isle-gold) 100%);
    border: 1px solid var(--isle-gold);
    border-radius: 3px;
    cursor: pointer;
  }

  .rent-orders :global(.buy-btn:hover) { filter: brightness(1.08); }
  .rent-orders :global(.buy-btn:disabled) { opacity: 0.5; cursor: not-allowed; filter: none; }

  .rent-orders :global(.buy-note) {
    margin: 7px 0 0;
    font-size: 11.5px;
    line-height: 1.6;
    text-align: center;
    color: var(--isle-green);
  }

  .rent-orders :global(.owned-note) {
    margin: 0;
    padding: 11px 14px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--isle-cream);
    background: rgba(232, 200, 119, 0.08);
    border-left: 2px solid var(--isle-gold);
  }

  /* Built in JS, so no scoping attribute — reach them with :global() under a
     static ancestor. Same reason as .rental above. */
  .ea-scope {
    margin: 0 0 4px;
    padding: 9px 11px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--isle-cream);
    background: rgba(232, 200, 119, 0.07);
    border-left: 2px solid var(--isle-gold);
    border-radius: 3px;
  }

  .ea-scope strong { color: var(--isle-gold); font-weight: 600; }

  .rent-orders :global(.guard) {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--isle-line);
  }

  .rent-orders :global(.guard-guide) {
    margin-bottom: 10px;
    padding: 10px 12px;
    background: rgba(127, 174, 99, 0.07);
    border-left: 2px solid var(--isle-green);
    border-radius: 3px;
  }

  .rent-orders :global(.guard-title) {
    margin: 0 0 6px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--isle-cream);
  }

  .rent-orders :global(.guard-guide ol) {
    margin: 0;
    padding-left: 20px;
    font-size: 12.5px;
    line-height: 1.75;
    color: var(--isle-cream);
  }

  .rent-orders :global(.guard-warn) {
    margin: 8px 0 0;
    font-size: 12px;
    line-height: 1.65;
    color: var(--isle-gold);
  }

  .rent-orders :global(.guard-btn) { font-size: 13px; }

  .rent-orders :global(.guard-out) {
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--isle-cream);
  }

  /* Now a row of [code][Chép], so the type treatment moved to the value itself —
     left on the paragraph, the 20px and 0.18em tracking were inherited by the
     button and blew it up. */
  .rent-orders :global(.guard-out.code) {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .rent-orders :global(.guard-code-value) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 20px;
    letter-spacing: 0.18em;
    color: var(--isle-gold);
  }

  .rent-orders :global(.guard-out.error) { color: #d98a8a; font-size: 12.5px; line-height: 1.6; }

  .rent-orders :global(.guard-hint) {
    margin: 6px 0 0;
    font-size: 11.5px;
    line-height: 1.6;
    color: var(--isle-green);
    opacity: 0.85;
  }

  .rent-orders :global(.report) {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px solid var(--isle-line);
  }

  .rent-orders :global(.report-toggle) {
    padding: 0;
    font: inherit;
    font-size: 12px;
    color: var(--isle-green);
    background: none;
    border: 0;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .rent-orders :global(.report-toggle:hover) { color: var(--isle-gold); }

  .rent-orders :global(.report-form) {
    display: grid;
    gap: 8px;
    margin-top: 10px;
  }

  .rent-orders :global(.report-reason),
  .rent-orders :global(.report-note) {
    width: 100%;
    padding: 8px 10px;
    font: inherit;
    font-size: 13px;
    color: var(--isle-cream);
    background: var(--isle-bg);
    border: 1px solid var(--isle-line);
    border-radius: 3px;
  }

  .rent-orders :global(.report-note) { resize: vertical; }

  .rent-orders :global(.report-reason:focus),
  .rent-orders :global(.report-note:focus) {
    outline: none;
    border-color: var(--isle-green);
  }

  .rent-orders :global(.report-send) { justify-self: start; }

  .rent-orders :global(.report-status) {
    margin: 0;
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--isle-green);
  }

  .rent-orders :global(.report-status.error) { color: #d98a8a; }

  /* An outstanding report is stated plainly so nobody files it twice. */
  .rent-orders :global(.report-open) {
    margin: 0;
    padding: 10px 12px;
    font-size: 12.5px;
    line-height: 1.65;
    color: var(--isle-cream);
    background: rgba(232, 200, 119, 0.07);
    border-left: 2px solid var(--isle-gold);
    border-radius: 3px;
  }

  .rent-orders :global(.rental-note) {
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.6;
    color: var(--text-dim);
  }

  /* The "continue payment" link is created by the script too. */
  .rent-orders :global(.btn) {
    display: inline-block;
    padding: 10px 22px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--bg-0);
    background: linear-gradient(180deg, var(--gold-bright) 0%, var(--gold) 100%);
    border: 1px solid var(--gold-dim);
    border-radius: 3px;
    cursor: pointer;
  }

  /* ─── payOS embedded checkout ──────────────── */
  .embed-wrap {
    margin-bottom: 24px;
    padding: 16px;
    background: linear-gradient(180deg, var(--bg-2) 0%, var(--bg-1) 100%);
    border: 1px solid var(--gold-dim);
    border-radius: 4px;
  }

  .embed-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .embed-title {
    flex: 1;
    text-align: left;
    font-size: 13px;
    color: var(--text-dim);
  }

  /* The payOS iframe is height:100%, so the height must live here. */
  .embed-frame {
    height: 620px;
    background: #fff;
    border-radius: 3px;
    overflow: hidden;
  }

  /* The iframe is created by the script, so it carries no scoping attribute. */
  .embed-frame :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .embed-note {
    margin-top: 10px;
    font-size: 11px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .embed-note a {
    color: var(--gold);
    text-decoration: none;
    border-bottom: 1px dotted var(--gold-dim);
  }

  .embed-note a:hover { color: var(--gold-bright); }

  @media (max-width: 520px) {
    .embed-frame { height: 680px; }
    .embed-head { flex-wrap: wrap; }
  }

  .plans {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin-bottom: 28px;
  }

  .plan {
    position: relative;
    padding: 34px 22px 26px;
    background: linear-gradient(180deg, #12251700 0%, rgba(127, 174, 99, 0.07) 100%);
    border: 1px solid var(--isle-line);
    border-radius: 6px;
    transition: border-color 0.25s ease, transform 0.25s ease;
  }

  .plan:hover { border-color: var(--isle-green); transform: translateY(-2px); }

  .plan.featured {
    border-color: var(--isle-gold);
    box-shadow: 0 0 26px rgba(232, 200, 119, 0.12);
  }

  .plan-badge {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    padding: 4px 14px;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #2a1e05;
    background: linear-gradient(180deg, var(--isle-gold) 0%, #c9a44f 100%);
    border-radius: 999px;
  }

  .plan-icon { font-size: 34px; line-height: 1; margin-bottom: 12px; }

  .plan-kicker {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--isle-green);
    margin-bottom: 8px;
  }

  .plan.featured .plan-kicker { color: var(--isle-gold); }

  .plan-label {
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: clamp(24px, 4vw, 34px);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--isle-cream);
    margin-bottom: 14px;
  }

  .plan-rule {
    display: block;
    width: 72%;
    height: 1px;
    margin: 0 auto 16px;
    background: linear-gradient(to right, transparent, var(--isle-line), transparent);
  }

  .plan-price {
    font-family: 'Cinzel', serif;
    font-weight: 700;
    font-size: clamp(32px, 5.5vw, 46px);
    line-height: 1;
    color: var(--isle-cream);
    margin-bottom: 8px;
  }

  /* Cinzel has no lowercase, so the unit is set in Inter to stay a real "k". */
  .plan-unit {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 0.62em;
    letter-spacing: 0;
  }

  .plan-exact {
    display: block;
    margin-top: 6px;
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--isle-green);
  }

  /* Only the full-perks plan renders this, so it doubles as the visible reason
     one week costs more than another. */
  .plan-perks {
    margin: 0 0 16px;
    padding: 10px 12px;
    background: rgba(232, 200, 119, 0.07);
    border: 1px solid var(--isle-line);
    border-radius: 4px;
  }

  .perks-title {
    margin: 0 0 8px;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--isle-gold);
  }

  .perks-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }

  .perk {
    padding: 4px 12px;
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: var(--isle-cream);
    border: 1px solid var(--isle-gold);
    border-radius: 999px;
  }

  /* A plan whose own stock is gone, while others may still be rentable. */
  .plan-forecast {
    margin: 0 0 14px;
    padding: 9px 11px;
    text-align: left;
    background: rgba(127, 174, 99, 0.06);
    border-left: 2px solid var(--isle-green);
    border-radius: 3px;
  }

  .plan-forecast[hidden] { display: none; }

  .forecast-title {
    margin: 0 0 5px;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--isle-green);
  }

  .forecast-row {
    margin: 0 0 3px;
    font-size: 12px;
    line-height: 1.5;
    color: var(--isle-cream);
  }

  .forecast-note,
  .forecast-none {
    margin: 6px 0 0;
    font-size: 11px;
    line-height: 1.6;
    color: var(--isle-green);
  }

  .forecast-none { margin: 0; }

  .plan-qty {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin: 0 0 14px;
    font-size: 11.5px;
    letter-spacing: 0.06em;
    color: var(--isle-green);
  }

  .qty-input {
    width: 64px;
    padding: 5px 8px;
    font: inherit;
    font-size: 14px;
    text-align: center;
    color: var(--isle-cream);
    background: var(--isle-bg);
    border: 1px solid var(--isle-line);
    border-radius: 3px;
  }

  .qty-input:focus { outline: none; border-color: var(--isle-gold); }
  .plan.sold-out .plan-qty { opacity: 0.45; }

  .plan-stock {
    margin: 0 0 14px;
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--isle-green);
    min-height: 1em;
  }

  .plan-stock.low { color: var(--isle-gold); }
  .plan-stock.none { color: #d98a8a; }

  .plan.sold-out {
    opacity: 0.55;
  }

  .plan.sold-out .plan-price { color: var(--isle-green); }

  .plan-note {
    font-size: 12px;
    line-height: 1.5;
    color: var(--isle-green);
    margin-bottom: 20px;
  }

  .plan.featured .plan-note { color: var(--isle-gold); }

  /* ─── Feature list ─────────────────────────── */
  .features {
    margin-bottom: 24px;
    padding: 20px 22px;
    text-align: left;
    background: var(--isle-bg-2);
    border-left: 3px solid var(--isle-green);
    border-radius: 4px;
  }

  .features-title {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--isle-gold);
    margin-bottom: 16px;
  }

  /* Two columns, matching the artwork. The feature array is ordered so each
     row pairs correctly left-to-right. */
  .features-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px 28px;
    list-style: none;
  }

  @media (max-width: 640px) {
    .features-list { grid-template-columns: 1fr; }
  }

  .features-list li {
    position: relative;
    padding-left: 26px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--isle-cream);
  }

  .features-list li::before {
    content: "✅";
    position: absolute;
    left: 0;
    font-size: 12px;
  }

  .rent-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
    transform: none;
    filter: none;
  }

  /* Caution, not decoration: amber and full-contrast text, unlike .rent-terms
     which is deliberately faint. */
  .rent-warning {
    margin-bottom: 22px;
    padding: 14px 16px;
    text-align: left;
    background: rgba(232, 200, 119, 0.07);
    border: 1px solid var(--isle-gold);
    border-left-width: 3px;
    border-radius: 4px;
  }

  .rent-warning p {
    margin: 0 0 8px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--isle-cream);
  }

  .rent-warning p:last-child { margin-bottom: 0; }

  .rent-warning strong { color: var(--isle-gold); font-weight: 600; }

  .warn-title {
    font-size: 12px !important;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--isle-gold) !important;
  }

  .warn-advice {
    padding-top: 8px;
    border-top: 1px solid var(--isle-line);
  }

  .rent-terms {
    font-size: 11px;
    line-height: 1.7;
    color: var(--isle-green);
    opacity: 0.75;
  }

  /* Rent buttons pick up the jungle theme rather than the site gold. */
  .rent-btn {
    color: #0c1a10;
    background: linear-gradient(180deg, var(--isle-cream) 0%, var(--isle-gold) 100%);
    border-color: var(--isle-gold);
  }

  @media (max-width: 520px) {
    .rent-orders :global(.creds) { grid-template-columns: 1fr; }
    .rent-orders :global(.creds dd) { margin-bottom: 4px; }
  }

  /* ─── Game ─────────────────────────────────── */
  .game { text-align: center; }

  .scoreboard {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 24px;
  }

  .stat {
    padding: 12px 8px;
    background: var(--bg-1);
    border: 1px solid var(--line);
    border-radius: 3px;
  }

  .stat-label {
    display: block;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .stat-value {
    display: block;
    font-family: 'Cinzel', serif;
    font-size: 18px;
    color: var(--gold-bright);
  }

  .board {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    max-width: 460px;
    margin: 0 auto 24px;
  }

  /* Tiles are built by the script at runtime, so they never get Astro's scoping
     attribute — reach them through the board with :global(). */
  .board :global(.tile) {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    aspect-ratio: 1;
    font-size: clamp(24px, 7vw, 36px);
    line-height: 1;
    color: var(--gold-bright);
    background: linear-gradient(180deg, var(--bg-2) 0%, var(--bg-1) 100%);
    border: 1px solid var(--line);
    border-radius: 4px;
    cursor: pointer;
    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .board :global(.tile:hover:not(.revealed):not(.matched)) {
    border-color: var(--gold-dim);
    transform: translateY(-2px);
  }

  .board :global(.face) { opacity: 0; transition: opacity 0.15s ease; }
  .board :global(.tile.revealed .face),
  .board :global(.tile.matched .face) { opacity: 1; }

  .board :global(.tile.revealed) { border-color: var(--gold-dim); }

  .board :global(.tile.matched) {
    border-color: var(--gold);
    box-shadow: 0 0 18px rgba(200, 164, 74, 0.18);
    cursor: default;
  }

  .board :global(.tile.matched .face) { opacity: 0.45; }

  .game-result {
    margin-bottom: 20px;
    font-family: 'Cinzel', serif;
    font-size: 16px;
    color: var(--gold-bright);
  }

  @media (max-width: 520px) {
    .scoreboard { grid-template-columns: repeat(2, 1fr); }
    .account { flex-wrap: wrap; }
  }
</style>

<script>
  const el = (id) => document.getElementById(id);
  const loading = el('authLoading');
  const gate = el('authGate');
  const member = el('member');
  const errorBox = el('authError');

  function showError(message) {
    errorBox.textContent = message;
    errorBox.hidden = false;
  }

  /* ─── Session ────────────────────────────────── */

  const PROVIDER_LABELS = { google: 'Google', apple: 'Apple' };

  function showSignedIn(user) {
    el('userName').textContent = user.name || 'Exile';
    const label = PROVIDER_LABELS[user.provider];
    el('userEmail').textContent = [user.email, label && 'qua ' + label]
      .filter(Boolean)
      .join(' · ');
    const pic = el('userPicture');
    if (user.picture) {
      // Apple never sends an avatar, so the element simply stays hidden.
      pic.src = user.picture;
      pic.alt = user.name || '';
      pic.referrerPolicy = 'no-referrer';
      pic.hidden = false;
    }
    loading.hidden = true;
    gate.hidden = true;
    member.hidden = false;
    // Namespace the score by provider — the same `sub` from two providers is
    // two different people.
    startGame((user.provider ? user.provider + ':' : '') + user.sub);
    initRentals();
  }

  function showSignedOut() {
    loading.hidden = true;
    member.hidden = true;
    gate.hidden = false;
    initSignIn();
  }

  async function checkSession() {
    try {
      const res = await fetch('/api/auth/me', { credentials: 'same-origin' });
      const data = await res.json();
      if (data.user) return showSignedIn(data.user);
    } catch {
      /* fall through to the login gate */
    }
    showSignedOut();
  }

  el('logoutBtn').addEventListener('click', async () => {
    const failed = el('memberError');
    failed.hidden = true;
    try {
      // Reloading on a failed logout would silently drop the user back into the
      // member area still signed in — say so instead.
      const res = await fetch('/api/auth/logout', { method: 'POST', credentials: 'same-origin' });
      if (!res.ok) throw new Error(String(res.status));
    } catch (err) {
      failed.textContent = 'Đăng xuất thất bại (' + err.message + '). Vui lòng thử lại.';
      failed.hidden = false;
      return;
    }
    if (window.google?.accounts?.id) window.google.accounts.id.disableAutoSelect();
    window.location.reload();
  });

  /* ─── Sign-in providers ──────────────────────── */

  let providersReady = false;

  function loadScript(src, isLoaded) {
    return new Promise((resolve, reject) => {
      if (isLoaded()) return resolve();
      const script = document.createElement('script');
      script.src = src;
      script.async = true;
      script.onload = resolve;
      script.onerror = () => reject(new Error('script_failed'));
      document.head.appendChild(script);
    });
  }

  // Both providers end up here: an ID token goes to the server, the server
  // verifies it and sets the session cookie, and we get the user back.
  async function submitToken(provider, payload) {
    try {
      const res = await fetch('/api/auth/' + provider, {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok || !data.user) {
        return showError('Đăng nhập thất bại. Vui lòng thử lại. (' + (data.error || res.status) + ')');
      }
      showSignedIn(data.user);
    } catch {
      showError('Không kết nối được máy chủ. Vui lòng thử lại.');
    }
  }

  /* ─── Email sign-up / sign-in ───────────────── */

  // Server errors are machine-readable so they can be translated here rather than
  // shown raw. Anything unmapped falls through to its own code, which is more use
  // than a generic apology when someone reports a problem.
  const EA_ERRORS = {
    invalid_email: 'Email không hợp lệ.',
    already_registered: 'Email này đã có tài khoản — hãy chọn “Đăng nhập”.',
    mail_not_configured: 'Chưa cấu hình gửi email. Vui lòng liên hệ shop.',
    email_signup_unavailable: 'Đăng ký bằng email chưa sẵn sàng. Vui lòng dùng Google hoặc Apple.',
    mail_failed: 'Không gửi được email. Vui lòng thử lại sau ít phút.',
    too_soon: 'Bạn vừa yêu cầu mã. Vui lòng đợi một chút rồi thử lại.',
    no_code: 'Chưa có mã nào cho email này. Hãy gửi mã mới.',
    code_expired: 'Mã đã hết hạn. Hãy gửi mã mới.',
    code_incorrect: 'Mã không đúng.',
    too_many_attempts: 'Sai mã quá nhiều lần. Hãy gửi mã mới.',
    verification_expired: 'Phiên xác minh đã hết hạn. Hãy bắt đầu lại.',
    password_too_short: 'Mật khẩu cần tối thiểu 8 ký tự.',
    password_too_long: 'Mật khẩu quá dài.',
    bad_credentials: 'Email hoặc mật khẩu không đúng.',
    signup_failed: 'Không tạo được tài khoản. Vui lòng thử lại.',
  };

  let eaClaimToken = null;
  let eaResendTimer = null;

  function eaMessage(text, ok = false) {
    const box = el('eaMsg');
    box.textContent = text;
    box.classList.toggle('ok', ok);
    box.hidden = !text;
  }

  function eaError(data, status) {
    const code = data?.error;
    let text = EA_ERRORS[code] || ('Có lỗi xảy ra (' + (code || status) + ').');
    if (code === 'code_incorrect' && typeof data.attemptsLeft === 'number') {
      text += ' Còn ' + data.attemptsLeft + ' lần thử.';
    }
    if (code === 'too_soon' && typeof data.retryAfter === 'number') {
      text += ' (' + data.retryAfter + ' giây)';
    }
    eaMessage(text, false);
  }

  async function eaPost(path, payload) {
    const res = await fetch(path, {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify(payload),
    });
    let data = {};
    try {
      data = await res.json();
    } catch {
      /* an empty body is still an outcome */
    }
    return { ok: res.ok, status: res.status, data };
  }

  function eaShow(which) {
    for (const id of ['loginForm', 'regEmailForm', 'regCodeForm', 'regPassForm']) {
      el(id).hidden = id !== which;
    }
    eaMessage('');
  }

  function eaSetTab(register) {
    el('tabLogin').classList.toggle('active', !register);
    el('tabRegister').classList.toggle('active', register);
    eaShow(register ? 'regEmailForm' : 'loginForm');
  }

  // The server enforces the cooldown; this only stops people hammering a button
  // that is guaranteed to answer 429.
  function eaStartResendCooldown(seconds) {
    const btn = el('regResend');
    clearInterval(eaResendTimer);
    let left = seconds;
    const tick = () => {
      if (left <= 0) {
        clearInterval(eaResendTimer);
        btn.disabled = false;
        btn.textContent = 'Gửi lại mã';
        return;
      }
      btn.disabled = true;
      btn.textContent = 'Gửi lại mã (' + left + 's)';
      left--;
    };
    tick();
    eaResendTimer = setInterval(tick, 1000);
  }

  function eaBusy(form, busy, label) {
    const btn = form.querySelector('button[type="submit"]');
    if (!btn) return;
    btn.disabled = busy;
    if (busy) {
      btn.dataset.label = btn.textContent;
      btn.textContent = label;
    } else if (btn.dataset.label) {
      btn.textContent = btn.dataset.label;
    }
  }

  async function eaRequestCode(email, form) {
    eaBusy(form, true, 'Đang gửi…');
    const { ok, status, data } = await eaPost('/api/auth/register', { email });
    eaBusy(form, false);
    if (!ok) {
      eaError(data, status);
      // Already registered is not a dead end — put them on the sign-in tab.
      if (data?.error === 'already_registered') eaSetTab(false);
      return false;
    }
    el('regSentTo').textContent = email;
    eaShow('regCodeForm');
    eaStartResendCooldown(data.resendAfter || 60);
    eaMessage('Đã gửi mã. Kiểm tra hộp thư (cả mục spam).', true);
    el('regCode').focus();
    return true;
  }

  el('tabLogin').addEventListener('click', () => eaSetTab(false));
  el('tabRegister').addEventListener('click', () => eaSetTab(true));

  el('regEmailForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = el('regEmail').value.trim();
    if (!email) return;
    await eaRequestCode(email, e.currentTarget);
  });

  el('regResend').addEventListener('click', async () => {
    const email = el('regEmail').value.trim();
    if (email) await eaRequestCode(email, el('regCodeForm'));
  });

  el('regBack').addEventListener('click', () => {
    clearInterval(eaResendTimer);
    eaShow('regEmailForm');
    el('regEmail').focus();
  });

  el('regCodeForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    const email = el('regEmail').value.trim();
    const code = el('regCode').value.replace(/\D/g, '');
    if (code.length !== 6) return eaMessage('Mã gồm 6 số.', false);

    eaBusy(form, true, 'Đang kiểm tra…');
    const { ok, status, data } = await eaPost('/api/auth/verify', { email, code });
    eaBusy(form, false);
    if (!ok || !data.token) return eaError(data, status);

    eaClaimToken = data.token;
    clearInterval(eaResendTimer);
    el('regVerified').textContent = email;
    eaShow('regPassForm');
    el('regPass').focus();
  });

  el('regPassForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    const password = el('regPass').value;
    if (password !== el('regPass2').value) {
      return eaMessage('Hai mật khẩu không giống nhau.', false);
    }
    if (password.length < 8) return eaMessage('Mật khẩu cần tối thiểu 8 ký tự.', false);
    if (!eaClaimToken) return eaMessage(EA_ERRORS.verification_expired, false);

    eaBusy(form, true, 'Đang tạo…');
    const { ok, status, data } = await eaPost('/api/auth/complete', {
      token: eaClaimToken,
      password,
    });
    eaBusy(form, false);
    if (!ok || !data.user) return eaError(data, status);

    eaClaimToken = null;
    el('regPass').value = '';
    el('regPass2').value = '';
    showSignedIn(data.user);
  });

  el('loginForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.currentTarget;
    eaBusy(form, true, 'Đang đăng nhập…');
    const { ok, status, data } = await eaPost('/api/auth/login', {
      email: el('loginEmail').value.trim(),
      password: el('loginPassword').value,
    });
    eaBusy(form, false);
    if (!ok || !data.user) return eaError(data, status);
    el('loginPassword').value = '';
    showSignedIn(data.user);
  });

  async function initGoogle(config) {
    await loadScript('https://accounts.google.com/gsi/client', () => !!window.google?.accounts?.id);
    window.google.accounts.id.initialize({
      client_id: config.clientId,
      callback: (response) => submitToken('google', { credential: response.credential }),
      auto_select: false,
      cancel_on_tap_outside: true,
    });
    window.google.accounts.id.renderButton(el('gsiButton'), {
      theme: 'filled_black',
      size: 'large',
      shape: 'pill',
      text: 'signin_with',
      width: 220,
      locale: 'vi',
    });
  }

  async function initApple(config) {
    await loadScript(
      'https://appleid.cdn-apple.com/appleauth/static/jsapi/appleid/1/en_US/appleid.auth.js',
      () => !!window.AppleID?.auth
    );

    // The SDK owns the click on its rendered button, so the result arrives as a
    // document event rather than a promise. `user` (the display name) is only
    // present on the very first authorization — Apple never sends it again.
    document.addEventListener('AppleIDSignInOnSuccess', (event) => {
      const detail = event.detail || {};
      const idToken = detail.authorization?.id_token ?? detail.id_token;
      if (!idToken) return showError('Apple không trả về mã đăng nhập. Vui lòng thử lại.');
      submitToken('apple', { id_token: idToken, user: detail.user ?? null });
    });

    document.addEventListener('AppleIDSignInOnFailure', (event) => {
      const reason = event.detail?.error;
      // Closing the popup is a normal cancel, not an error worth showing.
      if (reason === 'popup_closed_by_user' || reason === 'user_cancelled_authorize') return;
      showError('Đăng nhập Apple thất bại' + (reason ? ' (' + reason + ')' : '') + '. Vui lòng thử lại.');
    });

    window.AppleID.auth.init({
      clientId: config.clientId,
      scope: 'name email',
      redirectURI: config.redirectUri,
      usePopup: true,
    });
    const appleButton = el('appleid-signin');
    appleButton.hidden = false;
    window.AppleID.auth.renderButton();
  }

  async function initSignIn() {
    if (providersReady) return;
    providersReady = true;
    try {
      const res = await fetch('/api/auth/config', { credentials: 'same-origin' });
      const config = await res.json();
      if (!config.google && !config.apple) {
        return showError(
          'Đăng nhập chưa được cấu hình (thiếu GOOGLE_CLIENT_ID và APPLE_CLIENT_ID).'
        );
      }

      // One provider failing to load must not take the other down with it.
      const tasks = [];
      if (config.google) tasks.push(initGoogle(config.google));
      if (config.apple) tasks.push(initApple(config.apple));
      const results = await Promise.allSettled(tasks);
      if (results.every((r) => r.status === 'rejected')) {
        providersReady = false;
        showError('Không tải được nút đăng nhập. Kiểm tra kết nối mạng rồi thử lại.');
      }
    } catch {
      providersReady = false;
      showError('Không tải được cấu hình đăng nhập. Vui lòng thử lại.');
    }
  }

  /* ─── Steam account rentals ──────────────────── */

  const RENT_STATUS = {
    pending: 'Chờ thanh toán',
    active: 'Đang thuê',
    expired: 'Đã hết hạn',
    cancelled: 'Đã huỷ',
    payment_expired: 'Link thanh toán hết hạn',
    extended: 'Đã gia hạn',
    awaiting_stock: 'Đã thanh toán — hết tài khoản',
    error: 'Lỗi đọc tài khoản',
    sold: 'Đã chuyển sang mua',
  };

  let countdownTimer = null;

  function rentNotice(message, isError) {
    const box = el('rentNotice');
    box.textContent = message;
    box.classList.toggle('error', Boolean(isError));
    box.hidden = false;
  }

  function formatRemaining(seconds) {
    if (seconds <= 0) return 'hết hạn';
    const d = Math.floor(seconds / 86400);
    const h = Math.floor((seconds % 86400) / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    const s = seconds % 60;
    if (d > 0) return d + ' ngày ' + h + ' giờ';
    if (h > 0) return h + ' giờ ' + String(m).padStart(2, '0') + ' phút';
    return m + ':' + String(s).padStart(2, '0');
  }

  function copyButton(value) {
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = 'Chép';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(value);
        btn.textContent = 'Đã chép';
        setTimeout(() => (btn.textContent = 'Chép'), 1500);
      } catch {
        btn.textContent = 'Lỗi';
      }
    });
    return btn;
  }

  function credentialRow(parent, label, value) {
    const dt = document.createElement('dt');
    dt.textContent = label;
    const dd = document.createElement('dd');
    dd.textContent = value;
    parent.append(dt, dd, copyButton(value));
  }

  function renderOrder(order) {
    const box = document.createElement('div');
    box.className = 'rental' + (order.status === 'active' ? '' : ' pending');

    const head = document.createElement('div');
    head.className = 'rental-head';
    const title = document.createElement('span');
    title.className = 'rental-title';
    // A purchase has no duration, so the usual "· N giờ" would read "· 0 giờ".
    title.textContent = order.purchase ? 'The Isle · Sở hữu vĩnh viễn' : 'The Isle · ' + order.hours + ' giờ';
    const status = document.createElement('span');
    status.className = 'rental-status';
    status.textContent = order.purchase && order.status === 'active'
      ? 'Đã mua'
      : RENT_STATUS[order.status] || order.status;
    head.append(title, status);

    if (order.status === 'active' && order.expiresAt) {
      const countdown = document.createElement('span');
      countdown.className = 'rental-countdown';
      countdown.dataset.expiresAt = String(order.expiresAt);
      head.appendChild(countdown);
    }
    box.appendChild(head);

    if (order.credentials) {
      const creds = document.createElement('dl');
      creds.className = 'creds';
      credentialRow(creds, 'Tài khoản', order.credentials.login);
      credentialRow(creds, 'Mật khẩu', order.credentials.password);
      // Only present when RENTAL_RELEASE_EMAIL is switched on server-side.
      if (order.credentials.email) credentialRow(creds, 'Email', order.credentials.email);
      if (order.credentials.emailPassword) {
        credentialRow(creds, 'Mật khẩu email', order.credentials.emailPassword);
      }
      box.appendChild(creds);

      const note = document.createElement('p');
      note.className = 'rental-note';
      note.textContent =
        order.credentials.note ||
        'Đăng nhập Steam, bật chế độ offline nếu được yêu cầu. Vui lòng không đổi mật khẩu.';
      box.appendChild(note);
      box.appendChild(extendControls(order));
      // Only accounts marked as using email Steam Guard. On the rest the button
      // would promise a code that never arrives.
      if (order.guardCode) box.appendChild(steamCodeControls(order));
      box.appendChild(reportControls(order));
    } else if (order.status === 'pending' && order.checkoutUrl) {
      // Resume an unfinished order in the same embedded form, not by navigating
      // off to the hosted page.
      const resume = document.createElement('button');
      resume.type = 'button';
      resume.className = 'btn';
      resume.textContent = 'Tiếp tục thanh toán';
      resume.addEventListener('click', async () => {
        try {
          await openEmbeddedCheckout(order.checkoutUrl, order.orderCode);
        } catch {
          window.location.href = order.checkoutUrl;
        }
      });
      // Styling for the embed note link lives with the rest of the rent styles.
      box.appendChild(resume);
    } else if (order.status === 'awaiting_stock') {
      const note = document.createElement('p');
      note.className = 'rental-note';
      note.textContent =
        'Đơn đã thanh toán nhưng tạm hết tài khoản trống. Vui lòng liên hệ shop để được xếp tài khoản hoặc hoàn tiền — mã đơn ' +
        order.orderCode + '.';
      box.appendChild(note);
    }
    return box;
  }

  const RENT_PLANS = JSON.parse(document.querySelector('.plans').dataset.plans);
  const BUY_PLAN = document.querySelector('.plans').dataset.purchase
    ? JSON.parse(document.querySelector('.plans').dataset.purchase)
    : null;

  const compact = (amount) => (amount % 1000 === 0 ? amount / 1000 + 'k' : amount + '₫');

  /**
   * "Add more time" buttons for a live rental. Extending keeps the SAME Steam
   * account, so it works even when the pool is empty — no stock check needed.
   */
  // The renter's own open/closed reports, refreshed with the orders list.
  const reports = [];

  const REPORT_REASONS = {
    intruder: 'Có người khác đăng nhập vào tài khoản',
    cannot_login: 'Không đăng nhập được',
    wrong_password: 'Mật khẩu không đúng',
    guard_code: 'Bị hỏi mã Steam Guard',
    banned: 'Tài khoản bị khoá / ban',
    other: 'Vấn đề khác',
  };

  /**
   * "Lấy mã Steam Guard" on a live rental.
   *
   * The code is fetched server-side; the mailbox address is never sent to the
   * browser, because handing that over would let a renter reset the password. The
   * copy says requests are logged, which is true and is the point.
   */
  function steamCodeControls(order) {
    const wrap = document.createElement('div');
    wrap.className = 'guard';

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'btn guard-btn';
    btn.textContent = '🔑 Lấy mã Steam Guard';

    const out = document.createElement('p');
    out.className = 'guard-out';
    out.hidden = true;

    // A guard account needs the steps in order, because the button returns the
    // NEWEST code in the mailbox: pressing it before triggering the login hands back
    // a previous code, which Steam rejects as used. That single detail is the
    // difference between this working and looking broken, so it is step 1 and it is
    // repeated as the warning.
    const guide = document.createElement('div');
    guide.className = 'guard-guide';

    const title = document.createElement('p');
    title.className = 'guard-title';
    title.textContent = 'Tài khoản này cần mã Steam Guard qua email — làm theo thứ tự:';

    const steps = document.createElement('ol');
    for (const text of [
      'Nhập tài khoản và mật khẩu ở trên vào Steam, bấm Đăng nhập.',
      'Steam sẽ hiện ô "nhập mã từ email" — lúc này mã mới được gửi đi.',
      'Quay lại đây, bấm “Lấy mã Steam Guard” để nhận mã 5 ký tự.',
      'Nhập mã vào Steam. Mỗi mã chỉ dùng được một lần.',
    ]) {
      const li = document.createElement('li');
      li.textContent = text;
      steps.appendChild(li);
    }

    const warn = document.createElement('p');
    warn.className = 'guard-warn';
    warn.textContent =
      '⚠ Bấm lấy mã TRƯỚC khi đăng nhập sẽ nhận mã cũ và Steam báo sai. ' +
      'Nếu mã không dùng được, đăng nhập lại rồi lấy mã mới sau 60 giây.';

    const hint = document.createElement('p');
    hint.className = 'guard-hint';
    hint.textContent =
      'Shop chỉ cấp mã để ĐĂNG NHẬP. Mã đổi mật khẩu hoặc đổi email sẽ không được cấp, ' +
      'và mỗi lượt lấy mã đều được ghi lại.';

    guide.append(title, steps, warn);

    btn.addEventListener('click', async () => {
      btn.disabled = true;
      out.hidden = false;
      out.classList.remove('error');
      // 'code' too: it was only ever removed by not being added, so a second
      // attempt kept the monospace treatment on "Đang lấy mã…" — and now it would
      // also leave the copy button's styling behind after the button itself went.
      out.classList.remove('code');
      out.textContent = 'Đang lấy mã…';
      try {
        const res = await fetch('/api/rent/steam-code', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ orderCode: order.orderCode }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.code) {
          // A five-character code typed by hand is a code typed wrong, and Steam
          // rejects it as used. Reuses the same copyButton as the credentials, so
          // it behaves and looks identical: "Chép" → "Đã chép".
          out.textContent = '';
          const shown = document.createElement('span');
          shown.className = 'guard-code-value';
          shown.textContent = `Mã: ${data.code}`;
          out.append(shown, copyButton(data.code));
          out.classList.add('code');
          // Re-armed after the cooldown rather than left dead: a code can arrive
          // late, or the first one can expire before it is typed in.
          const wait = Number(data.cooldownSeconds) || 45;
          let left = wait;
          const tick = setInterval(() => {
            left -= 1;
            btn.textContent = left > 0 ? `🔑 Lấy lại sau ${left}s` : '🔑 Lấy mã Steam Guard';
            if (left <= 0) {
              clearInterval(tick);
              btn.disabled = false;
            }
          }, 1000);
          return;
        }
        out.classList.add('error');
        out.textContent =
          data.error === 'no_code_yet'
            ? 'Chưa có mã nào trong hộp thư. Hãy bấm đăng nhập trên Steam trước, rồi thử lại.'
            : data.error === 'code_not_for_login'
              ? 'Mã hiện có trong hộp thư không phải mã đăng nhập nên shop không thể gửi. Vui lòng liên hệ shop.'
              : data.error === 'too_soon'
                ? `Vui lòng đợi ${data.retryAfter}s rồi thử lại.`
                : data.error === 'limit_reached'
                  ? 'Đã lấy mã quá nhiều lần cho đơn này. Vui lòng liên hệ shop.'
                  : data.error === 'rental_has_no_expiry'
              ? 'Đơn này thiếu thời hạn nên chưa lấy được mã. Vui lòng liên hệ shop.'
            : data.error === 'rental_expired'
              ? 'Lượt thuê đã hết hạn nên không lấy mã được nữa.'
            : data.error === 'rental_not_active'
              ? 'Lượt thuê này không còn hiệu lực.'
            : data.error === 'not_guard_account'
              ? 'Tài khoản này không dùng mã xác nhận qua email. Bạn đăng nhập trực tiếp bằng tài khoản và mật khẩu ở trên.'
            : data.error === 'mailbox_not_readable'
                    ? 'Tài khoản này không hỗ trợ tự lấy mã. Vui lòng liên hệ shop.'
                    : data.error === 'code_service_unconfigured'
                      ? 'Chức năng lấy mã chưa được bật. Vui lòng liên hệ shop.'
                      : 'Không lấy được mã. Vui lòng liên hệ shop.';
        btn.disabled = false;
      } catch {
        out.classList.add('error');
        out.textContent = 'Lỗi mạng. Vui lòng thử lại.';
        btn.disabled = false;
      }
    });

    wrap.append(guide, btn, out, hint);
    return wrap;
  }

  /**
   * "Báo lỗi" on a live rental. Collapsed to a single link until used, because it
   * is a rare action sitting next to the ones people actually came for — but
   * reachable in one click, since the report that matters most (someone else is
   * logged in) is the one a renter wants to send immediately.
   */
  function reportControls(order) {
    const wrap = document.createElement('div');
    wrap.className = 'report';

    const open = (reports || []).find(
      (r) => String(r.orderCode) === String(order.orderCode) && r.status === 'open'
    );
    if (open) {
      const done = document.createElement('p');
      done.className = 'report-open';
      done.textContent = `⚠️ Đã gửi báo lỗi: ${open.reasonLabel}. Shop đang xử lý — bạn sẽ được liên hệ sớm.`;
      wrap.appendChild(done);
      return wrap;
    }

    const toggle = document.createElement('button');
    toggle.type = 'button';
    toggle.className = 'report-toggle';
    toggle.textContent = '⚠️ Báo lỗi tài khoản';

    const form = document.createElement('div');
    form.className = 'report-form';
    form.hidden = true;

    const select = document.createElement('select');
    select.className = 'report-reason';
    for (const [value, label] of Object.entries(REPORT_REASONS)) {
      const opt = document.createElement('option');
      opt.value = value;
      opt.textContent = label;
      select.appendChild(opt);
    }

    const note = document.createElement('textarea');
    note.className = 'report-note';
    note.rows = 2;
    note.maxLength = 600;
    note.placeholder = 'Mô tả thêm (bắt buộc nếu chọn "Vấn đề khác")';

    const send = document.createElement('button');
    send.type = 'button';
    send.className = 'btn report-send';
    send.textContent = 'Gửi báo lỗi';

    const status = document.createElement('p');
    status.className = 'report-status';
    status.hidden = true;

    send.addEventListener('click', async () => {
      send.disabled = true;
      status.hidden = false;
      status.classList.remove('error');
      status.textContent = 'Đang gửi…';
      try {
        const res = await fetch('/api/rent/report', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            orderCode: order.orderCode,
            reason: select.value,
            message: note.value,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          status.classList.add('error');
          status.textContent =
            data.error === 'message_required'
              ? 'Vui lòng mô tả thêm vấn đề của bạn.'
              : data.error === 'not_reportable'
                ? 'Đơn này không còn báo lỗi được. Vui lòng liên hệ shop.'
                : 'Không gửi được báo lỗi. Vui lòng thử lại hoặc liên hệ shop.';
          send.disabled = false;
          return;
        }
        status.textContent = data.urgent
          ? 'Đã gửi! Đây là lỗi nghiêm trọng — shop sẽ đổi mật khẩu và liên hệ bạn ngay.'
          : 'Đã gửi! Shop sẽ kiểm tra và liên hệ bạn sớm.';
        note.disabled = true;
        select.disabled = true;
        // Reflect it immediately, so the button cannot be pressed again while the
        // orders list has not been refetched yet.
        reports.push({
          orderCode: order.orderCode,
          reason: select.value,
          reasonLabel: REPORT_REASONS[select.value] || select.value,
          status: 'open',
        });
      } catch {
        status.classList.add('error');
        status.textContent = 'Lỗi mạng. Vui lòng thử lại.';
        send.disabled = false;
      }
    });

    toggle.addEventListener('click', () => {
      form.hidden = !form.hidden;
      if (!form.hidden) select.focus();
    });

    form.append(select, note, send, status);
    wrap.append(toggle, form);
    return wrap;
  }

  function extendControls(order) {
    const wrap = document.createElement('div');
    wrap.className = 'extend';

    // An account they already own has nothing to extend and nothing left to buy.
    if (order.purchase) {
      const owned = document.createElement('p');
      owned.className = 'owned-note';
      owned.textContent = '👑 Tài khoản này đã thuộc quyền sở hữu của bạn — không còn thời hạn.';
      wrap.appendChild(owned);
      return wrap;
    }

    const label = document.createElement('span');
    label.className = 'extend-label';
    label.textContent = 'Gia hạn thêm:';
    wrap.appendChild(label);

    for (const plan of RENT_PLANS) {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'extend-btn';
      btn.textContent = plan.label + ' · ' + compact(plan.amount);
      btn.addEventListener('click', () => startCheckout(plan.id, btn, order.orderCode));
      wrap.appendChild(btn);
    }

    if (BUY_PLAN) wrap.appendChild(buyControls(order));
    return wrap;
  }

  /**
   * The buy-out, offered on the rental the customer is holding. Separated from the
   * extend buttons because it is not another duration — it ends the rental, and
   * costs roughly four times the weekly plan, so it must not be a click away from
   * "1 tuần · 50k" without a word of explanation.
   */
  function buyControls(order) {
    const box = document.createElement('div');
    box.className = 'buy';

    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'buy-btn';
    btn.textContent = (BUY_PLAN.icon ? BUY_PLAN.icon + ' ' : '') + BUY_PLAN.label + ' · ' + compact(BUY_PLAN.amount);

    const note = document.createElement('p');
    note.className = 'buy-note';
    note.textContent = BUY_PLAN.note || '';

    btn.addEventListener('click', () => {
      // Irreversible and four times the weekly price: confirm in place rather than
      // opening a payment window on one stray click.
      if (btn.dataset.confirming !== '1') {
        btn.dataset.confirming = '1';
        btn.dataset.label = btn.textContent;
        btn.textContent = 'Xác nhận mua ' + compact(BUY_PLAN.amount) + '?';
        note.textContent = 'Bấm lần nữa để tạo đơn. Tài khoản sẽ thuộc về bạn vĩnh viễn, kèm email.';
        return;
      }
      startCheckout(BUY_PLAN.id, btn, null, order.orderCode);
    });

    box.append(btn, note);
    return box;
  }

  function startCountdowns() {
    clearInterval(countdownTimer);
    const tick = () => {
      const nodes = document.querySelectorAll('[data-expires-at]');
      if (!nodes.length) return clearInterval(countdownTimer);
      const nowSec = Math.floor(Date.now() / 1000);
      for (const node of nodes) {
        const left = Number(node.dataset.expiresAt) - nowSec;
        node.textContent = 'Còn ' + formatRemaining(left);
        // The server owns expiry; refresh once it lapses so the pool is freed.
        if (left <= 0) loadRentals();
      }
    };
    tick();
    countdownTimer = setInterval(tick, 1000);
  }

  // Statuses that are done moving — polling can stop once an order reaches one.
  const TERMINAL = new Set(['active', 'expired', 'cancelled', 'payment_expired', 'awaiting_stock', 'error', 'extended']);

  async function loadRentals() {
    const list = el('rentOrders');
    try {
      const res = await fetch('/api/rent/orders', { credentials: 'same-origin' });
      if (res.status === 503) {
        const info = await res.json().catch(() => ({}));
        setPlansEnabled(false);
        rentNotice(info.hint || 'Tính năng thuê tài khoản chưa được cấu hình.', true);
        return null;
      }
      if (!res.ok) throw new Error(String(res.status));
      const data = await res.json();
      const orders = data.orders;
      // Replace in place rather than reassigning: reportControls() pushes an
      // optimistic entry into this same array right after a successful send.
      reports.length = 0;
      reports.push(...(data.reports || []));

      list.textContent = '';
      // Finished and abandoned orders are noise once they are done; the notice
      // above carries the outcome instead.
      const relevant = (orders || []).filter(
        (o) => !['expired', 'cancelled', 'payment_expired', 'extended'].includes(o.status)
      );
      for (const order of relevant) list.appendChild(renderOrder(order));
      // While the payment form is open, the same order also showing a
      // "Tiếp tục thanh toán" button below it is just confusing.
      list.hidden = relevant.length === 0 || !el('payosEmbedWrap').hidden;
      startCountdowns();
      return orders || [];
    } catch {
      rentNotice('Không tải được đơn thuê. Vui lòng tải lại trang.', true);
      return null;
    }
  }

  /**
   * After returning from payOS, the payment may still be settling. Poll until
   * the order reaches a terminal state rather than showing a single, probably
   * premature, verdict. The server re-checks with payOS on every call, so this
   * also covers a webhook that never arrived.
   */
  async function awaitPaymentOutcome(orderCode, deadlineMs = 45000, token = null) {
    const started = Date.now();
    let delay = 1500;

    while (true) {
      if (token?.cancelled) return;
      const orders = await loadRentals();
      if (orders === null) return; // load failed; its own notice is showing
      if (token?.cancelled) return; // closed while the request was in flight

      const order = orders.find((o) => String(o.orderCode) === String(orderCode));

      if (!order) {
        // No such order for this account — e.g. checkout never completed.
        return rentNotice('Không tìm thấy đơn thanh toán này.', true);
      }

      if (TERMINAL.has(order.status)) return announceOutcome(order, orders);

      if (Date.now() - started > deadlineMs) {
        return rentNotice(
          'Thanh toán chưa được xác nhận. Nếu bạn đã chuyển khoản, tài khoản sẽ hiện ra sau ít phút — hãy tải lại trang. Mã đơn ' +
            orderCode + '.',
          true
        );
      }

      await new Promise((r) => setTimeout(r, delay));
      delay = Math.min(delay * 1.4, 5000); // back off; most settle in seconds
    }
  }

  /* ─── Order-complete popup ──────────────────── */

  let doneLastFocus = null;

  function fmtWhen(ts) {
    return new Date(ts * 1000).toLocaleString('vi-VN', {
      hour: '2-digit',
      minute: '2-digit',
      day: '2-digit',
      month: '2-digit',
    });
  }

  function closeDoneModal() {
    const modal = el('doneModal');
    if (!modal || modal.hidden) return;
    modal.hidden = true;
    document.body.classList.remove('modal-open');
    // Send focus back where it was, rather than to the top of the document.
    if (doneLastFocus && document.contains(doneLastFocus)) doneLastFocus.focus();
    doneLastFocus = null;
  }

  /**
   * An extension order never carries credentials of its own — they belong to the
   * rental it topped up, which is the row that stays 'active'. Without this the
   * popup for a renewal would claim it could not find the account.
   */
  function doneCredentials(order, orders) {
    if (order.credentials) return { creds: order.credentials, expiresAt: order.expiresAt };
    if (order.extendsOrder != null) {
      const parent = (orders || []).find(
        (o) => String(o.orderCode) === String(order.extendsOrder)
      );
      if (parent?.credentials) {
        return { creds: parent.credentials, expiresAt: parent.expiresAt ?? order.expiresAt };
      }
    }
    return { creds: null, expiresAt: order.expiresAt };
  }

  function openDoneModal(order, orders) {
    const modal = el('doneModal');
    if (!modal) return;
    const extension = order.status === 'extended';
    const { creds, expiresAt } = doneCredentials(order, orders);

    el('doneTitle').textContent = extension ? 'Gia hạn thành công' : 'Đơn hoàn tất';
    el('doneSub').textContent =
      'Mã đơn ' + order.orderCode + ' · ' + order.hours + ' giờ' +
      (expiresAt ? ' · dùng đến ' + fmtWhen(expiresAt) : '');

    const body = el('doneBody');
    body.textContent = '';
    if (creds) {
      const dl = document.createElement('dl');
      dl.className = 'creds';
      credentialRow(dl, 'Tài khoản', creds.login);
      credentialRow(dl, 'Mật khẩu', creds.password);
      if (creds.email) credentialRow(dl, 'Email', creds.email);
      if (creds.emailPassword) credentialRow(dl, 'Mật khẩu email', creds.emailPassword);
      body.appendChild(dl);
    } else {
      // Paid, but the credentials are not in hand yet. Never imply they are lost.
      const p = document.createElement('p');
      p.className = 'done-fallback';
      p.textContent = extension
        ? 'Thời hạn đã được cộng thêm. Tài khoản đăng nhập không thay đổi — xem ở mục “Tài khoản đang thuê” bên dưới.'
        : 'Đã nhận thanh toán. Thông tin đăng nhập sẽ hiện ở mục “Tài khoản đang thuê” bên dưới trong ít giây — tải lại trang nếu chưa thấy.';
      body.appendChild(p);
    }

    doneLastFocus = document.activeElement;
    modal.hidden = false;
    document.body.classList.add('modal-open');
    el('doneClose').focus();
  }

  el('doneClose').addEventListener('click', closeDoneModal);

  // Clicking the backdrop closes; clicking inside the card must not.
  el('doneModal').addEventListener('click', (e) => {
    if (e.target === e.currentTarget) closeDoneModal();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeDoneModal();
  });

  el('doneGo').addEventListener('click', () => {
    closeDoneModal();
    const list = el('rentOrders');
    if (!list || list.hidden) return;
    // Wait a frame: closing the popup unlocks body scrolling, and scrolling in
    // the same frame is measured against the still-locked page, which lands
    // roughly 90px down instead of on the rental.
    requestAnimationFrame(() => {
      list.scrollIntoView({ behavior: 'smooth', block: 'center' });
      list.classList.remove('flash');
      void list.offsetWidth; // restart the animation if it is already flashing
      list.classList.add('flash');
      setTimeout(() => list.classList.remove('flash'), 1800);
    });
  });

  function announceOutcome(order, orders) {
    switch (order.status) {
      case 'active':
      case 'extended': {
        // Keep the inline notice too: it survives closing the popup, and it is
        // the only feedback left if the popup markup ever goes missing.
        rentNotice(
          order.status === 'extended'
            ? 'Gia hạn thành công — thời hạn thuê đã được cộng thêm.'
            : 'Thanh toán thành công — tài khoản của bạn đã sẵn sàng bên dưới.',
          false
        );
        return openDoneModal(order, orders);
      }
      case 'awaiting_stock':
        return rentNotice(
          'Đã nhận thanh toán nhưng hiện hết tài khoản trống. Vui lòng liên hệ shop kèm mã đơn ' +
            order.orderCode + ' để được xếp tài khoản hoặc hoàn tiền.',
          true
        );
      case 'cancelled':
        return rentNotice('Bạn đã huỷ thanh toán. Chưa có khoản nào bị trừ.', false);
      case 'payment_expired':
        return rentNotice('Link thanh toán đã hết hạn. Vui lòng tạo đơn mới.', true);
      case 'error':
        // The rental is paid and valid — only the credential read failed, so
        // make clear the money is not lost.
        return rentNotice(
          'Đã thanh toán thành công nhưng chưa lấy được thông tin tài khoản. ' +
            'Vui lòng liên hệ shop kèm mã đơn ' + order.orderCode + ' để nhận tài khoản ngay.',
          true
        );
      default:
        return rentNotice('Trạng thái đơn: ' + (RENT_STATUS[order.status] || order.status), false);
    }
  }

  function setPlansEnabled(enabled) {
    for (const btn of document.querySelectorAll('.rent-btn')) btn.disabled = !enabled;
  }

  /**
   * Stock is per plan now: an account can be tagged for one plan only, so a card
   * can be empty while its neighbour is not. Disabling every button on a single
   * total would hide plans that are perfectly rentable.
   */
  function applyPlanStock(plans) {
    for (const plan of plans || []) {
      const btn = document.querySelector('.rent-btn[data-plan="' + plan.id + '"]');
      if (!btn) continue;
      const left = Number(plan.available) || 0;
      const out = left === 0;
      btn.disabled = out;
      btn.textContent = out ? 'Tạm hết' : 'Thuê ngay';
      const card = btn.closest('.plan');
      if (card) card.classList.toggle('sold-out', out);

      // Cap the box at what this plan can actually supply, so a bulk rent is not
      // refused as out_of_stock after the customer has committed to a number.
      const qty = document.querySelector('.qty-input[data-qty-for="' + plan.id + '"]');
      if (qty) {
        const cap = Math.max(Math.min(left, 10), 1);
        qty.max = String(cap);
        qty.disabled = out;
        if (Number(qty.value) > cap) qty.value = String(cap);
      }

      const label = document.querySelector('.plan-stock[data-stock-for="' + plan.id + '"]');
      if (label) {
        // Counted for this plan specifically — the VOIP week only counts accounts
        // marked no_ban, so its figure is legitimately smaller than its neighbour's.
        label.textContent = out ? 'Tạm hết tài khoản' : `Còn ${left} tài khoản`;
        label.classList.toggle('none', out);
        label.classList.toggle('low', !out && left <= 2);
      }

      renderForecast(plan);
    }
  }

  /**
   * When a plan is empty, when its accounts are expected back.
   *
   * Worded as an expectation throughout: the renter holding an account can extend
   * it, so a time here is not a reservation. Saying "dự kiến" and naming the reason
   * is more use than an empty card that gives someone no reason to return.
   */
  /**
   * Coarse "in about N" wording, deliberately not formatRemaining: that renders
   * under an hour as mm:ss ("23:56"), which sitting next to a clock time reads as a
   * time of day rather than a wait. Rounding also matches what this is — an
   * estimate, not a countdown.
   */
  function forecastEta(seconds) {
    if (seconds < 60) return 'dưới 1 phút';
    const mins = Math.round(seconds / 60);
    if (mins < 60) return `${mins} phút`;
    const hours = Math.floor(mins / 60);
    const rest = mins % 60;
    if (hours < 24) return rest ? `${hours} giờ ${rest} phút` : `${hours} giờ`;
    const days = Math.floor(hours / 24);
    const spare = hours % 24;
    return spare ? `${days} ngày ${spare} giờ` : `${days} ngày`;
  }

  function renderForecast(plan) {
    const box = document.querySelector('.plan-forecast[data-forecast-for="' + plan.id + '"]');
    if (!box) return;
    const rows = Number(plan.available) === 0 ? plan.upcoming || [] : [];
    box.textContent = '';
    if (!rows.length) {
      // Distinguish "nothing coming" from "not out of stock" — an empty plan with no
      // returns due is worth saying out loud, otherwise the customer waits for
      // nothing.
      if (Number(plan.available) === 0) {
        const none = document.createElement('p');
        none.className = 'forecast-none';
        none.textContent = 'Chưa có tài khoản nào sắp hết hạn — vui lòng liên hệ shop.';
        box.appendChild(none);
        box.hidden = false;
      } else {
        box.hidden = true;
      }
      return;
    }

    const title = document.createElement('p');
    title.className = 'forecast-title';
    title.textContent = 'Dự kiến có tài khoản trống:';
    box.appendChild(title);

    let running = 0;
    for (const row of rows) {
      running += Number(row.count) || 0;
      const line = document.createElement('p');
      line.className = 'forecast-row';
      const left = Number(row.at) - Math.floor(Date.now() / 1000);
      line.textContent = `+${row.count} sau ${forecastEta(Math.max(left, 0))}  ·  ${fmtWhen(row.at)}`;
      box.appendChild(line);
    }

    const note = document.createElement('p');
    note.className = 'forecast-note';
    note.textContent = `Tổng ${running} tài khoản — dự kiến, khách đang thuê có thể gia hạn.`;
    box.appendChild(note);
    box.hidden = false;
  }

  async function loadStock() {
    try {
      const res = await fetch('/api/rent/plans', { credentials: 'same-origin' });
      if (!res.ok) throw new Error(String(res.status));
      const data = await res.json();
      applyPlanStock(data.plans);
      // data.available is the best any single plan can do, so this only fires when
      // every plan is empty — not when one tagged tier has run out.
      if (data.available === 0) rentNotice('Hiện đã hết tài khoản trống. Vui lòng quay lại sau.', false);
    } catch {
      for (const label of document.querySelectorAll('.plan-stock')) label.textContent = '—';
      setPlansEnabled(false);
    }
  }

  /* ─── payOS embedded checkout ────────────────── */

  // payOS is framed directly rather than through their JS SDK: the SDK rewrites
  // the URL to /embedded/<id>, which this merchant account rejects with an error
  // page that posts no message back — so its callbacks never fire. The compact
  // ?embedded=true view frames fine, and the server is the authority on whether
  // a payment landed anyway, so nothing of value is lost.
  let embedPoll = null;

  function embeddedSrc(checkoutUrl) {
    return checkoutUrl + (checkoutUrl.includes('?') ? '&' : '?') + 'embedded=true';
  }

  function closeEmbed() {
    if (embedPoll) embedPoll.cancelled = true;
    embedPoll = null;
    el('payosEmbed').textContent = '';
    el('payosEmbedWrap').hidden = true;
  }

  async function openEmbeddedCheckout(checkoutUrl, orderCode) {
    closeEmbed();

    const wrap = el('payosEmbedWrap');
    wrap.hidden = false;
    el('payosOpenHosted').href = checkoutUrl;

    const frame = document.createElement('iframe');
    frame.src = embeddedSrc(checkoutUrl);
    frame.title = 'Thanh toán payOS';
    frame.allow = 'clipboard-write';
    frame.setAttribute('loading', 'eager');
    el('payosEmbed').appendChild(frame);
    wrap.scrollIntoView({ behavior: 'smooth', block: 'center' });

    // A bank transfer can take minutes, so poll far longer than the return-URL
    // flow does — the payment link itself expires after 15.
    const token = { cancelled: false };
    embedPoll = token;
    await awaitPaymentOutcome(orderCode, 12 * 60 * 1000, token);
    if (!token.cancelled) {
      closeEmbed();
      loadStock();
    }
  }

  el('payosClose').addEventListener('click', () => {
    closeEmbed();
    // The order stays pending — it reappears in the list so it can be resumed.
    loadRentals();
  });

  /** What the quantity box for this plan says, floored at 1. */
  function quantityFor(planId) {
    const input = document.querySelector('.qty-input[data-qty-for="' + planId + '"]');
    const n = Number(input?.value);
    return Number.isInteger(n) && n >= 1 ? n : 1;
  }

  async function startCheckout(planId, button, extendOrderCode = null, buyOrderCode = null) {
    button.disabled = true;
    try {
      const res = await fetch('/api/rent/checkout', {
        method: 'POST',
        credentials: 'same-origin',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          planId,
          // Only a plain rental has a quantity; extending or buying acts on one
          // existing rental, and the server rejects a count there.
          ...(extendOrderCode || buyOrderCode ? {} : { quantity: quantityFor(planId) }),
          ...(extendOrderCode ? { extendOrderCode } : {}),
          ...(buyOrderCode ? { buyOrderCode } : {}),
        }),
      });
      const data = await res.json();
      if (res.ok && data.checkoutUrl) {
        // The server probes whether payOS will actually serve the in-page form
        // for this merchant; when it will not, go straight to the hosted page
        // rather than showing a dead iframe.
        if (data.embedded === false) {
          window.location.href = data.checkoutUrl;
          return;
        }
        try {
          await openEmbeddedCheckout(data.checkoutUrl, data.orderCode);
        } catch {
          // payOS's script blocked or unreachable — fall back to their hosted
          // page rather than stranding a customer with a created order.
          window.location.href = data.checkoutUrl;
        }
        return;
      }
      if (data.error === 'not_extendable' || data.error === 'unknown_order') {
        rentNotice('Không gia hạn được đơn này (đơn đã kết thúc). Vui lòng thuê gói mới.', true);
        await loadRentals();
      } else if (data.error === 'out_of_stock') {
        rentNotice('Vừa hết tài khoản trống. Vui lòng quay lại sau.', true);
        await loadStock();
      } else if (data.error === 'unauthorized') {
        rentNotice('Phiên đăng nhập đã hết. Vui lòng đăng nhập lại.', true);
      } else if (data.merchantConfig) {
        // Shop-side problem (e.g. payOS code 214, channel paused). The customer
        // can do nothing about it, so keep the detail in the console for us.
        console.error('payOS merchant config error:', data.reason);
        rentNotice(
          'Cổng thanh toán đang tạm ngưng. Vui lòng liên hệ shop qua Zalo/Facebook để đặt đơn' +
            (data.payosCode ? ' (mã ' + data.payosCode + ')' : '') + '.',
          true
        );
      } else {
        // `reason` carries payOS's own message — showing it is the difference
        // between "it broke" and knowing which setting to fix.
        console.error('checkout failed:', data.reason);
        rentNotice(
          'Không tạo được đơn thanh toán: ' + (data.reason || data.error || res.status),
          true
        );
      }
    } catch {
      rentNotice('Không kết nối được máy chủ thanh toán.', true);
    } finally {
      button.disabled = false;
    }
  }

  function initRentals() {
    for (const btn of document.querySelectorAll('.rent-btn')) {
      btn.addEventListener('click', () => startCheckout(btn.dataset.plan, btn));
    }

    // Coming back from payOS. It appends its own params (code, id, status,
    // cancel, orderCode) alongside the ones we put in the return URL. They are
    // only used to decide what to *say* — the outcome itself always comes from
    // the server re-checking with payOS, since anyone can edit a query string.
    const params = new URLSearchParams(window.location.search);
    const marker = params.get('rent');
    const orderCode = params.get('orderCode');
    const cancelled = params.get('cancel') === 'true' || params.get('status') === 'CANCELLED';

    if (params.has('rent')) {
      // Clear the query so a refresh does not replay the outcome.
      window.history.replaceState({}, '', window.location.pathname);
    }

    loadStock();

    if (marker && orderCode) {
      rentNotice(cancelled ? 'Đang kiểm tra đơn…' : 'Đang xác nhận thanh toán…', false);
      awaitPaymentOutcome(orderCode).then(loadStock);
    } else {
      loadRentals();
    }
  }

  /* ─── Memory game ────────────────────────────── */

  const board = el('board');
  const glyphs = JSON.parse(board.dataset.glyphs);

  let deck = [];
  let firstTile = null;
  let locked = false;
  let moves = 0;
  let pairs = 0;
  let startedAt = 0;
  let timerId = null;
  let bestKey = 'fg-game-best';

  function shuffle(items) {
    const out = items.slice();
    for (let i = out.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [out[i], out[j]] = [out[j], out[i]];
    }
    return out;
  }

  function formatTime(seconds) {
    return Math.floor(seconds / 60) + ':' + String(seconds % 60).padStart(2, '0');
  }

  function elapsed() {
    return startedAt ? Math.floor((Date.now() - startedAt) / 1000) : 0;
  }

  function renderBest() {
    const raw = localStorage.getItem(bestKey);
    el('statBest').textContent = raw || '—';
  }

  function tick() {
    el('statTime').textContent = formatTime(elapsed());
  }

  function onTileClick(tile) {
    if (locked || tile.classList.contains('matched') || tile === firstTile) return;
    if (!startedAt) {
      startedAt = Date.now();
      timerId = setInterval(tick, 1000);
    }

    tile.classList.add('revealed');
    tile.setAttribute('aria-pressed', 'true');

    if (!firstTile) {
      firstTile = tile;
      return;
    }

    moves += 1;
    el('statMoves').textContent = String(moves);

    const a = firstTile;
    const b = tile;
    firstTile = null;

    if (a.dataset.glyph === b.dataset.glyph) {
      a.classList.add('matched');
      b.classList.add('matched');
      pairs += 1;
      el('statPairs').textContent = pairs + ' / ' + glyphs.length;
      if (pairs === glyphs.length) finish();
      return;
    }

    locked = true;
    setTimeout(() => {
      for (const t of [a, b]) {
        t.classList.remove('revealed');
        t.setAttribute('aria-pressed', 'false');
      }
      locked = false;
    }, 700);
  }

  function finish() {
    clearInterval(timerId);
    timerId = null;
    const best = Number(localStorage.getItem(bestKey)) || Infinity;
    const isBest = moves < best;
    if (isBest) localStorage.setItem(bestKey, String(moves));
    renderBest();
    const result = el('gameResult');
    result.textContent = isBest
      ? '⚜ Kỷ lục mới! ' + moves + ' lượt trong ' + formatTime(elapsed())
      : '✦ Hoàn thành với ' + moves + ' lượt trong ' + formatTime(elapsed());
    result.hidden = false;
  }

  function startGame(userId) {
    // Scope the personal best to the signed-in account.
    if (userId) bestKey = 'fg-game-best:' + userId;

    clearInterval(timerId);
    timerId = null;
    firstTile = null;
    locked = false;
    moves = 0;
    pairs = 0;
    startedAt = 0;
    deck = shuffle(glyphs.concat(glyphs));

    el('statMoves').textContent = '0';
    el('statPairs').textContent = '0 / ' + glyphs.length;
    el('statTime').textContent = '0:00';
    el('gameResult').hidden = true;
    renderBest();

    board.textContent = '';
    for (const glyph of deck) {
      const tile = document.createElement('button');
      tile.type = 'button';
      tile.className = 'tile';
      tile.dataset.glyph = glyph;
      tile.setAttribute('aria-pressed', 'false');
      tile.setAttribute('aria-label', 'Lá bài úp');
      const face = document.createElement('span');
      face.className = 'face';
      face.textContent = glyph;
      tile.appendChild(face);
      tile.addEventListener('click', () => onTileClick(tile));
      board.appendChild(tile);
    }
  }

  el('restartBtn').addEventListener('click', () => startGame(null));

  checkSession();
</script>
